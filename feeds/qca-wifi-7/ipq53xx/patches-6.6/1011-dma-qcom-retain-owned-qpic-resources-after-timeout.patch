+/* Only the qualified, built-in X7 QPIC pair uses this lifetime contract.
+ * The two static slots bound retained owners to one client and one provider.
+ * Their root devices have independent DMA masks/range maps and devres lists.
+ * Original platform unbind may complete; it cannot release retained DMA state.
+ */
+struct qcom_qpic_lifetime {
+ struct device *owner;
+ unsigned int users;
+ bool detaching;
+ void (*poison_irq)(void *);
+ void *irq_data;
+ bool irq_disabled;
+};
+static DEFINE_MUTEX(qpic_lifetime_lock);
+static struct qcom_qpic_lifetime qpic_lifetimes[2];
+static bool qpic_poisoned;
+
+struct device *qcom_qpic_lifetime_device(struct qcom_qpic_lifetime *life)
+{
+ return life ? life->owner : NULL;
+}
+EXPORT_SYMBOL_GPL(qcom_qpic_lifetime_device);
+
+bool qcom_qpic_lifetime_poisoned(struct qcom_qpic_lifetime *life)
+{
+ return life && READ_ONCE(qpic_poisoned);
+}
+EXPORT_SYMBOL_GPL(qcom_qpic_lifetime_poisoned);
+
+void qcom_qpic_lifetime_poison(struct qcom_qpic_lifetime *life)
+{
+ struct qcom_qpic_lifetime *provider = &qpic_lifetimes[1];
+ void (*hook)(void *) = NULL;
+ void *data = NULL;
+
+ if (!life)
+  return;
+ mutex_lock(&qpic_lifetime_lock);
+ WRITE_ONCE(qpic_poisoned, true);
+ if (provider->poison_irq && !provider->irq_disabled) {
+  provider->irq_disabled = true;
+  hook = provider->poison_irq;
+  data = provider->irq_data;
+ }
+ mutex_unlock(&qpic_lifetime_lock);
+ /* The callback only disables the Linux IRQ. No QPIC/BAM MMIO, reset,
+  * DMA status query or failed-state clock operation is performed. */
+ if (hook)
+  hook(data);
+}
+EXPORT_SYMBOL_GPL(qcom_qpic_lifetime_poison);
+
+/* Allocation/removal serialization includes in-progress channel allocation. */
+static bool qpic_lifetime_get(struct qcom_qpic_lifetime *life)
+{
+ bool ok = true;
+
+ if (!life)
+  return true;
+ mutex_lock(&qpic_lifetime_lock);
+ if (qpic_poisoned || life->detaching || !life->owner)
+  ok = false;
+ else
+  life->users++;
+ mutex_unlock(&qpic_lifetime_lock);
+ return ok;
+}
+
+static void qpic_lifetime_put(struct qcom_qpic_lifetime *life)
+{
+ if (!life)
+  return;
+ mutex_lock(&qpic_lifetime_lock);
+ WARN_ON(!life->users);
+ if (life->users)
+  life->users--;
+ mutex_unlock(&qpic_lifetime_lock);
+}
+
+bool qcom_qpic_lifetime_detach(struct qcom_qpic_lifetime *life)
+{
+ bool busy;
+
+ if (!life)
+  return false;
+ mutex_lock(&qpic_lifetime_lock);
+ life->detaching = true;
+ busy = life->users != 0;
+ mutex_unlock(&qpic_lifetime_lock);
+ /* Even a healthy provider must retain resources if a client still owns
+  * channels. This covers provider-first removal, not just timeout removal. */
+ if (busy)
+  qcom_qpic_lifetime_poison(life);
+ return qcom_qpic_lifetime_poisoned(life);
+}
+EXPORT_SYMBOL_GPL(qcom_qpic_lifetime_detach);
+
+static void qpic_lifetime_release(void *data)
+{
+ struct qcom_qpic_lifetime *life = data;
+ struct device *owner;
+
+ if (qcom_qpic_lifetime_detach(life))
+  return;
+ mutex_lock(&qpic_lifetime_lock);
+ if (qpic_poisoned || life->users) {
+  mutex_unlock(&qpic_lifetime_lock);
+  qcom_qpic_lifetime_poison(life);
+  return;
+ }
+ owner = life->owner;
+ life->owner = NULL;
+ life->poison_irq = NULL;
+ life->irq_data = NULL;
+ mutex_unlock(&qpic_lifetime_lock);
+ if (owner)
+  root_device_unregister(owner);
+}
+
+static void qpic_lifetime_put_device(void *data)
+{
+ put_device(data);
+}
+
+static void qpic_lifetime_put_node(void *data)
+{
+ of_node_put(data);
+}
+
+struct qcom_qpic_lifetime *
+qcom_qpic_lifetime_create(struct platform_device *pdev, bool provider)
+{
+ struct qcom_qpic_lifetime *life = &qpic_lifetimes[provider ? 1 : 0];
+ struct resource *res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+ struct device *owner;
+ int ret;
+
+ if (!of_machine_is_compatible("cambiumnetworks,x7-35x") || !res ||
+     res->start != (provider ? 0x07984000 : 0x079b0000))
+  return NULL;
+ if (!IS_BUILTIN(CONFIG_QCOM_BAM_DMA) ||
+     !IS_BUILTIN(CONFIG_MTD_NAND_QCOM) || IS_ENABLED(CONFIG_IOMMU_SUPPORT))
+  return ERR_PTR(-EOPNOTSUPP);
+ mutex_lock(&qpic_lifetime_lock);
+ if (qpic_poisoned || life->owner) {
+  ret = qpic_poisoned ? -EIO : -EBUSY;
+  goto unlock;
+ }
+ owner = root_device_register(provider ? "miami-qpic-bam-owner" :
+                                        "miami-qpic-nand-owner");
+ if (IS_ERR(owner)) {
+  ret = PTR_ERR(owner);
+  goto unlock;
+ }
+ owner->of_node = of_node_get(pdev->dev.of_node);
+ ret = devm_add_action_or_reset(owner, qpic_lifetime_put_node, owner->of_node);
+ if (ret)
+  goto fail_owner;
+ ret = devm_add_action_or_reset(owner, qpic_lifetime_put_device,
+                                get_device(&pdev->dev));
+ if (ret)
+  goto fail_owner;
+ /* Never borrow platform DMA masks, range-map storage or dma_parms. */
+ owner->dma_mask = &owner->coherent_dma_mask;
+ owner->coherent_dma_mask = DMA_BIT_MASK(32);
+ owner->dma_parms = devm_kzalloc(owner, sizeof(*owner->dma_parms), GFP_KERNEL);
+ if (!owner->dma_parms) {
+  ret = -ENOMEM;
+  goto fail_owner;
+ }
+ ret = of_dma_configure(owner, owner->of_node, true);
+ if (ret)
+  goto fail_owner;
+ ret = dma_set_mask_and_coherent(owner, DMA_BIT_MASK(32));
+ if (ret)
+  goto fail_owner;
+ life->owner = owner;
+ life->users = 0;
+ life->detaching = false;
+ life->irq_disabled = false;
+ mutex_unlock(&qpic_lifetime_lock);
+ ret = devm_add_action_or_reset(&pdev->dev, qpic_lifetime_release, life);
+ return ret ? ERR_PTR(ret) : life;
+fail_owner:
+ root_device_unregister(owner);
+unlock:
+ mutex_unlock(&qpic_lifetime_lock);
+ return ERR_PTR(ret);
+}
+EXPORT_SYMBOL_GPL(qcom_qpic_lifetime_create);
 
