+#define __QCOM_QPIC_LIFETIME_H
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/kconfig.h>
+struct platform_device;
+struct qcom_qpic_lifetime;
+#if IS_REACHABLE(CONFIG_QCOM_BAM_DMA)
+struct qcom_qpic_lifetime *qcom_qpic_lifetime_create(struct platform_device *pdev,
