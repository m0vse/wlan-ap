+/* This experiment is separate from the immutable RAM-only failure snapshot. */
+static void miami_probe_log(struct qcom_nand_controller *n, const char *fmt, ...)
+{
+ char line[256];
+ unsigned long flags;
+ va_list ap;
+ int count;
+
+ va_start(ap, fmt);
+ count = vscnprintf(line, sizeof(line), fmt, ap);
+ va_end(ap);
+ printk(KERN_ERR "MIAMI_PROBE %s\n", line);
+ spin_lock_irqsave(&n->miami_diag_lock, flags);
+ if (strstr(line, " begin")) {
+  strscpy(n->miami_probe_pending, line, sizeof(n->miami_probe_pending));
+  spin_unlock_irqrestore(&n->miami_diag_lock, flags);
+  return;
+ }
+ n->miami_probe_pending[0] = 0;
+ if ((unsigned int)count + 1 < sizeof(n->miami_probe_trace) - n->miami_probe_trace_len) {
+  memcpy(n->miami_probe_trace + n->miami_probe_trace_len, line, count);
+  n->miami_probe_trace_len += count;
+  n->miami_probe_trace[n->miami_probe_trace_len++] = '\n';
+  n->miami_probe_trace[n->miami_probe_trace_len] = 0;
+ } else {
+  n->miami_probe_trace_overflow = true;
+ }
+ spin_unlock_irqrestore(&n->miami_diag_lock, flags);
+}
+
+static void miami_probe_post_work(struct work_struct *work)
+{
+ struct qcom_nand_controller *n = container_of(to_delayed_work(work),
+                               struct qcom_nand_controller, miami_probe_work);
+ unsigned long flags;
+ u64 ok, corr, fail;
+ bool more;
+
+ spin_lock_irqsave(&n->miami_diag_lock, flags);
+ ok = n->miami_probe_ok; corr = n->miami_probe_corr; fail = n->miami_probe_fail;
+ more = ktime_get_boottime_ns() < n->miami_probe_post_until;
+ if (!more) n->miami_probe_post_until = 0;
+ spin_unlock_irqrestore(&n->miami_diag_lock, flags);
+ printk(KERN_ERR "MIAMI_PROBE post ok=%llu corr=%llu fail=%llu\n", ok, corr, fail);
+ if (more) schedule_delayed_work(&n->miami_probe_work, 60 * HZ);
+}
+
+static void miami_probe_cancel(void *arg)
+{
+ struct qcom_nand_controller *n = arg;
+ cancel_delayed_work_sync(&n->miami_probe_work);
+}
