+/* No commands, work, or provider queries in this later-read accounting path. */
+static void miami_probe_count(struct qcom_nand_host *host, int result,
+                              u32 failed_before, u32 corrected_before)
+{
+ struct qcom_nand_controller *n = get_qcom_nand_controller(&host->chip);
+ struct mtd_info *m = nand_to_mtd(&host->chip);
+ unsigned long flags;
+
+ if (n->miami_probe_active || !READ_ONCE(n->miami_probe_post_until)) return;
+ spin_lock_irqsave(&n->miami_diag_lock, flags);
+ if (ktime_get_boottime_ns() < n->miami_probe_post_until) {
+  if (result < 0 || m->ecc_stats.failed != failed_before) n->miami_probe_fail++;
+  else if (result || m->ecc_stats.corrected != corrected_before) n->miami_probe_corr++;
+  else n->miami_probe_ok++;
+ }
+ spin_unlock_irqrestore(&n->miami_diag_lock, flags);
+}
+
+static int miami_probe_id(struct qcom_nand_host *host, const char *phase)
+{
+ struct qcom_nand_controller *n = get_qcom_nand_controller(&host->chip);
+ int ret;
+
+ miami_probe_log(n, "%s ID begin", phase);
+ memset(n->data_buffer, 0, 4);
+ qcom_nandc_command(&host->chip, NAND_CMD_READID, 0, -1);
+ ret = n->miami_command_result;
+ if (!ret && (n->data_buffer[0] != 0xc2 || n->data_buffer[1] != 0xa6)) ret = -ENODEV;
+ miami_probe_log(n, "%s ID=%02x%02x ret=%d", phase,
+                 n->data_buffer[0], n->data_buffer[1], ret);
+ return ret;
+}
+
+static int miami_probe_get(struct qcom_nand_host *host, const char *phase, u8 address)
+{
+ struct qcom_nand_controller *n = get_qcom_nand_controller(&host->chip);
+ int value;
+
+ miami_probe_log(n, "%s G%02x begin", phase, address);
+ value = qcom_serial_get_feature(n, host, address);
+ if (value >= 0) value = (value >> 8) & 0xff;
+ miami_probe_log(n, "%s G%02x=%d", phase, address, value);
+ return value;
+}
+
+static int miami_probe_features(struct qcom_nand_host *host, const char *phase)
+{
+ const u8 addresses[] = { 0xa0, 0xb0, 0xc0 };
+ unsigned int i;
+ int ret;
+
+ ret = miami_probe_id(host, phase);
+ if (ret) return ret;
+ for (i = 0; i < ARRAY_SIZE(addresses); i++) {
+  ret = miami_probe_get(host, phase, addresses[i]);
+  if (ret < 0) return ret;
+ }
+ return 0;
+}
+
+/* Ordinary ECC page-read setup without re-entering the NAND/MTD core. */
+static bool miami_probe_read(struct qcom_nand_host *host, const char *which, int page)
+{
+ struct qcom_nand_controller *n = get_qcom_nand_controller(&host->chip);
+ struct mtd_info *m = nand_to_mtd(&host->chip);
+ u32 failed = m->ecc_stats.failed, corrected = m->ecc_stats.corrected;
+ unsigned int i;
+ int ret;
+ bool good;
+
+ miami_probe_log(n, "read %s p=%d begin", which, page);
+ memset(n->miami_probe_buffer, 0, m->writesize);
+ pre_command(host, NAND_CMD_READ0);
+ host->use_ecc = true;
+ set_address(host, 0, page);
+ update_rw_regs(host, host->chip.ecc.steps, true, 0);
+ clear_bam_transaction(n);
+ ret = read_page_ecc(host, n->miami_probe_buffer, NULL, page);
+ good = ret >= 0 && m->ecc_stats.failed == failed;
+ if (n->miami_dma_unsafe) {
+  miami_probe_log(n, "read %s r=%d status/magic unavailable DMA incomplete", which, ret);
+  goto restore_stats;
+ }
+ miami_probe_log(n, "read %s r=%d corr=%u fail=%u magic=%02x%02x%02x%02x", which,
+  ret, m->ecc_stats.corrected - corrected, m->ecc_stats.failed - failed,
+  n->miami_probe_buffer[0], n->miami_probe_buffer[1],
+  n->miami_probe_buffer[2], n->miami_probe_buffer[3]);
+ if (!n->miami_dma_unsafe)
+  for (i = 0; i < MIAMI_DIAG_CWS; i++)
+   miami_probe_log(n, "%s cw%u=%08x/%08x/%08x", which, i,
+    le32_to_cpu(n->reg_read_buf[3*i]), le32_to_cpu(n->reg_read_buf[3*i+1]),
+    le32_to_cpu(n->reg_read_buf[3*i+2]));
+ else miami_probe_log(n, "%s cw unavailable DMA incomplete", which);
+restore_stats:
+ /* Probe reads must not inflate the original caller's ECC accounting. */
+ m->ecc_stats.failed = failed; m->ecc_stats.corrected = corrected;
+ return good;
+}
+
+static void miami_probe_run(struct qcom_nand_host *host)
+{
+ struct qcom_nand_controller *n = get_qcom_nand_controller(&host->chip);
+ const unsigned int pebs[] = { 6, 7, 255, 256, 774, 775, 1023, 1024, 1025, 1181 };
+ unsigned int i, peb;
+ int page, canary = -1, ret, value;
+ u64 start, deadline;
+ bool first_good = false, other_good = false;
+ int saved_command = host->last_command;
+ bool saved_ecc = host->use_ecc;
+
+ if (!n->miami_diag_enabled || !n->miami_diag_ready || n->miami_probe_claimed) return;
+ /* Existing controller lock serializes this flag. Claim even rejected attempts. */
+ n->miami_probe_claimed = true;
+ page = n->miami_diag.page; peb = page / 64;
+ miami_probe_log(n, "start page=%d peb=%u orig_result=%d boottime_ns=%llu synthetic=%u",
+                 page, peb, n->miami_diag.result, ktime_get_boottime_ns(), n->miami_probe_synthetic);
+ if (!n->miami_probe_baseline_valid || !n->miami_probe_buffer ||
+     n->miami_dma_unsafe || host->codeword_fixup || peb < 6 || peb >= 1542) {
+  miami_probe_log(n, "abort baseline=%u buffer=%u dma_unsafe=%u layout=%u",
+    n->miami_probe_baseline_valid, !!n->miami_probe_buffer, n->miami_dma_unsafe,
+    host->codeword_fixup);
+  goto end;
+ }
+ for (i = 0; i < ARRAY_SIZE(pebs); i++)
+  if ((n->miami_diag_seen & BIT(i)) && (pebs[i] < 774) != (peb < 774)) {
+   canary = pebs[i] * 64; break;
+  }
+ if (canary < 0) { miami_probe_log(n, "abort no qualified other-bank canary"); goto end; }
+ n->miami_probe_active = true;
+ ret = miami_probe_features(host, "before");
+ if (ret) goto end;
+ miami_probe_log(n, "RESET begin");
+ qcom_nandc_command(&host->chip, NAND_CMD_RESET, -1, -1);
+ ret = n->miami_command_result;
+ if (!ret) ret = qpic_serial_check_status(n->reg_read_buf);
+ miami_probe_log(n, "RESET ret=%d", ret);
+ if (ret) goto end;
+ miami_probe_log(n, "poll C0 begin budget_us=10000 interval_us=100 transport_ms=2000");
+ start = ktime_get_boottime_ns(); deadline = start + 10000000;
+ do {
+  value = qcom_serial_get_feature(n, host, 0xc0);
+  if (value < 0) { miami_probe_log(n, "poll C0 error=%d elapsed_ns=%llu", value, ktime_get_boottime_ns() - start); goto end; }
+  if (ktime_get_boottime_ns() > deadline) break;
+  if (!((value >> 8) & BIT(0))) goto ready;
+  udelay(100);
+ } while (ktime_get_boottime_ns() < deadline);
+ miami_probe_log(n, "poll timeout elapsed_ns=%llu", ktime_get_boottime_ns() - start);
+ goto end;
+ready:
+ miami_probe_log(n, "poll ready elapsed_ns=%llu", ktime_get_boottime_ns() - start);
+ ret = miami_probe_features(host, "after");
+ if (ret) goto end;
+ miami_probe_log(n, "SET A0=%02x begin", n->miami_probe_boot_a0);
+ ret = qcom_serial_set_feature(n, host, 0xa0, n->miami_probe_boot_a0);
+ miami_probe_log(n, "SET A0 ret=%d", ret);
+ if (ret) goto end;
+ miami_probe_log(n, "SET B0=01 begin");
+ ret = qcom_serial_set_feature(n, host, 0xb0, 0x01);
+ miami_probe_log(n, "SET B0 ret=%d", ret);
+ if (ret) goto end;
+ value = miami_probe_get(host, "verify", 0xa0);
+ if (value < 0 || value != n->miami_probe_boot_a0) goto mismatch;
+ value = miami_probe_get(host, "verify", 0xb0);
+ if (value != 0x01) goto mismatch;
+ miami_probe_log(n, "verify match=1");
+ first_good = miami_probe_read(host, "same", page);
+ if (!n->miami_dma_unsafe) other_good = miami_probe_read(host, "other", canary);
+ goto end;
+mismatch:
+ miami_probe_log(n, "verify match=0 value=%d", value);
+end:
+ miami_probe_log(n, "end recovered=%u", first_good && other_good);
+ n->miami_probe_active = false;
+ host->last_command = saved_command; host->use_ecc = saved_ecc;
+ n->miami_probe_post_until = ktime_get_boottime_ns() + 600000000000ULL;
+ schedule_delayed_work(&n->miami_probe_work, 60 * HZ);
+}
