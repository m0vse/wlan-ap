+/* The explicit bench reader is the only task allowed to consume this arm.
+ * Never inject into UBI background I/O or an ordinary application read. */
+static void miami_probe_inject(struct qcom_nand_host *host, int page)
+{
+ struct qcom_nand_controller *n = get_qcom_nand_controller(&host->chip);
+ unsigned long flags;
+ bool inject = false;
+
+ if (strcmp(current->comm, "miami-ecc-test")) return;
+ spin_lock_irqsave(&n->miami_diag_lock, flags);
+ if (n->miami_probe_test_pending && !n->miami_diag_claimed &&
+     n->miami_probe_test_page == (unsigned int)page && !n->miami_dma_unsafe) {
+  n->miami_probe_test_pending = false;
+  n->miami_probe_synthetic = true;
+  inject = true;
+ }
+ spin_unlock_irqrestore(&n->miami_diag_lock, flags);
+ if (inject) {
+  /* Change only the DMA-completed RAM status, never the array or MMIO. */
+  n->reg_read_buf[0] = cpu_to_le32(FS_OP_ERR);
+  n->reg_read_buf[1] = cpu_to_le32(BS_UNCORRECTABLE_BIT);
+  n->reg_read_buf[2] = 0;
+  printk(KERN_ERR "MIAMI_PROBE synthetic ECC page=%d\n", page);
+ }
+}
