+/* Only CPU reads of documented controller registers; no array access. */
+static void miami_diag_take(struct qcom_nand_host *host,
+                           struct miami_nand_diag *d, int page,
+                           const char *reason, bool status_valid)
+{
+ struct qcom_nand_controller *n = get_qcom_nand_controller(&host->chip);
+ struct mtd_info *m = nand_to_mtd(&host->chip);
+ const unsigned int offsets[MIAMI_DIAG_REGS] = {
+  NAND_FLASH_CMD, NAND_ADDR0, NAND_ADDR1, NAND_FLASH_STATUS,
+  NAND_BUFFER_STATUS, NAND_DEV0_CFG0, NAND_DEV0_CFG1, NAND_DEV0_ECC_CFG,
+  NAND_CTRL, NAND_VERSION, NAND_ERASED_CW_DETECT_STATUS,
+  NAND_FLASH_SPI_CFG, NAND_QSPI_MSTR_CONFIG, NAND_FLASH_FEATURES
+ };
+ unsigned int i;
+
+ memset(d, 0, sizeof(*d));
+ d->ns = ktime_get_boottime_ns();
+ d->page = page; d->reason = reason; d->command = host->last_command;
+ d->status_valid = status_valid;
+ d->failed = m->ecc_stats.failed; d->corrected = m->ecc_stats.corrected;
+ d->hz = clk_get_rate(n->iomacro_clk);
+ for (i = 0; i < MIAMI_DIAG_REGS; i++)
+  d->regs[i] = nandc_read(n, offsets[i] == NAND_FLASH_SPI_CFG ?
+                          dev_cmd_reg_addr(n, offsets[i]) : offsets[i]);
+ if (status_valid)
+  for (i = 0; i < MIAMI_DIAG_CWS * 3; i++)
+   d->status[i] = le32_to_cpu(n->reg_read_buf[i]);
+ if (status_valid && n->status_buf)
+  for (i = 0; i < MIAMI_DIAG_CWS * 3; i++)
+   d->page_scope_status[i] = le32_to_cpu(n->status_buf[i]);
+ for (i = 0; i < 4; i++) {
+  struct dma_chan *chan = i == 0 ? n->cmd_chan : i == 1 ? n->rx_chan :
+                          i == 2 ? n->tx_chan : n->sts_chan;
+  d->dma_cookie[i] = n->miami_diag_cookie[i];
+  d->dma_state[i] = !chan || d->dma_cookie[i] <= 0 ? -ENODATA :
+                   dma_async_is_tx_complete(chan, d->dma_cookie[i], NULL, NULL);
+ }
+ d->codewords = n->max_cwperpage;
+ if (n->bam_txn) {
+  d->ce = n->bam_txn->bam_ce_pos;
+  d->cmd_sgl = n->bam_txn->cmd_sgl_pos;
+  d->rx_sgl = n->bam_txn->rx_sgl_pos;
+  d->tx_sgl = n->bam_txn->tx_sgl_pos;
+  d->sts_sgl = n->bam_txn->sts_sgl_pos;
+ }
+ for (i = 0; i < 3; i++) d->feature[i] = -ENODATA;
+}
