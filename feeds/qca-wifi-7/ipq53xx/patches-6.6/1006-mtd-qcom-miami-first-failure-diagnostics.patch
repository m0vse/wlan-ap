+/* Observe the existing canary reads, never issue an additional page read.
+ * Only previously observed UBI# headers qualify: free/bad/unformatted
+ * blocks cannot become a false first fault. Addresses are physical PEBs
+ * for this exact board's fixed bank offsets, not unstable MTD numbers.
+ */
+static void miami_diag_header(struct qcom_nand_host *host, const u8 *data,
+                             int page, int result)
+{
+ struct qcom_nand_controller *n = get_qcom_nand_controller(&host->chip);
+ const unsigned int pebs[] = { 6, 7, 255, 256, 774, 775,
+                               1023, 1024, 1025, 1181 };
+ struct miami_nand_diag d;
+ unsigned int i, peb;
+
+ if (!n->miami_diag_enabled || n->miami_diag_claimed || !data ||
+     result < 0 || page % 64) return;
+ peb = page / 64;
+ for (i = 0; i < ARRAY_SIZE(pebs); i++) {
+  if (peb != pebs[i]) continue;
+  if (!memcmp(data, "UBI#", 4)) {
+   n->miami_diag_seen |= BIT(i);
+  } else if (n->miami_diag_seen & BIT(i)) {
+   miami_diag_take(host, &d, page, "qualified_ec_header_changed", true);
+   d.result = result;
+   d.header = ((u32)data[0] << 24) | ((u32)data[1] << 16) |
+              ((u32)data[2] << 8) | data[3];
+   miami_diag_publish(host, &d, true);
+  }
+  return;
+ }
 }
 
