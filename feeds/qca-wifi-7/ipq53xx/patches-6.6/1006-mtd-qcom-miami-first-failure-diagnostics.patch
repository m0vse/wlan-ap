+/* Reading this attribute copies cached facts only; it never touches NAND.
+ * It cannot clear/rearm the record, and remains readable after flash fails. */
+static ssize_t miami_first_failure_show(struct device *dev,
+                                        struct device_attribute *attr, char *buf)
+{
+ struct qcom_nand_controller *n = dev_get_drvdata(dev);
+ struct miami_nand_diag d;
+ unsigned long flags;
+ unsigned int i;
+ bool ready;
+ ssize_t len = 0;
+
+ spin_lock_irqsave(&n->miami_diag_lock, flags);
+ ready = n->miami_diag_ready;
+ d = n->miami_diag;
+ spin_unlock_irqrestore(&n->miami_diag_lock, flags);
+ if (!ready)
+  return sysfs_emit(buf, "state=armed qualified_samples=0x%x\n",
+                    READ_ONCE(n->miami_diag_seen));
+ len += sysfs_emit_at(buf, len,
+  "state=captured reason=%s boottime_ns=%llu page=%d physical_peb=%d result=%d command=%d\n"
+  "clock_hz=%lu ecc_failed_before=%u ecc_corrected_before=%u observed_magic=%08x\n"
+  "status_valid=%u codewords=%u bam_ce=%u cmd_sgl=%u rx_sgl=%u tx_sgl=%u sts_sgl=%u\n"
+  "features_after_erased_check A0=%d B0=%d C0=%d (-61=not_read)\n",
+  d.reason, d.ns, d.page, d.page / 64, d.result, d.command,
+  d.hz, d.failed, d.corrected, d.header,
+  d.status_valid, d.codewords, d.ce, d.cmd_sgl, d.rx_sgl, d.tx_sgl, d.sts_sgl,
+  d.feature[0], d.feature[1], d.feature[2]);
+ for (i = 0; i < MIAMI_DIAG_REGS; i++)
+  len += sysfs_emit_at(buf, len, "reg[%u]=%08x\n", i, d.regs[i]);
+ for (i = 0; i < MIAMI_DIAG_CWS; i++)
+  len += sysfs_emit_at(buf, len, "cw[%u] flash=%08x buffer=%08x erased=%08x\n",
+                      i, d.status[3*i], d.status[3*i+1], d.status[3*i+2]);
+ for (i = 0; i < MIAMI_DIAG_CWS; i++)
+  len += sysfs_emit_at(buf, len, "page_scope_cw[%u] flash=%08x buffer=%08x erased=%08x\n",
+                      i, d.page_scope_status[3*i], d.page_scope_status[3*i+1], d.page_scope_status[3*i+2]);
+ for (i = 0; i < 4; i++)
+  len += sysfs_emit_at(buf, len, "dma[%u] cookie=%d state=%d (-61=not_submitted)\n",
+                      i, d.dma_cookie[i], d.dma_state[i]);
+ return len;
+}
