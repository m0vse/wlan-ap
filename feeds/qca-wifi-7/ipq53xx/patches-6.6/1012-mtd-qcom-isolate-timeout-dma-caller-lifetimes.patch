+/* Poison is shared with the independently owned BAM provider. No MMIO is
+ * needed here, including when provider removal poisoned the client first. */
+static bool miami_io_blocked(struct qcom_nand_controller *nandc)
+{
+	return nandc->miami_dma_unsafe ||
+		qcom_qpic_lifetime_poisoned(nandc->lifetime);
+}
+
+#define MIAMI_DMA_TRANSACTION_LIMIT (128U * 1024U)
+
+static int miami_dma_reserve(struct qcom_nand_controller *nandc, size_t bytes)
+{
+	if (miami_io_blocked(nandc))
+		return -EIO;
+	if (nandc->miami_dma_bytes > MIAMI_DMA_TRANSACTION_LIMIT ||
+	    bytes > MIAMI_DMA_TRANSACTION_LIMIT - nandc->miami_dma_bytes)
+		return -E2BIG;
+	nandc->miami_dma_bytes += bytes;
+	return 0;
+}
+
+/* Only after all DMA has completed and mappings have returned to CPU
+ * ownership may RX data be copied to the original caller. On poison, this
+ * helper is never run: the bounded arena and mappings remain quarantined. */
+static void miami_dma_release(struct qcom_nand_controller *nandc,
+			      struct desc_info *desc, bool copy_rx)
+{
+	unsigned int i;
+
+	for (i = 0; i < desc->copies_count; i++) {
+		struct miami_dma_copy *copy = &desc->copies[i];
+
+		if (copy_rx && copy->original && desc->dir == DMA_FROM_DEVICE)
+			memcpy(copy->original, copy->bounce, copy->length);
+		kfree(copy->bounce);
+	}
+	kfree(desc->copies);
+	nandc->miami_dma_bytes -= desc->isolated_bytes;
+}
 
+static int miami_bounce_sg(struct qcom_nand_controller *nandc,
+			   struct desc_info *desc, struct scatterlist *sgl,
+			   unsigned int count)
+{
+	size_t bytes;
+	unsigned int i;
+	int ret;
+
+	if (!nandc->lifetime)
+		return 0;
+	/* The division check bounds multiplication as well as allocation. */
+	if (!count || count > MIAMI_DMA_TRANSACTION_LIMIT / sizeof(*desc->copies))
+		return -E2BIG;
+	bytes = count * sizeof(*desc->copies);
+	ret = miami_dma_reserve(nandc, bytes);
+	if (ret)
+		return ret;
+	desc->isolated_bytes += bytes;
+	desc->copies = kcalloc(count, sizeof(*desc->copies), GFP_KERNEL);
+	if (!desc->copies)
+		return -ENOMEM;
+	desc->copies_count = count;
+
+	for (i = 0; i < count; i++) {
+		struct miami_dma_copy *copy = &desc->copies[i];
+
+		copy->original = sg_virt(&sgl[i]);
+		copy->length = sgl[i].length;
+		if (!copy->original || !copy->length)
+			return -EINVAL;
+		ret = miami_dma_reserve(nandc, copy->length);
+		if (ret)
+			return ret;
+		desc->isolated_bytes += copy->length;
+		copy->bounce = kzalloc(copy->length, GFP_KERNEL);
+		if (!copy->bounce)
+			return -ENOMEM;
+		if (desc->dir == DMA_TO_DEVICE)
+			memcpy(copy->bounce, copy->original, copy->length);
+		sg_set_buf(&sgl[i], copy->bounce, copy->length);
+	}
+	return 0;
+}
