+static void
+uc_hostapd_restore_channel(struct hostapd_iface *iface,
+			   struct hostapd_config *previous, int freq)
+{
+	struct hostapd_config *conf = iface->conf;
+
+	/* Restore scalars only: lifecycle helpers may change pointer ownership. */
+	conf->hw_mode = previous->hw_mode;
+	conf->channel = previous->channel;
+	conf->op_class = previous->op_class;
+	conf->secondary_channel = previous->secondary_channel;
+	conf->acs = previous->acs;
+	conf->punct_bitmap = previous->punct_bitmap;
+	conf->he_6ghz_reg_pwr_type = previous->he_6ghz_reg_pwr_type;
+	hostapd_set_oper_chwidth(conf, hostapd_get_oper_chwidth(previous));
+	hostapd_set_oper_centr_freq_seg0_idx(conf,
+			hostapd_get_oper_centr_freq_seg0_idx(previous));
+	hostapd_set_oper_centr_freq_seg1_idx(conf,
+			hostapd_get_oper_centr_freq_seg1_idx(previous));
+	iface->freq = freq;
+}
