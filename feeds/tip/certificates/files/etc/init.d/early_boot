#!/bin/sh /etc/rc.common

START=09

copy_certificates() {
	[ -f /certificates/key.pem ] || return

	cp /certificates/*.pem /certificates/*.ca /etc/ucentral/ 2>/dev/null || true
	chown root.network /etc/ucentral/*.pem /etc/ucentral/*.ca
	chmod 0440 /etc/ucentral/*.pem /etc/ucentral/*.ca
	[ -f /certificates/gateway.json ] && cp /certificates/gateway.json /etc/ucentral/gateway.flash
	# Installer gateway is a default, not an explicit controller pin.
	[ ! -f /certificates/gateway.default.json ] ||
		cp /certificates/gateway.default.json /etc/ucentral/gateway.default.json
	[ ! -f /certificates/est.json ] || cp /certificates/est.json /etc/ucentral/est.json
	[ ! -f /certificates/est-bootstrap.conf ] || cp /certificates/est-bootstrap.conf /etc/ucentral/est-bootstrap.conf
	[ ! -f /etc/ucentral/gateway.default.json ] || [ -f /etc/ucentral/gateway.json ] ||
		cp /etc/ucentral/gateway.default.json /etc/ucentral/gateway.json
	chmod 0600 /etc/ucentral/est.json /etc/ucentral/est-bootstrap.conf /etc/ucentral/gateway.default.json 2>/dev/null || true
	[ -f /certificates/restrictions.json ] && cp /certificates/restrictions.json /etc/ucentral/
	/usr/libexec/ucentral-restore-discovery-policy || return 1
	[ -f /certificates/sign_pubkey.pem ] && cp /certificates/sign_pubkey.pem /etc/ucentral/
	country=`cat /certificates/ucentral.defaults | jsonfilter -e '@.country'`
	[ -z "$country" -a -f /etc/uci-defaults/30_uboot-envtools ] && {
		(. /etc/uci-defaults/30_uboot-envtools)
		fw_printenv 
		country=$(fw_printenv -n country)
	}
	[ -z "$country" ] && country=US
	echo "options cfg80211 ieee80211_regdom="$country > /etc/modules.conf 
	echo -n $country > /etc/ucentral/country
	sync
	exit 0
}

boot() {
	# Apply pending installer identity before the saved-file shortcut.
	/usr/libexec/ucentral-installer-boot prepare || return 1
	case "$(board_name)" in
	sonicfi,rap6*)
		touch /tmp/squashfs
	;;
	esac
	# Skip the restore only when fully provisioned. Checking key.pem alone was
	# not enough: an app factory reset with keep_redirector (cmd_factory.uc)
	# preserves key.pem but not operational.pem, which made this return early
	# and never restore the operational cert stored in the insta partition.
	if [ -f /etc/ucentral/key.pem -a -f /etc/ucentral/operational.pem ]; then
		# Saved identities do not imply that the discovery policy was archived.
		if [ -f /lib/functions/cambium-ab.sh ] && (. /lib/functions/cambium-ab.sh; ab_family); then
			/usr/bin/mount_certs || return 1
		fi
		/usr/libexec/ucentral-restore-discovery-policy || return 1
		/usr/libexec/ucentral-restore-operational-gateway || return 1
		return 0
	fi
	/usr/bin/mount_certs
	copy_certificates
}
