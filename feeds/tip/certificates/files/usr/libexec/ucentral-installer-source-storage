#!/bin/sh
# Read-only admission for active-bank durable source-key staging.
set -eu
. /lib/functions/system.sh
. /lib/functions/cambium-ab.sh
ab_identity >/dev/null || exit 1
case "$AB_FAMILY:$AB_MODEL:$AB_LAYOUT" in
 sage:E410:pair|sage:E410B:pair|jaguar:XV2-2:banks|jaguar:XV2-2T1:banks|jaguar:XE3-4:banks|cheetah:XV2-21X:banks|thor:XV3-8:banks) ;;
 *) exit 1 ;;
esac
[ "$(cat "/sys/class/ubi/$AB_ACTIVE_UBI/mtd_num")" = "$AB_ACTIVE_MTD" ] || exit 1
[ -d /root ] && [ ! -L /root ] && [ "$(readlink -f /root)" = /root ] || exit 1
# Reject another mount covering /root or the candidate identity subtree.
awk '$2=="/root" || index($2,"/root/")==1 {bad=1} END {exit bad}' /proc/mounts || exit 1
root_type=$(awk '$2=="/" {print $3}' /proc/mounts)
case "$root_type" in
 ubifs)
  if [ "$AB_LAYOUT" = pair ]; then name=rootfs$AB_ACTIVE; else name=rootfs; fi
  volume=$(ab_ubi_volume "$AB_ACTIVE_UBI" "$name") || exit 1
  awk -v dev="/dev/$volume" -v named="$AB_ACTIVE_UBI:$name" '
   $2=="/" && $3=="ubifs" && ($1==dev || $1==named) && $4 ~ /(^|,)rw(,|$)/ {good=1}
   END {exit !good}' /proc/mounts || exit 1
  ;;
 overlay)
  if [ "$AB_LAYOUT" = pair ]; then name=rootfs_data$AB_ACTIVE; else name=rootfs_data; fi
  volume=$(ab_ubi_volume "$AB_ACTIVE_UBI" "$name") || exit 1
  awk -v dev="/dev/$volume" -v named="$AB_ACTIVE_UBI:$name" '
   $2=="/overlay" && $3=="ubifs" && ($1==dev || $1==named) && $4 ~ /(^|,)rw(,|$)/ {good=1}
   END {exit !good}' /proc/mounts || exit 1
  awk '$2=="/" && $3=="overlay" && $4 ~ /(^|,)rw(,|$)/ &&
   $4 ~ /(^|,)upperdir=\/overlay\/upper(,|$)/ && $4 ~ /(^|,)workdir=\/overlay\/work(,|$)/ {good=1}
   END {exit !good}' /proc/mounts || exit 1
  ;;
 *) exit 1 ;;
esac
