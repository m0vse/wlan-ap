#!/bin/sh
set -eu
operation=${1:-check}
case "$operation" in prepare|check|pending) ;; *) exit 1 ;; esac
[ -f /lib/functions/cambium-ab.sh ] || { [ "$operation" != pending ]; exit $?; }
. /lib/functions/system.sh
. /lib/functions/cambium-ab.sh
ab_family >/dev/null || { [ "$operation" != pending ]; exit $?; }
target=$(ab_getenv "${AB_ENV}_installer_target") || target=
job=$(ab_getenv "${AB_ENV}_installer_job") || job=
image=$(ab_getenv "${AB_ENV}_installer_image") || image=
[ -n "$target$job$image" ] || { [ "$operation" != pending ]; exit $?; }
ab_identity >/dev/null || exit 1
case "$target" in 0|1) ;; *) exit 1 ;; esac
[ "$target" = "$AB_ACTIVE" ] || { [ "$operation" != pending ]; exit $?; }
for value in "$job" "$image"; do
 case "$value" in ''|*[!0-9a-f]*) exit 1 ;; esac
 [ "${#value}" = 64 ] || exit 1
done
[ "$operation" != pending ] || exit 0
[ -x /usr/libexec/ucentral-installer-identity ] || exit 1
case "$operation" in
 prepare) exec /usr/libexec/ucentral-installer-identity prepare-settings /root/.cambium-installer-settings ;;
 check) exec /usr/libexec/ucentral-installer-identity check-settings /root/.cambium-installer-settings ;;
esac
