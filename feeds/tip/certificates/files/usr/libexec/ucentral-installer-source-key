#!/bin/sh
# Internal helper for qualified source bridges only. It does not submit a CSR.
# The source writer must separately prove this directory survives target -n.
set -eu
umask 077
fail() { echo 'Source enrollment identity refused.' >&2; exit 1; }
private() { [ -f "$1" ] && [ ! -L "$1" ] && [ "$(stat -c '%u:%a:%h' "$1")" = 0:600:1 ]; }
sync_store() { sync || fail; }
spki_key() { openssl pkey -in "$1" -pubout -outform DER 2>/dev/null | sha256sum | cut -d ' ' -f 1; }
spki_csr() { openssl req -in "$1" -pubkey -noout 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | sha256sum | cut -d ' ' -f 1; }
[ "$#" -ge 3 ] && [ "$#" -le 4 ] || fail
operation=$1 serial=$2 directory=$3 existing=${4:-}
[ "$directory" = /root/.cambium-enrollment-source ] || fail
[ -x /usr/libexec/ucentral-installer-source-storage ] &&
 /usr/libexec/ucentral-installer-source-storage || fail
case "$operation" in prepare|intent|verify) ;; *) fail ;; esac
case "$serial" in ''|*[!0-9a-f]*) fail ;; esac
[ "${#serial}" = 12 ] || fail
case "$directory" in /*) ;; *) fail ;; esac
case "$directory" in *[!A-Za-z0-9_./-]*|*/..*|*/) fail ;; esac
[ "$(id -u)" = 0 ] || fail
valid_existing() {
 certificate=${existing%/*}/cert.pem
 [ -f "$certificate" ] && [ ! -L "$certificate" ] &&
 [ "$(stat -c '%u:%h' "$certificate")" = 0:1 ] || fail
 case "$(stat -c '%a' "$certificate")" in 600|440) ;; *) fail ;; esac
 [ -f "$existing" ] && [ ! -L "$existing" ] && [ "$(stat -c '%u:%h' "$existing")" = 0:1 ] || fail
 case "$(stat -c '%a' "$existing")" in 600|440) ;; *) fail ;; esac
 openssl pkey -in "$existing" -check -noout >/dev/null 2>&1 || fail
 fingerprint=$(spki_key "$existing")
 [ "$(openssl x509 -in "$certificate" -pubkey -noout 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | sha256sum | cut -d ' ' -f1)" = "$fingerprint" ] || fail
 cert_serial=$(openssl x509 -in "$certificate" -subject -noout -nameopt multiline 2>/dev/null | awk -F ' = ' '$1 ~ /^[[:space:]]*commonName[[:space:]]*$/ {value=$2;count++} END{if(count!=1)exit 1;print value}') || fail
 [ "$(printf '%s' "$cert_serial" | tr 'A-F' 'a-f')" = "$serial" ] || fail
}
[ -z "$existing" ] || valid_existing
if [ ! -e "$directory" ] && [ ! -L "$directory" ]; then
 [ "$operation" = prepare ] || fail
 mkdir -m 700 "$directory" || fail
 sync_store
fi
[ -d "$directory" ] && [ ! -L "$directory" ] &&
[ "$(stat -c '%u:%a' "$directory")" = 0:700 ] &&
[ "$(readlink -f "$directory")" = "$directory" ] || fail
# Kernel lock releases on process loss/reboot; the durable key is separate.
lock=/tmp/ucentral-enrollment-source.lock
command -v flock >/dev/null 2>&1 || fail
[ ! -e "$lock" ] && [ ! -L "$lock" ] || private "$lock" || fail
exec 9> "$lock"
flock -n 9 || fail
for path in "$directory"/* "$directory"/.[!.]* "$directory"/..?*; do
 [ -e "$path" ] || [ -L "$path" ] || continue
 case "${path##*/}" in key.pem|key.pending.pem|csr.pem|csr.pending.pem|binding|binding.pending|issuance-intent|issuance-intent.pending) private "$path" || fail ;; *) fail ;; esac
done
key=$directory/key.pem
if [ ! -e "$key" ]; then
 [ "$operation" = prepare ] && [ ! -e "$directory/issuance-intent" ] &&
 [ ! -e "$directory/issuance-intent.pending" ] && [ ! -e "$directory/binding" ] &&
 [ ! -e "$directory/csr.pem" ] || fail
 if [ ! -e "$directory/key.pending.pem" ]; then
  if [ -n "$existing" ]; then
   valid_existing
   cp "$existing" "$directory/key.pending.pem" || fail
  else
   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out "$directory/key.pending.pem" >/dev/null 2>&1 || fail
  fi
  chmod 600 "$directory/key.pending.pem" || fail
 fi
 private "$directory/key.pending.pem" && openssl pkey -in "$directory/key.pending.pem" -check -noout >/dev/null 2>&1 || fail
 sync_store
 mv "$directory/key.pending.pem" "$key" || fail
 sync_store
fi
private "$key" && openssl pkey -in "$key" -check -noout >/dev/null 2>&1 || fail
fingerprint=$(spki_key "$key")
case "$fingerprint" in ''|*[!0-9a-f]*) fail ;; esac
[ "${#fingerprint}" = 64 ] || fail
[ -z "$existing" ] || [ "$(spki_key "$existing")" = "$fingerprint" ] || fail

binding=$(printf 'serial\t%s\nspki_sha256\t%s' "$serial" "$fingerprint")
if [ -e "$directory/binding" ]; then
 [ "$(cat "$directory/binding")" = "$binding" ] || fail
else
 [ "$operation" = prepare ] && [ ! -e "$directory/issuance-intent" ] || fail
 printf '%s\n' "$binding" > "$directory/binding.pending"
 sync_store
 mv "$directory/binding.pending" "$directory/binding" || fail
 sync_store
fi
if [ ! -e "$directory/csr.pem" ]; then
 [ "$operation" = prepare ] && [ ! -e "$directory/issuance-intent" ] && [ ! -e "$directory/issuance-intent.pending" ] || fail
 openssl req -new -key "$key" -subj "/CN=$serial" -out "$directory/csr.pending.pem" >/dev/null 2>&1 || fail
 chmod 600 "$directory/csr.pending.pem"
 sync_store
 mv "$directory/csr.pending.pem" "$directory/csr.pem" || fail
 sync_store
fi
private "$directory/csr.pem" && openssl req -in "$directory/csr.pem" -verify -noout >/dev/null 2>&1 &&
[ "$(spki_csr "$directory/csr.pem")" = "$fingerprint" ] &&
[ "$(openssl req -in "$directory/csr.pem" -subject -noout -nameopt RFC2253 2>/dev/null)" = "subject=CN=$serial" ] || fail
csr_hash=$(sha256sum "$directory/csr.pem" | cut -d ' ' -f 1)
intent=$(printf '%s\ncsr_sha256\t%s' "$binding" "$csr_hash")
for path in "$directory/issuance-intent" "$directory/issuance-intent.pending"; do
 [ ! -e "$path" ] || [ "$(cat "$path")" = "$intent" ] || fail
done
if [ "$operation" = intent ]; then
 if [ ! -e "$directory/issuance-intent" ]; then
  printf '%s\n' "$intent" > "$directory/issuance-intent.pending"
  sync_store
  mv "$directory/issuance-intent.pending" "$directory/issuance-intent" || fail
 fi
 sync_store
fi
printf 'Source enrollment identity ready.\n'
