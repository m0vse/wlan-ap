#!/bin/sh
# Read-only context for authenticated converted-stock bridges only.
# OEM bridges require their separately reviewed standalone callback.
set -eu
. /lib/functions/system.sh
. /lib/functions/cambium-ab.sh
ab_identity >/dev/null || exit 1
serial=$(get_mac_label_dt | tr -d ':' | tr 'A-F' 'a-f') || exit 1
native_serial=$(get_mac_label | tr -d ':' | tr 'A-F' 'a-f') || exit 1
[ "$serial" = "$native_serial" ] || exit 1
case "$serial" in ''|*[!0-9a-f]*) exit 1 ;; esac
[ "${#serial}" = 12 ] || exit 1
printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$serial" "$AB_FAMILY" "$AB_MODEL" "$AB_ACTIVE" \
 "$(ab_getenv "${AB_ENV}_installer_target")" "$(ab_getenv "${AB_ENV}_installer_job")" "$(ab_getenv "${AB_ENV}_installer_image")"
