#!/bin/sh
# Capability discovery must finish for all Miami serving bands before render.
bands=$(jsonfilter -i /etc/ucentral/capabilities.json -e '@.wifi[*].band[*]' 2>/dev/null) || exit 1
radios=$(jsonfilter -i /etc/ucentral/capabilities.json -e '@.wifi[*].band[0]' 2>/dev/null) || exit 1
printf '%s\n' "$radios" | awk 'NF { n++ } END { exit(n < 3) }' || exit 1
for band in 2G 5G 6G; do
	printf '%s\n' "$bands" | grep -qx "$band" || exit 1
done
exit 0
