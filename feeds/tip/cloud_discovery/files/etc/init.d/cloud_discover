#!/bin/sh /etc/rc.common

START=98
USE_PROCD=1
PROG=/usr/bin/cloud_discovery

service_triggers() {
	procd_add_reload_trigger ucentral
}

reload_service() {
	ubus call cloud reload
}

start_service() {
	if [ -x /usr/libexec/ucentral-private-pki ]; then
		local identity_mode
		identity_mode=$(/usr/libexec/ucentral-private-pki mode) || return 1
		[ "$identity_mode" != private ] || return 0
	fi
	[ -e /tmp/ucentral-network.ready ] || return 1
	[ -f /etc/ucentral/capabilities.json ] || {
		mkdir -p /etc/ucentral/
		/usr/share/ucentral/capabilities.uc
	}

	# S18 rendered the saved configuration or DHCP-only factory profile.
	# Never replace an invalid/dangling saved configuration with late defaults.

	est_client check
	[ $? -eq 1 ] && {
		logger ERROR
		logger ERROR
		logger ERROR
		logger The certificate used has a CN that does not match the serial of the device
		echo The certificate used has a CN that does not match the serial of the device
		logger ERROR
		logger ERROR
		logger ERROR
		return
	}

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn
	procd_close_instance
}
