#!/usr/bin/ucode

'use strict';

import { ulog_open, ulog, ULOG_SYSLOG, ULOG_STDIO, LOG_DAEMON, LOG_INFO } from 'log';
import { query } from 'resolv';
import * as libubus from 'ubus';
import * as uloop from 'uloop';
import * as libuci from 'uci';
import * as math from 'math';
import * as fs from 'fs';
import { select_controller, default_policy } from '/usr/share/ucentral/discovery_policy.uc';


const DISCOVER = 0;
const VALIDATING = 1;
const ONLINE = 2;
const OFFLINE = 3;
const ORPHAN = 4;

const DISCOVER_DHCP = "DHCP";
const DISCOVER_FLASH = "FLASH";
const DISCOVER_DEFAULT = "DEFAULT";
const DISCOVER_FQDN = "STANDARD_FQDN";
const DISCOVER_LOOKUP = "OpenLAN";

const STANDARD_FQDN = "openwifi.wlan.local";
const STANDARD_FQDN_PORT = 15002;

let ubus = libubus.connect();
let uci = libuci.cursor();
let state = DISCOVER;
let discovery_method = "";
let discovery_block_list = [];
let gateway_before_validation = null;
let validate_time;
let offline_time;
let orphan_time;
let interval;
let timeouts = {
	'offline': 4 * 60 * 60,
	'validate': 120,
	'orphan': 2 * 60 * 60,
	interval: 10000,
	expiry_interval: 60 * 60 * 1000,
	expiry_threshold: 90 * 24 * 60 * 60,
};

ulog_open(ULOG_SYSLOG | ULOG_STDIO, LOG_DAEMON, "cloud_discover");

ulog(LOG_INFO, 'Start\n');

uloop.init();

let cds_server = 'discovery.open-lan.org';

function detect_certificate_type() {
	let pipe = fs.popen(`openssl x509 -in /etc/ucentral/cert.pem -noout -issuer`);
	let issuer = pipe.read("all");
	pipe.close();

	if (match(issuer, /OpenLAN Demo Birth CA/)) {
		ulog(LOG_INFO, 'Certificate type is "Demo" \n');
		cds_server = 'discovery-qa.open-lan.org';
		timeouts.expiry_threshold = 3 * 24 * 60 * 60;
	} else if (match(issuer, /OpenLAN Birth Issuing CA/)) {
		ulog(LOG_INFO, 'Certificate type is "Production"\n');
	} else {
		ulog(LOG_INFO, 'Certificate type is "TIP"\n');
	}
}

function readjsonfile(path) {
	let file = fs.readfile(path);
	if (!file)
		return null;
	try { return json(file); }
	catch (e) { return null; }
}

function discovery_policy() {
	let raw = fs.readfile('/etc/ucentral/discovery-policy.json');
	if (raw == null)
		return null;
	try { return json(raw) ?? {}; }
	catch (e) { return {}; }
}

function controller_allowed(server, port) {
	let selected = select_controller(null, `${server}:${port}`, discovery_policy());
	return selected && selected.dhcp_server == server && selected.dhcp_port == +port;
}

function gateway_credentials_ready(gateway) {
	return gateway && controller_allowed(gateway.server, gateway.port) &&
		fs.stat(gateway.cert ?? '/etc/ucentral/operational.pem')?.type == 'file' &&
		fs.stat(gateway.ca ?? '/etc/ucentral/operational.ca')?.type == 'file';
}

function installer_default() {
	let gateway = readjsonfile('/etc/ucentral/gateway.default.json');
	if (!gateway && default_policy(discovery_policy()))
		gateway = readjsonfile('/etc/ucentral/gateway.json');
	if (gateway?.cert != '/etc/ucentral/operational.pem' || gateway.hostname_validate != 1 ||
	    gateway['allow-self-signed'] === true ||
	    !(gateway.ca in ['/etc/ssl/certs/ca-certificates.crt', '/etc/ucentral/server-ca.pem']))
		return null;
	return gateway_credentials_ready(gateway) ? gateway : null;
}

function pinned_gateway() {
	// Flash and manual birth-certificate provisioning are explicit pins.
	// An installer default never pins the current DHCP destination.
	let flash = readjsonfile('/etc/ucentral/gateway.flash');
	if (gateway_credentials_ready(flash))
		return flash;
	let gateway = readjsonfile('/etc/ucentral/gateway.json');
	if ((!installer_default() && discovery_policy() != null || gateway?.cert == '/etc/ucentral/cert.pem') &&
	    gateway_credentials_ready(gateway))
		return gateway;
	return null;
}

function timeouts_load(){
	let data = uci.get_all('ucentral', 'timeouts');

	for (let key in [ 'offline', 'validate', 'orphan' ])
		if (data && data[key])
			timeouts[key] = +data[key];
	let time_skew = timeouts.offline / 50 * (math.rand() % 50);
	timeouts.offline_skew = timeouts.offline + time_skew;
	ulog(LOG_INFO, 'Randomizing offline time from %d->%d \n', timeouts.offline, timeouts.offline_skew);
	
	time_skew = timeouts.orphan / 50 * (math.rand() % 50);
	timeouts.orphan_skew = timeouts.orphan + time_skew;
	ulog(LOG_INFO, 'Randomizing orphan time from %d->%d \n', timeouts.orphan, timeouts.orphan_skew);
}

function client_start() {
	ulog(LOG_INFO, '(re)starting client\n');
	system('/etc/init.d/ucentral restart');
}

function dhcp_restart() {
	ulog(LOG_INFO, 'restarting dhcp\n');
	system('killall -USR1 udhcpc');
}

function ntp_restart() {
	ulog(LOG_INFO, 'restarting ntp\n');
	system('/etc/init.d/sysntpd restart');
}

function gateway_load() {
	return readjsonfile('/etc/ucentral/gateway.json');
}

function discovery_state_write() {
	if (length(discovery_method) == 0)
		return;

	let discovery_state = {
		"type": discovery_method,
		"updated": time()
	};
	fs.writefile('/etc/ucentral/discovery.state.json', discovery_state);
}

function gateway_write(data) {
	let gateway = gateway_load();
	gateway ??= {};
	let new = {};
	let changed = false;
	for (let key in [ 'server', 'port', 'valid', 'hostname_validate', 'cert', 'ca' ]) {
		if (exists(data, key))
			new[key] = data[key];
		else if (exists(gateway, key))
			new[key] = gateway[key];
		if (new[key] != gateway[key])
			changed = true;
	}
	if (!controller_allowed(new.server, new.port))
		return false;
	if (!gateway_credentials_ready(new))
		return false;
	let pinned = pinned_gateway();
	if (pinned && (new.server != pinned.server || +new.port != +pinned.port ||
	    new.cert != pinned.cert || new.ca != pinned.ca))
		return false;
	if (changed) {
		if (!fs.writefile('/etc/ucentral/gateway.json', new))
			return false;
		if (gateway.valid && gateway_credentials_ready(gateway) && !new.valid)
			gateway_before_validation = gateway;
		system('sync');
	}
	return changed;
}

function gateway_available() {
	let gateway = gateway_load();
	return !!gateway_credentials_ready(gateway);
}

function dnsmasq_rebind_allow(fqdn) {
	let config_dir = '/tmp/dnsmasq.d';
	let config_file = `${config_dir}/cloud-discovery.conf`;

	if (!fs.stat(config_dir))
		fs.mkdir(config_dir);

	fs.writefile(config_file, `rebind-domain-ok=/${fqdn}/\n`);
	system('/etc/init.d/dnsmasq reload');
}

function set_state(set) {
	if (state == set)
		return;
	let prev = state;
	state = set;

	switch(state) {
	case DISCOVER:
		ulog(LOG_INFO, 'Setting cloud to undiscovered\n');
		fs.unlink('/tmp/cloud.json');
		// Keep the last working destination and credentials until a complete
		// replacement is ready. Discovery/EST failure is not identity removal.
		dhcp_restart();
		break;

	case VALIDATING:
		ulog(LOG_INFO, 'Wait for validation\n');
		validate_time = time();
		state = VALIDATING;
		push(discovery_block_list, discovery_method);
		break;

	case ONLINE:
		ulog(LOG_INFO, 'Connected to cloud\n');
		if (prev == VALIDATING) {
			ulog(LOG_INFO, 'Setting cloud controller to validated\n');
			gateway_write({ valid: true });
			discovery_state_write();
			discovery_block_list = [];
			gateway_before_validation = null;
		}
		break;

	case OFFLINE:
		ulog(LOG_INFO, 'Lost connection to cloud\n');
		offline_time = time();
		break;

	case ORPHAN:
		ulog(LOG_INFO, 'Device is an orphan\n');
		orphan_time = time();
		break;
	}
}

function discover_dhcp() {
	let dhcp = readjsonfile('/tmp/cloud.json');
	if (dhcp?.dhcp_policy_rejected)
		ulog(LOG_INFO, 'DHCP224 controller rejected by explicit policy; using approved fallback\n');
	if (dhcp?.dhcp_server && dhcp?.dhcp_port) {
		if (!controller_allowed(dhcp.dhcp_server, dhcp.dhcp_port) || pinned_gateway())
			return false;
		let fqdn = split(dhcp.dhcp_server, ':')[0];
		let defaults = installer_default();
		let candidate = {
			server: dhcp.dhcp_server,
			port: dhcp.dhcp_port,
			valid: false,
			hostname_validate: 1,
			cert: defaults?.cert ?? `/etc/ucentral/${fqdn}.pem`,
			ca: defaults?.ca ?? `/etc/ucentral/${fqdn}.ca`
		};
		// EST uses the DHCP hint, not gateway.json. Do not publish incomplete
		// credential paths or stop a working client before enrollment succeeds.
		fs.writefile('/tmp/discovery.method', dhcp.dhcp_source == 'policy-default' ? DISCOVER_DEFAULT : DISCOVER_DHCP);
		if ((!defaults && system('/usr/bin/est_client enroll')) || !gateway_credentials_ready(candidate))
			return false;
		if (gateway_write(candidate)) {
			dnsmasq_rebind_allow(fqdn);
			ulog(LOG_INFO, `Discovered cloud via DHCP ${dhcp.dhcp_server}:${dhcp.dhcp_port} - trying EST\n`);
			fs.writefile('/tmp/discovery.method', dhcp.dhcp_source == 'policy-default' ? DISCOVER_DEFAULT : DISCOVER_DHCP);
			ulog(LOG_INFO, `Discovered cloud via DHCP ${dhcp.dhcp_server}:${dhcp.dhcp_port} - starting client\n`);
			client_start();
			set_state(VALIDATING);
		}
		return true;
	}
	return installer_default() ? false : !dhcp?.lease;
}

function redirector_lookup() {
	if (discovery_policy() != null || pinned_gateway())
		return;
	const path = '/tmp/ucentral.redirector';
	ulog(LOG_INFO, 'Contact redirector service\n');
	let serial = uci.get('system', '@system[-1]', 'mac');

	fs.unlink(path);
	system(`curl -k --cert /etc/ucentral/operational.pem --key /etc/ucentral/key.pem --cacert /etc/ucentral/operational.ca https://${cds_server}/v1/devices/${serial} --output /tmp/ucentral.redirector`);
	if (!fs.stat(path))
		return;
	let redir = readjsonfile(path);
	if (redir?.controller_endpoint) {
		let controller_endpoint = split(redir.controller_endpoint, ':');
		if (gateway_write({
			server: controller_endpoint[0],
			port: controller_endpoint[1] || 15002,
			valid: false,
			hostname_validate: 1,
			cert: '/etc/ucentral/operational.pem',
			ca: '/etc/ucentral/operational.ca'
		})) {
			ulog(LOG_INFO, `Discovered cloud via lookup service ${controller_endpoint[0]}:${controller_endpoint[1] || 15002}\n`);
			fs.writefile('/tmp/discovery.method', DISCOVER_LOOKUP);
			client_start();
			set_state(VALIDATING);
		}
	} else {
		ulog(LOG_INFO, 'Failed to discover cloud endpoint\n');
	}
}

function discover_flash() {
	let candidate = readjsonfile('/etc/ucentral/gateway.flash');
	if (!gateway_credentials_ready(candidate))
		return 1;
	ulog(LOG_INFO, 'Using pre-populated cloud information\n');
	gateway_write(candidate);
	fs.writefile('/tmp/discovery.method', DISCOVER_FLASH);
	client_start();
	set_state(VALIDATING);
	return 0;
}

function discover_installer_default() {
	let candidate = installer_default();
	if (!candidate || pinned_gateway()) return false;
	if (gateway_write(candidate) || gateway_available()) {
		fs.writefile('/tmp/discovery.method', DISCOVER_DEFAULT);
		client_start();
		set_state(VALIDATING);
		return true;
	}
	return false;
}

function discover_standard_fqdn() {
	if (!controller_allowed(STANDARD_FQDN, STANDARD_FQDN_PORT) || pinned_gateway())
		return false;
	ulog(LOG_INFO, `Trying standard FQDN: ${STANDARD_FQDN}\n`);

	let result = query([STANDARD_FQDN], { type: ['A'] });
	if (!result || !result[STANDARD_FQDN] || !result[STANDARD_FQDN].A) {
		ulog(LOG_INFO, `Failed to resolve ${STANDARD_FQDN}\n`);
		return false;
	}

	let address = result[STANDARD_FQDN].A[0];
	ulog(LOG_INFO, `Resolved ${STANDARD_FQDN} to ${address}\n`);

	let candidate = {
		server: STANDARD_FQDN,
		port: STANDARD_FQDN_PORT,
		valid: false,
		hostname_validate: 1,
		cert: `/etc/ucentral/${STANDARD_FQDN}.pem`,
		ca: `/etc/ucentral/${STANDARD_FQDN}.ca`
	};
	if (!gateway_credentials_ready(candidate))
		return false;
	if (gateway_write(candidate)) {
		dnsmasq_rebind_allow(STANDARD_FQDN);
		ulog(LOG_INFO, `Discovered cloud via standard FQDN ${STANDARD_FQDN}\n`);
		fs.writefile('/tmp/discovery.method', DISCOVER_FQDN);
		client_start();
		set_state(VALIDATING);
		return true;
	}

	return false;
}

function time_is_valid() {
	let valid = !!fs.stat('/tmp/ntp.set');
	if (!valid)
		ntp_restart();
	ulog(LOG_INFO, `Time is ${valid ? '': 'not '}valid\n`);
	return valid;
}

function is_discover_method_blacked() {
	if (discovery_method in discovery_block_list)
		return true;

	return false;
}

function interval_handler() {
	printf(`State ${state}\n`);
	switch(state) {
	case DISCOVER:
		if (timeouts.interval < 60000)
			timeouts.interval += 10000;
		break;
	default:
		timeouts.interval = 10000;
		break;
	}

	printf('setting interval to %d\n', timeouts.interval);
	interval.set(timeouts.interval);

	switch(state) {
	case ORPHAN:
		if (time() - orphan_time <= timeouts.orphan_skew)
			break;
		orphan_time = time();
	
		/* fall through */

	case DISCOVER:
		ulog(LOG_INFO, 'Starting discover\n');

		if (!time_is_valid())
			return;

		let pinned = pinned_gateway();
		if (pinned) {
			gateway_write(pinned);
			if (ubus.call('ucentral', 'status')?.connected)
				set_state(ONLINE);
			else {
				client_start();
				set_state(VALIDATING);
			}
			return;
		}

		discovery_method = DISCOVER_DHCP;
		if (!is_discover_method_blacked() && discover_dhcp())
			return;

		discovery_method = DISCOVER_FLASH;
		if (!is_discover_method_blacked() && !discover_flash())
			return;

		discovery_method = DISCOVER_DEFAULT;
		if (discover_installer_default()) return;
		// A damaged/missing installer identity must not fall through to public EST.
		if (fs.stat('/etc/ucentral/gateway.default.json')) return;

		// A restrictive local policy never authorizes the stock public EST or
		// redirector fallback merely because its configured files are absent.
		if (discovery_policy() != null || system('/usr/bin/est_client enroll'))
			return;

		discovery_method = DISCOVER_FQDN;
		if (!is_discover_method_blacked() && discover_standard_fqdn())
			return;

		discovery_method = DISCOVER_LOOKUP;
		redirector_lookup();

		discovery_block_list = [];
		break;

	case VALIDATING:
		if (time() - validate_time <= timeouts.validate)		
			break;
		ulog(LOG_INFO, 'validation failed, restarting discovery process\n');
		if (gateway_before_validation && gateway_credentials_ready(gateway_before_validation)) {
			// A candidate timeout must not strand an already provisioned AP.
			if (!fs.writefile('/etc/ucentral/gateway.json', gateway_before_validation))
				return;
			system('sync');
			gateway_before_validation = null;
			client_start();
			set_state(OFFLINE);
			return;
		}
		set_state(DISCOVER);
		break;

	case OFFLINE:
		if (time() - offline_time <= timeouts.offline_skew)		
			break;
		ulog(LOG_INFO, 'offline for too long, setting device as orphaned\n');
		set_state(ORPHAN);
		break;
	}
}

function trigger_reenroll() {
	ulog(LOG_INFO, 'triggering reenroll\n');

	if (system('/usr/bin/est_client reenroll')) {
		ulog(LOG_INFO, 'reenroll failed\n');
		return 1;
	}
	
	ulog(LOG_INFO, 'reenroll succeeded\n');
	// Renewal changes a certificate, not controller ownership. Restart only
	// after success; never erase the working gateway or re-enter discovery.
	client_start();
	return 0;
}

function expiry_handler() {
	if (!fs.stat('/tmp/ntp.set'))
		return;
	let gateway = gateway_load();
	let cert = gateway?.cert ?? '/etc/ucentral/operational.pem';
	// Bootstrap/manual cert.pem is not an EST operational renewal candidate.
	if (cert == '/etc/ucentral/cert.pem' ||
	    !match(cert, /^\/etc\/ucentral\/[A-Za-z0-9_.-]+\.pem$/) ||
	    fs.stat(cert)?.type != 'file')
		return;
	// Parse failure is not an expiry event. Never renew on unreadable input.
	if (system(`openssl x509 -noout -in ${cert}`))
		return;
	let ret = system(`openssl x509 -checkend ${timeouts.expiry_threshold} -noout -in ${cert}`);
	if (!ret) {
		ulog(LOG_INFO, 'checked certificate expiry - all ok\n');
		return;
	}

	ulog(LOG_INFO, 'certificate will expire soon\n');
	trigger_reenroll();
}

let ubus_methods = {
	discover: {
		call: function(req) {
			set_state(DISCOVER);
			return 0;
		},
		args: {
		}
	},
	renew: {
		call: function(req) {
			let cloud = readjsonfile('/tmp/cloud.json');
			if (installer_default() && !pinned_gateway()) {
				let defaults = installer_default();
				let gateway = gateway_load();
				let server = cloud?.lease != false && cloud?.dhcp_server ? cloud.dhcp_server : defaults.server;
				let port = cloud?.lease != false && cloud?.dhcp_port ? cloud.dhcp_port : defaults.port;
				if (gateway?.server != server || +gateway?.port != +port) set_state(DISCOVER);
				return 0;
			}
			if (cloud?.lease == false) {
				// Preserve the validated gateway and credentials through a
				// carrier/DHCP outage; only the transient lease is invalid.
				if (state == ONLINE || state == VALIDATING)
					set_state(OFFLINE);
				return 0;
			}
			if (state != ONLINE)
				return;

			ulog(LOG_INFO, 'Validate cloud due to DHCP renew event\n');

			let gateway = gateway_load();
			if (!cloud?.dhcp_server || !cloud?.dhcp_port)
				return 0;

			if (cloud.dhcp_server != gateway?.server || cloud.dhcp_port != gateway?.port)
				set_state(DISCOVER);
			else
				ulog(LOG_INFO, 'Cloud has not changed\n');
		},
		args: {
		}
	},
	online: {
		call: function(req) {
			set_state(ONLINE);
			return 0;
		},
		args: {
		}
	},
	offline: {
		call: function(req) {
			if (state == ONLINE)
				set_state(OFFLINE);
			return 0;
		},
		args: {
		}
	},
	reload: {
		call: function(req) {
			timeouts_load();
			return 0;
		},
		args: {

		}
	},
	status: {
		call: function(req) {
			const names = [ 'discover', 'validate', 'online', 'offline', 'orphan' ];
			let ret = { state: names[state] };
			switch(state){
			case OFFLINE:
				ret.since = time() - offline_time;
				break;
			case ORPHAN:
				ret.since = time() - orphan_time;
				break;
			case VALIDATING:
				ret.since = time() - validate_time;;
				break;
			}
			return ret;
		},
		args: {},
	},
	reenroll: {
		call: function(req) {
			return trigger_reenroll();
		},
		args: {},
	},
};

detect_certificate_type();

if (gateway_available()) {
	let status = ubus.call('ucentral', 'status');
	ulog(LOG_INFO, 'cloud is known\n');
	if (status?.connected) {
		state = ONLINE;
	} else {
		client_start();
		set_state(VALIDATING);
	}
} else {
	dhcp_restart();
}

timeouts_load();

interval = uloop.interval(timeouts.interval, interval_handler);
uloop.interval(timeouts.expiry_interval, expiry_handler);

ubus.publish('cloud', ubus_methods);

uloop.run();
uloop.done();
