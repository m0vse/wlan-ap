#!/usr/bin/ucode

'use strict';

import { ulog_open, ulog, ULOG_SYSLOG, ULOG_STDIO, LOG_DAEMON, LOG_INFO } from 'log';
import * as fs from 'fs';
import * as libuci from 'uci';


let store_operational_pem = false;
let store_operational_ca = false;
let est_server = 'est.certificates.open-lan.org';
let cert_prefix = 'operational';
let est_server_override = getenv('EST_SERVER');
// Public endpoint/trust policy persists with the native certificate volume.
// The installer credential is a separate Root-only curl configuration.
// Normal boots may keep runtime identity in the overlay without mounting
// the native certificate volume. Enrollment settings live on that volume.
if ((ARGV[0] == 'enroll' || ARGV[0] == 'reenroll') && system(ARGV[0]=='enroll' && fs.stat('/certificates/.installer-import/transaction.json') ? 'mount_certs --installer-empty' : 'mount_certs'))
    exit(1);

let private_est = null;
if (fs.stat('/certificates/est.json')) {
    let info = fs.lstat('/certificates/est.json');
    if (info?.type != 'file' || info.uid != 0 || (info.mode & 022))
        exit(1);
    try { private_est = json(fs.readfile('/certificates/est.json')); }
    catch (e) { exit(1); }
    if (!match(private_est?.server ?? '', /^[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?$/) ||
        !match(private_est?.tls_ca ?? '', /^\/[A-Za-z0-9_./-]+$/) ||
        fs.stat(private_est.tls_ca)?.type != 'file')
        exit(1);
}


function cert_prefix_determine() {
	if (private_est) return 'operational';
	let cloud_config = fs.readfile('/tmp/cloud.json');
	if (cloud_config) {
		let cloud = json(cloud_config);
		if (cloud?.dhcp_server) {
			let fqdn = split(cloud.dhcp_server, ':')[0];
			ulog(LOG_INFO, `Using controller-specific cert prefix from cloud.json: ${fqdn}\n`);
			return fqdn;
		}
	}

	let discovery_method = trim(fs.readfile('/tmp/discovery.method') || 'OpenLAN');
	ulog(LOG_INFO, `Discovery method from file: ${discovery_method}\n`);

	if (discovery_method == 'OpenLAN') {
		ulog(LOG_INFO, 'Using operational cert prefix\n');
		return 'operational';
	}

	ulog(LOG_INFO, 'Using operational cert prefix as fallback\n');
	return 'operational';
}

function discover_est_server_via_caa() {
	let cloud_config = fs.readfile('/tmp/cloud.json');
	if (!cloud_config)
		return null;

	let cloud = json(cloud_config);
	if (!cloud || !cloud.dhcp_server)
		return null;

	let controller_fqdn = cloud.dhcp_server;
	let fqdn_parts = split(controller_fqdn, ':');
	if (length(fqdn_parts) > 0)
		controller_fqdn = fqdn_parts[0];

	ulog(LOG_INFO, `Attempting CAA lookup for controller FQDN: ${controller_fqdn}\n`);

	let pipe = fs.popen(`dig @localhost ${controller_fqdn} CAA +short | cut -d'"' -f2`);
	let est_server = pipe.read('all');
	pipe.close();

	if (!est_server)
		return null;

	est_server = trim(est_server);
	if (est_server) {
		ulog(LOG_INFO, `Found EST server via CAA: ${est_server}\n`);
		return est_server;
	}

	return null;
}

function set_est_server() {
	if (private_est) { est_server = private_est.server; return 0; }
	if (est_server_override) {
		est_server = est_server_override;
		return 0;
	}
	let discovered_server = discover_est_server_via_caa();
	if (discovered_server) {
		est_server = discovered_server;
		return 0;
	}

	ulog(LOG_INFO, 'No EST server found via CAA, using certificate issuer-based selection\n');

	let pipe = fs.popen(`openssl x509 -in /etc/ucentral/cert.pem -noout -issuer`);
	let issuer = pipe.read("all");
	if (pipe.close() || !issuer)
		return 1;

	if (match(issuer, /OpenLAN Demo Birth CA/)) {
		ulog(LOG_INFO, 'Certificate type is "Demo" \n');
		est_server = 'qaest.certificates.open-lan.org:8001';
	} else if (match(issuer, /OpenLAN Birth Issuing CA/)) {
		ulog(LOG_INFO, 'Certificate type is "Production"\n');
	} else {
		// A manually provisioned/private identity is not enrolled in public
		// OpenLAN EST. Absence of a private EST configuration is a refusal,
		// not permission to send that identity to the public default.
		ulog(LOG_INFO, 'No EST service configured for this certificate issuer\n');
		return 1;
	}
	return 0;
}

if (getenv('EST_SERVER'))
	est_server = getenv('EST_SERVER');

if (getenv('CERT_PREFIX'))
	cert_prefix = getenv('CERT_PREFIX');

ulog_open(ULOG_SYSLOG | ULOG_STDIO, LOG_DAEMON, "est_client");

function generate_csr(cert) {
    let cached = '/certificates/.installer-import/csr.pem';
    if (private_est && !cert && fs.stat('/certificates/.installer-import/transaction.json')) {
        let info = fs.lstat(cached);
        let intent_info = fs.lstat('/certificates/.installer-import/issuance-intent.json');
        if (info?.type != 'file' || info.uid != 0 || info.mode != 0600 || info.nlink != 1 ||
            intent_info?.type != 'file' || intent_info.uid != 0 || intent_info.mode != 0600 || intent_info.nlink != 1)
            return 1;
        let intent;
        try { intent = json(fs.readfile('/certificates/.installer-import/issuance-intent.json')); }
        catch (e) { return 1; }
        let hash = fs.popen(`sha256sum ${cached}`);
        let actual = split(trim(hash.read('all') || ''), ' ')[0];
        if (hash.close() || actual != intent?.csr_sha256 ||
            system(`openssl req -in ${cached} -verify -noout >/dev/null 2>&1`)) return 1;
        if (system(`umask 077; openssl req -in ${cached} -outform DER -out /tmp/csr.der`) ||
            system('umask 077; openssl base64 -A -in /tmp/csr.der -out /tmp/csr.nohdr.p10')) return 1;
        return 0;
    }
	{
        // Regenerate from the current identity; no stale temporary CSR reuse.
		let subject;
        if (private_est && !cert) {
            let serial = libuci.cursor().get('ucentral', 'config', 'serial');
            if (!match(serial ?? '', /^[0-9a-f]{12}$/)) return 1;
            subject = `subject=CN = ${serial}`;
        } else {
            let pipe = fs.popen(`openssl x509 -in ${cert} -noout -subject`);
            subject = pipe.read('all');
            if (pipe.close() || !subject) return 1;
        }
		subject = rtrim(subject);
		subject = replace(subject, 'subject=', '/');
		subject = replace(subject, ' = ', '=');
		subject = replace(subject, ', ', '/');

		let ret = system(`openssl req -subj "${subject}" -new -key /etc/ucentral/key.pem -out /tmp/csr.p10`);
		if (ret) {
			ulog(LOG_INFO, 'Failed to generate CSR\n');
			return 1;
		}

		let input = fs.open('/tmp/csr.p10', 'r');
		let output = fs.open('/tmp/csr.nohdr.p10', 'w');
		let line;
		while (line = input.read('line')) {
		        if (substr(line, 0, 4) == '----')
		                continue;
			output.write(line);
		}
		input.close();
		output.close();
		ulog(LOG_INFO, 'Generated CSR\n');
	}
	return 0;
}

function store_operational_cert(path, target) {
	if (!match(target, /^[A-Za-z0-9_.-]+\.(pem|ca)$/))
		return 1;
	let staged = `/certificates/${target}.new`;
	if (system(private_est && fs.stat('/certificates/.installer-import/transaction.json') && !fs.stat('/certificates/cert.pem') ? 'mount_certs --installer-empty' : 'mount_certs') || system(`cp ${path} ${staged} && chmod 0440 ${staged}`) ||
	    !fs.rename(staged, `/certificates/${target}`) || system('sync')) {
		ulog(LOG_INFO, `Failed to persist ${target}\n`);
		return 1;
	}

	ulog(LOG_INFO, `Persistently stored ${target}\n`);
	return 0;
}

function valid_renewal_candidate(path, previous, ca) {
	if (!match(ca ?? '', /^\/etc\/ucentral\/[A-Za-z0-9_.-]+\.(pem|ca)$/) ||
	    fs.stat(ca)?.type != 'file')
		return false;
	if (system(`openssl x509 -checkend 0 -noout -in ${path} && openssl verify -purpose sslclient -CAfile ${ca} ${path} && openssl pkey -in /etc/ucentral/key.pem -noout`))
		return false;
	let candidate = fs.popen(`openssl x509 -in ${path} -pubkey -noout | openssl pkey -pubin -outform DER | sha256sum`);
	let key = fs.popen('openssl pkey -in /etc/ucentral/key.pem -pubout -outform DER | sha256sum');
	let candidate_hash = candidate.read('all');
	let key_hash = key.read('all');
	let candidate_status = candidate.close();
	let key_status = key.close();
	if (candidate_status || key_status || !candidate_hash || candidate_hash != key_hash)
		return false;
	if (private_est && !previous) {
        let serial = libuci.cursor().get('ucentral', 'config', 'serial');
        let subject = fs.popen(`openssl x509 -in ${path} -subject -noout -nameopt RFC2253`);
        let value = trim(subject.read('all') || '');
        return !subject.close() && match(serial ?? '', /^[0-9a-f]{12}$/) && value == `subject=CN=${serial}`;
    }
    let new_subject = fs.popen(`openssl x509 -in ${path} -subject -noout -nameopt RFC2253`);
	let old_subject = fs.popen(`openssl x509 -in ${previous} -subject -noout -nameopt RFC2253`);
	let next = new_subject.read('all');
	let old = old_subject.read('all');
	let new_status = new_subject.close();
	let old_status = old_subject.close();
	return !new_status && !old_status && next && next == old;
}

function p7_too_pem(src, dst) {
	let input = fs.readfile(src);
	let output = fs.open('/tmp/convert.p7', 'w');
	output.write('-----BEGIN PKCS #7 SIGNED DATA-----\n');
	output.write(`${input}\n-----END PKCS #7 SIGNED DATA-----`);
	output.close();

	let ret = system(`openssl pkcs7 -outform PEM -print_certs -in /tmp/convert.p7 -out ${dst}`);
	if (ret) {
		ulog(LOG_INFO, 'Failed to convert P7 to PEM\n');
		return 1;
	}
	
	ulog(LOG_INFO, 'Converted P7 to PEM\n');
	
	return 0;
}

function call_est_server(path, cert, target) {
	if (generate_csr(cert))
		return 1;

	if (set_est_server())
		return 1;

	let credential = `--cert ${cert} --key /etc/ucentral/key.pem`;
    if (private_est && path == 'simpleenroll') {
        let info = fs.lstat('/certificates/est-bootstrap.conf');
        if (info?.type != 'file' || info.uid != 0 || (info.mode & 077)) return 1;
        credential = '--config /certificates/est-bootstrap.conf';
    }
    let tls_ca = private_est?.tls_ca ?? '/etc/ucentral/insta.pem';
    let curl_cmd = `curl --fail --silent --show-error -m 10 -X POST https://${est_server}/.well-known/est/${path} -d @/tmp/csr.nohdr.p10 -H 'Content-Type: application/pkcs10' ${credential} --cacert ${tls_ca} -o /tmp/operational.nohdr.p7`;
	ulog(LOG_INFO, 'Contacting configured EST service\n');
	let ret = system(curl_cmd);
	if (ret) {
		ulog(LOG_INFO, `Failed to request operational certificate (exit code: ${ret})\n`);
		return 1;
	}
	ulog(LOG_INFO, 'EST succeeded\n');

	return p7_too_pem('/tmp/operational.nohdr.p7', target);
}


function simpleenroll() {
	cert_prefix = cert_prefix_determine();
	ulog(LOG_INFO, `Checking for certificate: /etc/ucentral/${cert_prefix}.pem\n`);

	if (fs.stat('/etc/ucentral/' + cert_prefix + '.pem')) {
		ulog(LOG_INFO, 'Operational certificate is present\n');
		return 0;
	}

	ulog(LOG_INFO, 'Operational certificate not found, enrolling...\n');
	let target = private_est ? '/tmp/native-initial.pem' : '/etc/ucentral/' + cert_prefix + '.pem';
	if (call_est_server('simpleenroll', private_est ? null : '/etc/ucentral/cert.pem', target))
		return 1;

	if (private_est) {
        if (!valid_renewal_candidate(target, null, '/etc/ucentral/' + cert_prefix + '.ca') ||
            system(`cp ${target} /etc/ucentral/${cert_prefix}.pem && chmod 0440 /etc/ucentral/${cert_prefix}.pem`))
            return 1;
    }
    ulog(LOG_INFO, 'Operational cert acquired\n');
	store_operational_pem = true;
	return 0;
}

function simplereenroll() {
	let gateway = null;
	try { gateway = json(fs.readfile('/etc/ucentral/gateway.json')); }
	catch (e) {}
	// Renew the configured identity, never a transient DHCP-derived prefix.
	if (gateway?.cert) {
		if (!match(gateway.cert, /^\/etc\/ucentral\/[A-Za-z0-9][A-Za-z0-9_.-]*\.pem$/))
			return 1;
		cert_prefix = replace(replace(gateway.cert, '/etc/ucentral/', ''), /\.pem$/, '');
	} else
		cert_prefix = cert_prefix_determine();
	if (!match(cert_prefix ?? '', /^[A-Za-z0-9][A-Za-z0-9_.-]*$/) || cert_prefix == 'cert' || cert_prefix == 'key')
		return 1;

	if (!fs.stat('/etc/ucentral/' + cert_prefix + '.pem')) {
		ulog(LOG_INFO, 'Operational certificate was not found\n');
		return 1;
	}
	if (gateway?.cert && gateway.cert != '/etc/ucentral/' + cert_prefix + '.pem') {
		ulog(LOG_INFO, 'Renewal candidate is not the configured controller identity\n');
		return 1;
	}

	if (call_est_server('simplereenroll', '/etc/ucentral/' + cert_prefix + '.pem', '/tmp/' + cert_prefix + '.pem'))
		return 1;
	let current = '/etc/ucentral/' + cert_prefix + '.pem';
	let staged = '/tmp/' + cert_prefix + '.pem';
	// Client issuer trust is independent of the gateway server TLS trust.
    let issuer_ca = private_est ? '/etc/ucentral/' + cert_prefix + '.ca' :
        (gateway?.ca ?? '/etc/ucentral/' + cert_prefix + '.ca');
	if (!valid_renewal_candidate(staged, current, issuer_ca)) {
		ulog(LOG_INFO, 'Renewal candidate failed identity, expiry or trust validation\n');
		return 1;
	}

	// Prepare runtime replacement before committing the durable candidate.
	// Both replacements are individually atomic; this is not a multi-file
	// power-loss transaction. No unrelated keys/CA/gateway files are copied.
	if (system(`cp ${staged} ${current}.new && chmod 0440 ${current}.new`) ||
	    store_operational_cert(staged, cert_prefix + '.pem') ||
	    !fs.rename(current + '.new', current))
		return 1;

	ulog(LOG_INFO, 'Operational cert updated\n');
	return 0;
}

function load_operational_ca() {
	cert_prefix = cert_prefix_determine();

	if (fs.stat('/etc/ucentral/' + cert_prefix + '.ca')) {
		ulog(LOG_INFO, 'Operational CA is present\n');
		return 0;
	}

	if (set_est_server())
		return 1;

	let credential = private_est ? '' : `--cert /etc/ucentral/${cert_prefix}.pem --key /etc/ucentral/key.pem`;
    let tls_ca = private_est?.tls_ca ?? '/etc/ucentral/insta.pem';
    let curl_cmd = `curl --fail --silent --show-error -m 10 -X GET https://${est_server}/.well-known/est/cacerts ${credential} --cacert ${tls_ca} -o /tmp/${cert_prefix}.ca.nohdr.p7`;
	ulog(LOG_INFO, 'Contacting configured EST service\n');
	let ret = system(curl_cmd);
	if (!ret)
		ret = p7_too_pem('/tmp/' + cert_prefix + '.ca.nohdr.p7', '/etc/ucentral/' + cert_prefix + '.ca');
	if (ret) {
		ulog(LOG_INFO, `Failed to load CA (exit code: ${ret})\n`);
		return 1;
	}
	if (!private_est)
		system('cat /etc/ucentral/openlan.pem >> /etc/ucentral/' + cert_prefix + '.ca');
	ulog(LOG_INFO, 'Acquired CA\n');
	store_operational_ca = true;
	return 0;
}

function fwtool() {
	if (!fs.stat('/etc/ucentral/cert.pem'))
		return 0;

	let pipe = fs.popen(`openssl x509 -in /etc/ucentral/cert.pem -noout -issuer`);
	let issuer = pipe.read("all");
	pipe.close();

	if (!(match(issuer, /OpenLAN/) && match(issuer, /Birth/)))
		return 0;

	ulog(LOG_INFO, 'The issuer is insta\n');

	let metadata = fs.readfile('/tmp/sysupgrade.meta');
	if (metadata)
		metadata = json(metadata);
	if (!metadata)
		return 0;

	if (!metadata.est_supported) {
		ulog(LOG_INFO, 'The image does not support EST\n');
		return 1;
	}
	ulog(LOG_INFO, 'The image supports EST\n');

	return 0;
}

function check_cert() {
	if (!fs.stat('/etc/ucentral/cert.pem'))
		return 0;
	let pipe = fs.popen("openssl x509 -in /etc/ucentral/cert.pem  -noout -subject -nameopt multiline | grep commonName | awk '{ print $3 }'");
	let cn = pipe.read("all");
	pipe.close();
	if (!cn)
		return 0;
	cn = lc(trim(cn));
	let uci = libuci.cursor();
	let serial = uci.get('ucentral', 'config', 'serial');
	return cn != serial;
}

switch(ARGV[0]) {
case 'enroll':
	let ret = private_est ? load_operational_ca() : 0;
    if (!ret) ret = simpleenroll();
	if (!ret)
		ret = load_operational_ca();
	if (store_operational_pem)
		if (!ret)
			ret = store_operational_cert('/etc/ucentral/' + cert_prefix + '.pem', cert_prefix + '.pem');
	if (store_operational_ca)
		if (!ret)
			ret = store_operational_cert('/etc/ucentral/' + cert_prefix + '.ca', cert_prefix + '.ca');
	if (store_operational_pem || store_operational_ca)
		if (!ret)
			ret = system('store_certs');

	exit(ret);

case 'reenroll':
	if (simplereenroll())
		exit(1);
	exit(0);

case 'fwtool':
	exit(fwtool());

case 'check':
	exit(check_cert());
}
