#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Configure only an owned target on an already-UP wired interface. No NAND reads.
set -eu
[ "$#" = 5 ] || { echo 'usage: netconsole-setup DEV LOCAL_IP REMOTE_IP REMOTE_MAC REMOTE_PORT' >&2; exit 2; }
dev=$1;local_ip=$2;remote_ip=$3;remote_mac=$4;remote_port=$5
case "$dev" in up0v0) ;; *) echo 'only qualified management up0v0 supported' >&2;exit 1;; esac
[ -L /sys/class/net/up0v0/lower_up ] && [ -e /sys/class/net/up/brif/eth0 ] || { echo "miami-capture: management VLAN/bridge/eth0 path is not ready" >&2; exit 1; }
[ "$(cat /tmp/sysinfo/board_name)" = 'cambiumnetworks,x7-35x' ] || exit 1
for ip in "$local_ip" "$remote_ip"; do echo "$ip" | awk -F. 'NF!=4{exit 1}{for(i=1;i<=4;i++)if($i!~/^[0-9]+$/||$i>255)exit 1}' || exit 1;done
echo "$remote_mac" | grep -Eq '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$' || exit 1
remote_mac=$(echo "$remote_mac" | tr A-F a-f)
case "$remote_port" in ''|*[!0-9]*) exit 1;;esac
[ "$remote_port" -ge 1024 ] && [ "$remote_port" -le 65535 ] || exit 1
[ "$(cat /sys/class/net/$dev/operstate)" = up ] && [ "$(cat /sys/class/net/$dev/carrier)" = 1 ] || { echo "miami-capture: management link/carrier is not ready" >&2; exit 1; }
[ -d /sys/module/netconsole ] || modprobe netconsole
if ! grep -q ' /sys/kernel/config configfs ' /proc/mounts; then mount -t configfs configfs /sys/kernel/config;fi
base=/sys/kernel/config/netconsole/miami_failure_capture
if [ -d "$base" ]; then
 if [ "$(cat "$base/enabled")" = 1 ]; then
  [ "$(cat "$base/dev_name")" = "$dev" ] && [ "$(cat "$base/local_ip")" = "$local_ip" ] && [ "$(cat "$base/remote_ip")" = "$remote_ip" ] && [ "$(cat "$base/remote_mac")" = "$remote_mac" ] && [ "$(cat "$base/remote_port")" = "$remote_port" ] && [ "$(cat "$base/local_port")" = 6665 ] && exit 0
  echo 'owned target already enabled with different settings; explicit reconfiguration required' >&2;exit 1
 fi
else mkdir "$base";fi
# BusyBox printf may split the value and newline into separate writes under
# procd. Configfs parses each write as a whole replacement: a newline clears
# dev_name/IP and fails remote_mac. BusyBox echo buffers one complete value.
write_setting() {
 if ! echo "$2" > "$base/$1"; then
  echo "miami-capture: cannot write netconsole $1" >&2
  return 1
 fi
 actual=$(cat "$base/$1")
 [ "$actual" = "$2" ] || {
  echo "miami-capture: netconsole $1 read-back mismatch" >&2
  return 1
 }
}
write_setting dev_name "$dev"
write_setting local_ip "$local_ip"
write_setting remote_ip "$remote_ip"
write_setting remote_mac "$remote_mac"
write_setting remote_port "$remote_port"
write_setting local_port 6665
write_setting enabled 1
# Also use one write for the kernel marker; never emit partial records.
echo "<3>MIAMI_CAPTURE_HEARTBEAT boot=$(cat /proc/sys/kernel/random/boot_id) uptime=$(cut -d' ' -f1 /proc/uptime) setup=1" > /dev/kmsg
