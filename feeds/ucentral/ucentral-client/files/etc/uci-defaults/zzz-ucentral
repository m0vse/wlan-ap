#!/bin/sh

# Old managed upgrades restored config-shadow/ucentral only. Directory
# existence is not proof of a complete baseline. Retain every restored file
# (especially controller identity); fill only missing files after S10 defaults.
set -eu
uci commit
mkdir -p /etc/config-shadow
for file in /etc/config/*; do
	[ -f "$file" ] || continue
	name=${file##*/}
	[ -e "/etc/config-shadow/$name" ] || cp -p "$file" "/etc/config-shadow/$name"
done
# S18 renders before activation; never regenerate the stock LAN here.
