+/* Optional private lifecycle challenge; consumed once and never logged. */
+static bool
+private_activation_nonce(char nonce[65])
+{
+	const char *value = getenv("UCENTRAL_PRIVATE_ACTIVATION_NONCE");
+	bool valid = value && strlen(value) == 64;
+	if (valid) {
+		for (size_t i = 0; i < 64; i++) {
+			if (!((value[i] >= '0' && value[i] <= '9') ||
+			      (value[i] >= 'a' && value[i] <= 'f'))) {
+				valid = false;
+				break;
+			}
+		}
+	}
+	if (valid)
+		memcpy(nonce, value, 65);
+	else
+		nonce[0] = '\0';
+	unsetenv("UCENTRAL_PRIVATE_ACTIVATION_NONCE");
+	return valid;
+}
