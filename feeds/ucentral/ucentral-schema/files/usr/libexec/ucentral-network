#!/bin/sh
# Use the stock schema renderer before any network activation. No site VLANs.
set -eu
[ ! -e /tmp/ucentral-network.ready ] || exit 0
fail() {
	logger -t ucentral-network "$*; network remains disabled, saved JSON retained"
	# The next A/B boot loses tmpfs. Retain bounded startup diagnostics in this
	# slot, never the rendered batch or controller document (which contain keys).
	{
		printf '%s\n' "$*"
		grep '^DISTRIB_TIP=' /etc/openwrt_release
		for log in /tmp/ucentral-capabilities.log /tmp/ucentral-network.log /tmp/ucentral-uci.errors; do
			[ ! -f "$log" ] || tail -n 40 "$log"
		done
	} > /etc/ucentral/network-boot.failure 2>/dev/null || :
	exit 1
}

[ ! -e /tmp/thor-topology.failed ] || fail 'Thor pre-module topology validation failed'

# A dangling active symlink is an error, not an unconfigured device.
active=/etc/ucentral/ucentral.active
if [ -e "$active" ] || [ -L "$active" ]; then
	[ -s "$active" ] || fail 'Saved active configuration is missing or empty'
	config="$active"
	# UUID 1 is OpenWiFi's factory/bootstrap profile, not a managed config.
	if [ "$(jsonfilter -i "$active" -e '@.uuid' 2>/dev/null)" = 1 ]; then
		config=/rom/etc/ucentral/ucentral.cfg.0000000001
	fi
elif [ -e /etc/ucentral/ucentral.cfg.0000000002 ]; then
	config=/etc/ucentral/ucentral.cfg.0000000002
else
	config=/rom/etc/ucentral/ucentral.cfg.0000000001
fi

# kmodloader and wifi config have run in S10boot. Refresh capabilities using
# stock detection, without bringing any interface up. Do not cache no-radio
# capabilities on an AP while firmware loading is still completing.
tries=60
while :; do
	/sbin/wifi config || fail 'Radio configuration detection failed'
	rm -f /etc/ucentral/capabilities.json
	if ! /usr/share/ucentral/capabilities.uc > /tmp/ucentral-capabilities.log 2>&1; then
		if [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'cambiumnetworks,xv3-8' ]; then
			tries=$((tries - 1))
			[ "$tries" -gt 0 ] || fail 'Thor serving topology/chain capabilities unavailable'
			sleep 1
			continue
		fi
		fail 'Capability detection failed'
	fi
	[ "$(cat /etc/ucentral/platform 2>/dev/null)" = ap ] || break
	if [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'cambiumnetworks,x7-35x' ]; then
		/usr/libexec/miami-radio-ready && break
	else
		grep -q '"wifi"' /etc/ucentral/capabilities.json && break
	fi
	tries=$((tries - 1))
	[ "$tries" -gt 0 ] || fail 'Radio capabilities unavailable'
	sleep 1
done

[ -d /etc/config-shadow ] || fail 'Configuration baseline is missing'
for name in network system dhcp firewall dropbear ucentral; do
	[ -f "/etc/config-shadow/$name" ] || fail "Configuration baseline lacks $name"
done
# These are renderer-owned temporary staging directories, never saved JSON.
rm -rf /tmp/config-shadow /tmp/.uci-shadow
if ! /usr/bin/ucode -- /usr/share/ucentral/ucentral.uc "$config" --boot > /tmp/ucentral-network.log 2>&1; then
	fail 'Saved configuration could not be validated/rendered (see /tmp/ucentral-network.log)'
fi
[ -s /tmp/ucentral-network.ready ] || fail 'Renderer returned without a validated network'
if [ ! -e "$active" ] && [ ! -L "$active" ]; then
	ln -s "$config" "$active" || {
		rm -f /tmp/ucentral-network.ready
		fail 'Cannot record the initial active configuration'
	}
fi
logger -t ucentral-network "Rendered $config before network startup"
