+// Drivers may rename a WIPHY independently of its numeric netlink index.
+function phy_name(phy) {
+	if (type(phy.wiphy_name) == 'string' &&
+	    match(phy.wiphy_name, /^[A-Za-z0-9_-][A-Za-z0-9_.-]*$/))
+		return phy.wiphy_name;
+	return 'phy' + phy.wiphy;
+}
