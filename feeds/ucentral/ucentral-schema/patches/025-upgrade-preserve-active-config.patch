+/* The active controller document contains the management bridge/VLAN and
+ * DHCP configuration.  A managed A/B trial cannot become healthy or return
+ * to its controller without it, so preserve it independently of the UI's
+ * keep_config flag.  Unprovisioned APs have no active document and continue
+ * through the normal first-boot path. */
+let active_config = fs.readlink("/etc/ucentral/ucentral.active");
+
+if (active_config && fs.stat(active_config))
+	push(archive_cmdline, '/etc/ucentral/ucentral.active', active_config);
 
 let rc = system(archive_cmdline);
 
