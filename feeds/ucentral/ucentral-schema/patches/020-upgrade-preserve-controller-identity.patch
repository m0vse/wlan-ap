+/* A managed firmware upgrade must retain the complete rendered UCI state.
+ * The restored network and config-shadow trees are available before procd
+ * starts netifd, so bridge VLAN filtering and the management VLAN exist
+ * before DHCP.  Explicit factory reset is the supported deprovision path. */
+let files = [
+	"/etc/config", "/etc/config-shadow",
+	"/etc/ucentral/key.pem", "/etc/ucentral/cert.pem",
+	"/etc/ucentral/gateway.json", "/etc/ucentral/gateway.flash",
+	"/etc/ucentral/profile.json", "/etc/ucentral/operational.pem",
+	"/etc/ucentral/operational.ca", "/etc/ucentral/server-ca.pem",
+	"/etc/ucentral/insta.pem", "/etc/ucentral/openlan.pem",
+	"/etc/ucentral/restrictions.json", "/etc/ucentral/sign_pubkey.pem",
+];
+let gateway = {};
+
+try {
+	gateway = json(fs.readfile('/etc/ucentral/gateway.json') || '{}');
+}
+catch (e) {
+	warn(sprintf("Unable to parse gateway.json while preparing upgrade: %s\n", e));
+}
+
+/* Preserve non-default certificate names selected by gateway.json, but do
+ * not allow a controller-supplied path to add files outside /etc/ucentral. */
+for (let key in [ 'cert', 'ca' ]) {
+	let path = gateway[key];
+	if (type(path) == 'string' &&
+	    substr(path, 0, length('/etc/ucentral/')) == '/etc/ucentral/' &&
+	    index(path, '..') < 0 && fs.stat(path) && index(files, path) < 0)
+		push(files, path);
 }
 
+for (let f in files)
+	if (fs.stat(f))
+		push(archive_cmdline, f);
+
 if (args.keep_config) {
 	let active_config = fs.readlink("/etc/ucentral/ucentral.active");
 
