--- /dev/null
+++ b/renderer/wifi/mlo_capability.uc
@@ -0,0 +1,22 @@
+// Merge real GET_WIPHY dump fragments by numeric WIPHY identity.
+// EHT support and model names are not evidence of driver MLO support.
+function collect(snapshot) {
+	let by_id = {};
+	for (let phy in snapshot || []) {
+		if (!exists(phy, 'wiphy')) continue;
+		let item = by_id[phy.wiphy] ?? { supported: false };
+		if (type(phy.wiphy_name) == 'string' && length(phy.wiphy_name))
+			item.name = phy.wiphy_name;
+		if (phy.mlo_support === true)
+			item.supported = true;
+		by_id[phy.wiphy] = item;
+	}
+	let by_name = {};
+	for (let id, item in by_id) {
+		item.name ??= 'phy' + id;
+		by_name[item.name] = item;
+	}
+	return { by_id, by_name };
+}
+
+return { collect };
