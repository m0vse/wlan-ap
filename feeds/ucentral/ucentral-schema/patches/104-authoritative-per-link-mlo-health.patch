+// Read-only per-BSS MLO health. No peer inference or radio remediation.
+import * as fs from 'fs';
+function fields(text) {
+ if(type(text)!='string'||length(text)>16384)return null;
+ let out={};for(let line in split(text,'\n')){let kv=match(line,/^([^=]+)=(.*)$/);if(!kv)continue;if(exists(out,kv[1]))return null;out[kv[1]]=kv[2];}return out;
+}
+function encoded_ssid(ssid) {
+ if(type(ssid)!='string'||!length(ssid)||length(ssid)>32)return null;
+ let result='';for(let i=0;i<length(ssid);i++){let b=ord(ssid,i);
+ if(b==34)result+='\\"';else if(b==92)result+='\\\\';else if(b==27)result+='\\e';else if(b==10)result+='\\n';else if(b==13)result+='\\r';else if(b==9)result+='\\t';else if(b>=32&&b<=126)result+=substr(ssid,i,1);else result+=sprintf('\\x%02x',b);}return result;
+}
+function mac(value){return type(value)=='string'&&match(value,/^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$/)?lc(value):null;}
+function number(value){return type(value)=='string'&&match(value,/^[0-9]{1,10}$/)&&+value<=4294967295?+value:null;}
+function query(ifname,id){
+ if(!match(ifname||'',/^[A-Za-z0-9_.:-]{1,15}$/)||type(id)!='int'||id<0||id>15)return null;
+ let p=fs.popen('/usr/libexec/timeout-coreutils -s KILL 2 /usr/sbin/hostapd_cli -p /var/run/hostapd -i '+ifname+'_link'+id+' status 2>/dev/null','r');
+ if(!p)return null;let text=p.read(16385),rc=p.close();return rc==0?fields(text):null;
+}
+function phy_index(name){let text=fs.readfile('/sys/class/ieee80211/'+name+'/index');return text!=null?number(trim(text)):null;}
+function radio_phy(radio){
+ let path=replace(radio.path||'',/\+[0-9]+$/,'');if(!path)return null;
+ let names=fs.glob('/sys/devices/'+path+'/ieee80211/phy*');
