+// Initial MLO qualification: Miami, pure SAE, one enabled EHT PHY per band.
+// Disabled configurations remain independent BSSs on every platform.
+function plan(ssid, phys, operating, capab, location, parent) {
+	if (ssid.mlo !== true)
+		return null;
+	assert(capab.compatible == 'cambium_x7-35x', 'MLO is not qualified on this model');
+	assert((ssid.purpose || 'user-defined') == 'user-defined' && ssid.bss_mode == 'ap',
+	       'MLO requires a user-defined AP SSID');
+	let bands = ssid.wifi_bands || [];
+	assert(length(bands) == 2 && '5G' in bands && '6G' in bands,
+	       'MLO requires exactly the 5G and 6G bands');
+	assert(ssid.encryption?.proto == 'sae' && ssid.encryption?.ieee80211w == 'required' &&
+	       type(ssid.encryption?.key) == 'string' && length(ssid.encryption.key),
+	       'MLO requires SAE with a key and required protected management frames');
+	assert(!ssid.roaming && ssid.multi_psk !== true && !length(ssid.multi_psk || []) && !length(ssid.hostapd_bss_raw || []),
+	       'MLO does not yet support roaming, multi-PSK or raw hostapd overrides');
+	assert(!length(parent?.hostapd_bss_raw || []), 'MLO cannot inherit raw hostapd overrides');
+	assert(!('captive' in (ssid.services || [])), 'MLO captive interface naming is not yet supported');
+	assert(length(phys) == 2 && phys[0].section != phys[1].section,
+	       'MLO requires two distinct enabled operating radios');
+	let selected = {};
+	for (let phy in phys) {
+		let active = operating?.[phy.section];
+		assert(active && !active.disabled && match(active.htmode || '', /^EHT/) &&
+		       length(filter(phy.htmode || [], mode => match(mode, /^EHT/))),
+		       'MLO requires enabled EHT configuration and EHT hardware support on both radios');
+		assert(active.band in ['5g', '6g'] && !selected[active.band],
+		       'MLO requires one enabled radio in each selected band');
+		selected[active.band] = true;
+	}
+	assert(selected['5g'] && selected['6g'], 'MLO requires both operating bands');
+	// Config location is unique across networks/VLANs and stable across re-renders.
+	// Keep this short: the vendor driver may prefix it with the PHY name.
+	let index = match(location, /^\/interfaces\/([0-9]+)\/ssids\/([0-9]+)$/);
+	assert(index, 'MLO requires an unambiguous SSID configuration location');
+	let group = sprintf('ml%d_%d', +index[1], +index[2]);
+	assert(length(group) <= 8, 'MLO group identifier exceeds driver interface-name limit');
+	return { group };
+}
+
+return { plan };
