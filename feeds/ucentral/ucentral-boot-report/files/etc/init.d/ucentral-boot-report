#!/bin/sh /etc/rc.common
START=79
STOP=85
USE_PROCD=1
PROG=/usr/libexec/ucentral-boot-report

start_service() {
	"$PROG" collect || logger -t boot-report 'collection unavailable; no reboot cause assumed'
	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

shutdown() {
	# Runs before STOP90 unmount, unlike a service restart/stop.
	"$PROG" plan orderly-shutdown || logger -t boot-report 'shutdown intent could not be persisted'
	stop
}
