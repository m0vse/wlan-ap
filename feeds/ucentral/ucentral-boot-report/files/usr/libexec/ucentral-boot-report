#!/usr/bin/ucode
import * as fs from 'fs';
import { reporter } from '/usr/share/ucentral/boot_reporting.uc';
let connection;
function rpc(method, args) {
	if (!connection) connection = require('ubus').connect(null, 2);
	return connection ? connection.call('ucentral', method, args) : null;
}
function reset_cause() {
	// Only a family-reviewed root-owned hook may attribute hardware reset causes.
	let path = '/usr/libexec/ucentral-reset-cause', s = fs.lstat(path);
	if (!s || s.type != 'file' || s.uid != 0 || (s.mode & 0o022) || !(s.mode & 0o111)) return null;
	let f = fs.popen('/usr/bin/timeout 2 ' + path, 'r'); if (!f) return null;
	let text = f.read(4096), status = f.close();
	if (status != 0) return null;
	try { return json(text); } catch (e) { return null; }
}
let runtime = '/var/run/ucentral-boot-report';
let runtime_stat = fs.lstat(runtime);
if (runtime_stat && (runtime_stat.type != 'directory' || runtime_stat.uid != 0 || (runtime_stat.mode & 0o077))) die('Unsafe reporting runtime directory\n');
if (!runtime_stat && !fs.mkdir(runtime, 0o700)) die('Cannot create reporting runtime directory\n');
let app = reporter({
	directory: '/etc/ucentral/boot-reporting', state: '/etc/ucentral/boot-reporting/history.json',
	lock: runtime + '/lock', boot_id: '/proc/sys/kernel/random/boot_id',
	uptime: '/proc/uptime', version: '/etc/openwrt_release', pstore: '/sys/fs/pstore',
	radio_crash: '/etc/ucentral/radio-crash',
	cause: runtime + '/cause'
}, {
	now: () => time(), sync: () => system(['sync']), rename: (a, b) => fs.rename(a, b),
	clock_synced: function() {
		let path = runtime + '/clock-synced', s = fs.lstat(path);
		return s && s.type == 'file' && s.uid == 0 && !(s.mode & 0o077) && s.size <= 128 &&
			trim(fs.readfile(path) || '') == trim(fs.readfile('/proc/sys/kernel/random/boot_id') || '');
	},
	unlink: path => fs.unlink(path), reset_cause,
	connected: function() { let s = rpc('status', {}); return s && type(s.connected) == 'int' && s.connected >= 0 && s.boot_report_transport == 1; },
	send: function(message) { let response = rpc('send', message); return response && response.transmitted === true; }
});
let command = ARGV[0];
try {
	if (command == 'clock-sync') {
		let action = ARGV[1], stratum = ARGV[2];
		if (index(['stratum', 'periodic', 'step', 'unsync'], action) < 0) exit(0);
		let path = runtime + '/clock-synced', s = fs.lstat(path);
		if (s && (s.type != 'file' || s.uid != 0 || (s.mode & 0o077))) die('Unsafe clock marker\n');
		// step initially has stratum 16: await the subsequent valid stratum.
		// Hooks are asynchronous: a late step must not erase a newer stratum.
		if (action == 'step') exit(0);
		if (action == 'unsync' || !match(stratum || '', /^([1-9]|1[0-5])$/)) {
			if (s) fs.unlink(path);
			exit(0);
		}
		let id = trim(fs.readfile('/proc/sys/kernel/random/boot_id') || '');
		if (!match(id, /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/)) die('Invalid boot ID\n');
		let f = fs.open(path, 'w', 0o600);
		if (!f || !fs.chmod(path, 0o600)) die('Cannot mark synchronised clock\n');
		if (f.write(id) != length(id) || !f.flush() || !f.close()) die('Clock marker write failed\n');
	}
	else if (command == 'collect') app.collect();
	else if (command == 'plan') app.plan(ARGV[1]);
	else if (command == 'cancel') app.cancel(ARGV[1]);
	else if (command == 'send') app.send();
	else if (command == 'run') {
		for (;;) {
			try { app.collect(); app.send(); } catch (e) { warn(sprintf('boot-report: %s\n', e)); connection = null; }
			sleep(30000);
		}
	} else die('Usage: ucentral-boot-report collect|plan REASON|cancel REASON|send|run|clock-sync ACTION STRATUM\n');
} catch (e) { warn(sprintf('boot-report: %s\n', e)); exit(1); }
