diff --git a/package/cambium/cambium-ab/files/cambium-ab-convert b/package/cambium/cambium-ab/files/cambium-ab-convert
new file mode 100755
index 0000000000..e5109f8cd9
--- /dev/null
+++ b/package/cambium/cambium-ab/files/cambium-ab-convert
@@ -0,0 +1,124 @@
+#!/bin/sh
+# One-time Cambium A/B conversion: replace the OEM firmware in the inactive bank
+# with a copy of the running OpenWrt bank, so both banks run OpenWrt and
+# normal sysupgrade can write whichever is inactive.
+#
+# Usage: cambium-ab-convert --oem-sha256 HASH [--allow-untested] --yes
+#        cambium-ab-convert --resume --yes
+#
+#   --oem-sha256 HASH  SHA-256 of your verified off-device copy of the OEM
+#                      bank (e.g. dd if=/dev/mtdNro). The live bank must match
+#                      it exactly, proving the backup before it is erased.
+#   --allow-untested   permit a model whose A/B layout is not yet validated
+#   --resume           finish a conversion that was interrupted after the
+#                      OEM bank was erased (the backup was already proven)
+#   --yes              required; erasing the OEM bank cannot be undone here
+#
+# Before anything is erased: the board, SKU and bank layout must match, the
+# running bank must hold a valid device-data vault (filled from the OEM slot
+# at first boot), and the boot environment must already boot the running
+# bank first. The OEM image value is kept as ${AB_ENV}_ab_oem_image.
+
+. "${CAMBIUM_SYSTEM_FUNCTIONS:-/lib/functions/system.sh}"
+. "${CAMBIUM_AB_LIB:-/lib/functions/cambium-ab.sh}"
+. "${CAMBIUM_AB_UPGRADE_LIB:-/lib/upgrade/cambium-ab.sh}"
+
+die() {
+	echo "cambium-ab-convert: $*" >&2
+	logger -t cambium-ab-convert "refused: $*" 2>/dev/null
+	exit 1
+}
+
+oem_sha= allow_untested= resume= yes=
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--oem-sha256) oem_sha=$2; shift ;;
+	--allow-untested) allow_untested=1 ;;
+	--resume) resume=1 ;;
+	--yes) yes=1 ;;
+	*) die "unknown argument $1" ;;
+	esac
+	shift
+done
+[ -n "$yes" ] || die 'pass --yes to confirm erasing the OEM bank'
+
+ab_family || die 'not a Cambium image with A/B support'
+ab_identity || die 'identity or layout check failed'
+[ "$AB_LAYOUT" != pair ] ||
+	die "$AB_NAME needs no conversion: its first sysupgrade writes the other slot"
+ab_converted && die 'already converted; use sysupgrade'
+[ "$AB_QUALIFIED" = 1 ] || [ -n "$allow_untested" ] ||
+	die "$AB_MODEL has no validated A/B conversion yet (--allow-untested overrides)"
+ab_mtd_writable "$AB_TARGET_MTD" ||
+	die "bank $AB_TARGET_PART is read-only: install the A/B persistent image first"
+[ "$AB_VAULT" != 1 ] || ${AB_BOARD_DATA:-/usr/sbin/cambium-board-data} --check-vault ||
+	die 'the running bank has no valid device-data vault; check cambium-board-data first'
+
+state=$(ab_getenv ${AB_ENV}_ab_state)
+dev=${AB_DEV:-/dev}
+if [ -n "$resume" ]; then
+	case "$state" in
+	converting|convert-failed) ;;
+	*) die 'nothing to resume' ;;
+	esac
+else
+	case "$oem_sha" in
+	[0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;
+	*) die 'give the SHA-256 of your off-device OEM backup with --oem-sha256' ;;
+	esac
+	ab_ubi_for_mtd "$AB_TARGET_MTD" >/dev/null &&
+		die "bank $AB_TARGET_PART is attached; reboot first"
+	echo "Hashing the OEM bank $AB_TARGET_PART (mtd$AB_TARGET_MTD)..."
+	live=$(sha256sum < "$dev/mtd$AB_TARGET_MTD" | cut -d' ' -f1)
+	[ "$live" = "$oem_sha" ] ||
+		die "live OEM bank hash $live does not match your backup $oem_sha"
+fi
+
+# Boot environment: the running bank must come first before the OEM bank is
+# touched, so a power cut never leaves OEM bootipq pointing at a half-written
+# bank. changing_bootcmd is its own write, before bootcmd.
+if [ -z "$resume" ]; then
+	oem_image=$(ab_getenv image)
+	batch=/tmp/cambium-ab-convert.$$
+	printf "${AB_ENV}_ab_oem_image %s\n${AB_ENV}_ab_state converting\n" "${oem_image:-unset}" > "$batch"
+	ab_setenv_batch "$batch" || die 'cannot record the conversion'
+	rm -f "$batch"
+fi
+[ "$(ab_getenv changing_bootcmd)" = 1 ] || ab_setenv changing_bootcmd 1 ||
+	die 'cannot save changing_bootcmd'
+ab_write_boot_vars || die 'cannot write the boot commands'
+ab_setenv bootcmd "run ${AB_ENV}_stable$AB_ACTIVE" || die 'cannot write bootcmd'
+ab_setenv image "$AB_ACTIVE" || die 'cannot write image'
+
+fail() {
+	batch=/tmp/cambium-ab-convert.$$
+	printf "${AB_ENV}_ab_state convert-failed\n${AB_ENV}_ab_last_failure %s\n" "${AB_STEP_ERROR:-$1}" > "$batch"
+	ab_setenv_batch "$batch" >/dev/null 2>&1
+	rm -f "$batch"
+	die "$1 (slot $AB_ACTIVE still boots first; rerun with --resume)"
+}
+
+echo "Writing slot $AB_TARGET ($AB_TARGET_PART) from running slot $AB_ACTIVE..."
+src_kernel=$dev/$(ab_ubi_volume "$AB_ACTIVE_UBI" kernel)
+src_root=$dev/$(ab_ubi_volume "$AB_ACTIVE_UBI" rootfs)
+kernel_size=$(cat "${AB_UBI_SYS:-/sys/class/ubi}/${src_kernel##*/}/data_bytes")
+root_size=$(cat "${AB_UBI_SYS:-/sys/class/ubi}/${src_root##*/}/data_bytes")
+ab_prepare_bank "$kernel_size" "$root_size" || fail "cannot format slot $AB_TARGET"
+# A UBI volume's stat size is 0, so give ubiupdatevol each length.
+ab_step "ubiupdatevol kernel" ubiupdatevol -s "$kernel_size" "$dev/${AB_TARGET_UBI}_0" "$src_kernel" &&
+	ab_step "ubiupdatevol rootfs" ubiupdatevol -s "$root_size" "$dev/${AB_TARGET_UBI}_1" "$src_root" ||
+	fail "cannot write slot $AB_TARGET"
+ab_verify_volume "$dev/${AB_TARGET_UBI}_0" "$src_kernel" "$kernel_size" &&
+	ab_verify_volume "$dev/${AB_TARGET_UBI}_1" "$src_root" "$root_size" ||
+	fail "slot $AB_TARGET readback mismatch"
+[ "$AB_VAULT" != 1 ] || ab_copy_vault || fail 'cannot copy the device-data vault'
+sync
+
+# Converted: ${AB_ENV}_ab_version is written last.
+batch=/tmp/cambium-ab-convert.$$
+printf "${AB_ENV}_ab_confirmed %s\n${AB_ENV}_ab_state confirmed\n${AB_ENV}_ab_version 1\n" "$AB_ACTIVE" > "$batch"
+echo ${AB_ENV}_ab_target >> "$batch"
+ab_setenv_batch "$batch" || fail 'cannot record the finished conversion'
+rm -f "$batch"
+logger -t cambium-ab-convert "slot $AB_TARGET converted; slot $AB_ACTIVE is the default" 2>/dev/null
+echo "Converted: both banks run OpenWrt. Slot $AB_ACTIVE is the default, slot $AB_TARGET the fallback."
diff --git a/package/cambium/cambium-ab/files/cambium-ab-guard b/package/cambium/cambium-ab/files/cambium-ab-guard
new file mode 100755
--- /dev/null
+++ b/package/cambium/cambium-ab/files/cambium-ab-guard
@@ -0,0 +1,236 @@
+#!/bin/sh
+# Cambium A/B boot guard, for every family with an A/B module.
+#
+# Before conversion (one OpenWrt slot, OEM firmware in the other): after a
+# healthy start, re-arm the family's guarded one-shot that restores the OEM
+# default before booting OpenWrt again.
+#
+# After cambium-ab-convert (two OpenWrt banks): commit a trial bank as the new
+# default only after its health checks pass; if the trial fails, or did not
+# come up, record the rollback and stay on (or return to) the old bank.
+
+. "${CAMBIUM_SYSTEM_FUNCTIONS:-/lib/functions/system.sh}"
+. "${CAMBIUM_AB_LIB:-/lib/functions/cambium-ab.sh}"
+
+PAUSE=${AB_GUARD_PAUSE:-5}
+BOARD_DATA_STATUS=${CAMBIUM_BDF_STATUS:-/tmp/cambium-board-data.status}
+
+log() {
+	logger -t cambium-ab-guard "$*" 2>/dev/null
+	echo "cambium-ab-guard: $*" >&2
+}
+
+do_reboot() {
+	${AB_REBOOT:-reboot}
+}
+
+# Health of the slot this kernel runs from: its UBI device and root volume,
+# a writable overlay, wired DHCP with a default route, the family's required
+# radios and, on A/B for a family that keeps one, a valid device-data vault.
+# OpenWISP is deliberately not required.
+# The management interface to check.  OpenWiFi's renderer names upstream
+# interface sections up*, so resolve their configured device (including a
+# tagged VLAN).  network.lan is retained for stock OpenWrt configurations.
+# If neither is readable, use the current default route before falling back to
+# the family's AB_LAN candidates.
+lan_interface() {
+	local lan section
+	for section in $(uci -q show network 2>/dev/null |
+		sed -n 's/^network\.\([^.=]*\)=interface$/\1/p'); do
+		case "$section" in up*) ;; *) continue ;; esac
+		# up_none is the unaddressed parent bridge, not management DHCP.
+		[ "$(uci -q get "network.$section.proto" 2>/dev/null)" = none ] && continue
+		[ "$(uci -q get "network.$section.disabled" 2>/dev/null)" = 1 ] && continue
+		lan=$(uci -q get "network.$section.device" 2>/dev/null)
+		[ -n "$lan" ] || lan=$(uci -q get "network.$section.ifname" 2>/dev/null)
+		[ -n "$lan" ] || lan=$section
+		echo "$lan"
+		return
+	done
+	lan=$(uci -q get network.lan.device 2>/dev/null)
+	[ -n "$lan" ] && { echo "$lan"; return; }
+	lan=$(ip -4 route show default 2>/dev/null | awk '
+		$1 == "default" { for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }
+	')
+	[ -n "$lan" ] && { echo "$lan"; return; }
+	for lan in $AB_LAN; do
+		[ -d "${AB_SYS_NET:-/sys/class/net}/$lan" ] && break
+	done
+	echo "$lan"
+}
+
+# The Wi-Fi phys that count towards AB_RADIOS: all of them, or only those of
+# the device AB_RADIO_DEVICE names (the end of its /sys/devices path), so a
+# radio that is not a serving radio (the XV3-8's scanner) cannot stand in
+# for a missing one.
+radios_up() {
+	local phy n=0
+	for phy in "${AB_SYS_IEEE80211:-/sys/class/ieee80211}"/phy*; do
+		[ -e "$phy" ] || continue
+		if [ -n "${AB_RADIO_DEVICE:-}" ]; then
+			case "$(readlink -f "$phy/device" 2>/dev/null)" in
+			*/"$AB_RADIO_DEVICE") ;;
+			*) continue ;;
+			esac
+		fi
+		n=$((n + 1))
+	done
+	echo "$n"
+}
+
+unhealthy() {
+	AB_HEALTH_FAILURE="$*"
+	return 1
+}
+
+healthy() {
+	local lan radios vault
+	AB_HEALTH_FAILURE=
+	ab_identity >/dev/null 2>&1 || { unhealthy 'A/B identity check failed'; return 1; }
+	if ab_hook root_healthy; then
+		"ab_${AB_FAMILY}_root_healthy" || { unhealthy 'root/overlay is not writable and complete'; return 1; }
+	else
+		[ -e "${AB_DEV:-/dev}/ubiblock0_1" ] || { unhealthy 'root block device is missing'; return 1; }
+		grep -q ' /overlay ubifs rw' "${AB_PROC_MOUNTS:-/proc/mounts}" ||
+			{ unhealthy 'overlay is not a writable UBIFS mount'; return 1; }
+	fi
+	lan=$(lan_interface)
+	[ -n "$lan" ] || { unhealthy 'no configured management interface'; return 1; }
+	ip -4 address show dev "$lan" 2>/dev/null | grep -q 'inet ' ||
+		{ unhealthy "management interface $lan has no IPv4 address"; return 1; }
+	ip -4 route show default dev "$lan" 2>/dev/null | grep -q '^default ' ||
+		{ unhealthy "management interface $lan has no default route"; return 1; }
+	radios=$(radios_up)
+	[ "$radios" -ge "$AB_RADIOS" ] ||
+		{ unhealthy "only $radios of $AB_RADIOS required radios are present"; return 1; }
+	if [ "$1" = ab ] && [ "$AB_VAULT" = 1 ]; then
+		vault=$(cat "$BOARD_DATA_STATUS" 2>/dev/null)
+		[ "$vault" = vault ] || { unhealthy "device-data vault status is ${vault:-missing}"; return 1; }
+	fi
+	! ab_hook healthy_extra || "ab_${AB_FAMILY}_healthy_extra" ||
+		{ unhealthy "$AB_FAMILY extra health check failed"; return 1; }
+}
+
+wait_healthy() {
+	local attempt=0 tries=${AB_GUARD_TRIES:-${AB_HEALTH_TRIES:-60}}
+	while [ "$attempt" -lt "$tries" ]; do
+		healthy "$1" && return 0
+		attempt=$((attempt + 1))
+		sleep "$PAUSE"
+	done
+	return 1
+}
+
+# The validated one-OEM/one-OpenWrt guard: OpenWrt in one slot, the stock
+# firmware (U-Boot image=) in the other. After a healthy start, re-arm the
+# one-shot that restores the stock default before booting OpenWrt again.
+legacy_guard() {
+	local slot bootcmd image
+	slot=$(ab_running_slot 2>/dev/null) || return 0
+	bootcmd=$(ab_guarded_command "$slot") || return 1
+
+	if wait_healthy legacy; then
+		[ "$(ab_getenv bootcmd)" = "$AB_STOCK_BOOTCMD" ] || {
+			log 'bootcmd changed independently; leaving it alone'
+			return 1
+		}
+		# Families whose stock U-Boot has no image variable (Thor) skip this.
+		image=$(ab_getenv image)
+		[ -z "$image" ] || [ "$image" = "$((1 - slot))" ] || {
+			log "U-Boot image is not the stock firmware's slot $((1 - slot)); leaving it alone"
+			return 1
+		}
+		ab_setenv changing_bootcmd 1 || return 1
+		ab_setenv bootcmd "$bootcmd" || return 1
+		log "healthy; guarded OpenWrt boot of slot $slot rearmed"
+		return 0
+	fi
+	# The guarded one-shot restored the stock default before booting, so a
+	# reboot returns to the stock firmware. A committed OpenWrt default (a
+	# single-bank install) would only boot OpenWrt again, every few minutes.
+	[ "$(ab_getenv bootcmd)" = "$AB_STOCK_BOOTCMD" ] || {
+		log 'startup checks failed, but the default boot is not the stock firmware; not rebooting'
+		return 1
+	}
+	log 'startup checks failed; rebooting to OEM'
+	do_reboot
+}
+
+commit_trial() {
+	local slot="$1" batch=/tmp/cambium-ab-guard.$$ rc=0
+	printf "${AB_ENV}_ab_confirmed %s\n${AB_ENV}_ab_state confirmed\nimage %s\n" "$slot" "$slot" > "$batch"
+	# A committed switch supersedes any earlier failure.
+	printf "${AB_ENV}_ab_target\n${AB_ENV}_ab_last_failure\n" >> "$batch"
+	ab_setenv_batch "$batch" || rc=1
+	rm -f "$batch"
+	[ "$rc" = 0 ] && ab_setenv bootcmd "run ${AB_ENV}_stable$slot" || {
+		log "could not commit slot $slot; the old bank stays the default"
+		return 1
+	}
+	log "slot $slot healthy; it is now the default, with slot $((1 - slot)) as fallback"
+}
+
+record_rollback() {
+	local batch=/tmp/cambium-ab-guard.$$
+	printf "${AB_ENV}_ab_state rolled-back\n${AB_ENV}_ab_last_failure %s\n" "$1" > "$batch"
+	echo ${AB_ENV}_ab_target >> "$batch"
+	ab_setenv_batch "$batch"
+	rm -f "$batch"
+	log "rollback: $1"
+}
+
+ab_guard() {
+	local state target confirmed running
+	ab_identity || { log 'A/B identity check failed'; return 1; }
+	running=$AB_ACTIVE
+	state=$(ab_getenv ${AB_ENV}_ab_state)
+	target=$(ab_getenv ${AB_ENV}_ab_target)
+	confirmed=$(ab_getenv ${AB_ENV}_ab_confirmed)
+
+	case "$state" in
+	trial-started)
+		if [ "$running" != "$target" ]; then
+			record_rollback "slot $target did not boot; slot $running kept"
+			return 1
+		fi
+		if wait_healthy ab; then
+			commit_trial "$running"
+			return
+		fi
+		# bootcmd already boots the old bank first: record, then return to it.
+		record_rollback "slot $running failed: ${AB_HEALTH_FAILURE:-health checks did not pass}"
+		do_reboot
+		;;
+	armed)
+		log "slot $target is armed for a trial on the next boot"
+		;;
+	*)
+		if [ "$running" != "$confirmed" ] && [ "$state" != fallback ]; then
+			local batch=/tmp/cambium-ab-guard.$$
+			printf "${AB_ENV}_ab_state fallback\n${AB_ENV}_ab_last_failure %s\n" \
+				"confirmed slot $confirmed did not boot; running slot $running" > "$batch"
+			ab_setenv_batch "$batch"
+			rm -f "$batch"
+			log "confirmed slot $confirmed did not boot; running fallback slot $running"
+		fi
+		;;
+	esac
+}
+
+main() {
+	ab_family || return 0
+	if ab_hook takeover; then
+		"ab_${AB_FAMILY}_takeover"
+		case $? in
+		0) return 0 ;;
+		1) return 1 ;;
+		esac
+	fi
+	if ab_converted; then
+		ab_guard
+	elif [ "$AB_LAYOUT" != pair ]; then
+		legacy_guard
+	fi
+}
+
+[ -n "${AB_GUARD_SOURCE_ONLY:-}" ] || main
diff --git a/package/cambium/cambium-ab/files/cambium-ab-guard.init b/package/cambium/cambium-ab/files/cambium-ab-guard.init
