diff --git a/package/cambium/cambium-jaguar-support/files/19_cambium_openwifi_identity b/package/cambium/cambium-jaguar-support/files/19_cambium_openwifi_identity
new file mode 100644
index 0000000000..706052c96d
--- /dev/null
+++ b/package/cambium/cambium-jaguar-support/files/19_cambium_openwifi_identity
@@ -0,0 +1,23 @@
+#!/bin/sh
+
+# OpenWiFi uses its compatible string as the model identity. Keep the
+# upstream OpenWrt board names for sysupgrade and A/B qualification, but
+# expose the established Cambium model names to uCentral when it is present.
+[ -d "${UCENTRAL_DIR:=/etc/ucentral}" ] || exit 0
+
+board=${CAMBIUM_BOARD_NAME:-}
+[ -n "$board" ] || {
+	. /lib/functions/system.sh
+	board=$(board_name)
+}
+
+case "$board" in
+	cambiumnetworks,xv2-2) compatible=cambium_xv2-2 ;;
+	cambiumnetworks,xv2-2t0) compatible=cambium_xv2-2t0 ;;
+	cambiumnetworks,xv2-2t1) compatible=cambium_xv2-2t1 ;;
+	cambiumnetworks,xe3-4) compatible=cambium_xe3-4 ;;
+	cambiumnetworks,xe3-4tn) compatible=cambium_xe3-4tn ;;
+	*) exit 0 ;;
+esac
+
+printf '%s\n' "$compatible" > "$UCENTRAL_DIR/compatible"
diff --git a/package/cambium/cambium-jaguar-support/files/cambium-ab-jaguar.sh b/package/cambium/cambium-jaguar-support/files/cambium-ab-jaguar.sh
new file mode 100644
index 0000000000..e8c159b39a
--- /dev/null
+++ b/package/cambium/cambium-jaguar-support/files/cambium-ab-jaguar.sh
@@ -0,0 +1,67 @@
+#!/bin/sh
+# Cambium A/B module for the Jaguar family (IPQ6018). See cambium-ab.sh.
+#
+# Each Jaguar has two NAND firmware banks, rootfs (slot 0) and rootfs_1
+# (slot 1), whose size depends on the NAND: two 96 MiB banks on the 256 MiB
+# models (captured on the XV2-2T1, OEM 7.2-r1) and two 52 MiB banks on the
+# XV2-2's 128 MiB NAND. The identity preflight re-checks the layout on every
+# unit instead of assuming it.
+
+case " ${AB_FAMILIES:-} " in
+*" jaguar "*) ;;
+*) AB_FAMILIES="${AB_FAMILIES:+$AB_FAMILIES }jaguar" ;;
+esac
+
+ab_jaguar_board() {
+	AB_NAME=Jaguar
+	AB_ENV=jaguar
+	AB_IMAGE_DIR=sysupgrade-cambiumnetworks_jaguar
+	AB_VAULT=1
+	AB_BANK_SIZE=06000000
+	AB_SLOT1_OFFSET=0x6000000
+	AB_BANK_LEBS=724
+	AB_PROTECTED='NVRAM crashLog 0:ART'
+	# OpenWiFi normally puts the DHCP uplink on up0v0. Keep the standalone
+	# bridge names as fallbacks for recovery and diagnostic configurations.
+	AB_LAN='up0v0 eth0 br-lan.1 br-lan'
+	case "$1" in
+	cambiumnetworks,xv2-2)
+		# 128 MiB Winbond NAND: 416-PEB banks, 20 reserved + 4.
+		AB_MODEL=XV2-2; AB_SKU=00000014; AB_FIT=config@cp01-c1; AB_QUALIFIED=1
+		AB_BANK_SIZE=03400000
+		AB_SLOT1_OFFSET=0x3400000
+		AB_BANK_LEBS=392
+		AB_PROTECTED='0:NVRAM crashlog 0:ART'
+		;;
+	cambiumnetworks,xv2-2t0) AB_MODEL=XV2-2T0; AB_SKU=00000016; AB_FIT=config@cp01-c1-1 ;;
+	cambiumnetworks,xv2-2t1) AB_MODEL=XV2-2T1; AB_SKU=0000001f; AB_FIT=config@cp01-c1-2; AB_QUALIFIED=1 ;;
+	cambiumnetworks,xe3-4) AB_MODEL=XE3-4; AB_SKU=00000020; AB_FIT=config@cp01-c3-xv3-4; AB_QUALIFIED=1 ;;
+	cambiumnetworks,xe3-4tn) AB_MODEL=XE3-4TN; AB_SKU=00000021; AB_FIT=config@cp01-c3-2 ;;
+	*) return 1 ;;
+	esac
+}
+
+# Boot slot $1: the validated slot-0 guard command apart from the bank.
+ab_jaguar_boot_command() {
+	local part offset
+	case "$1" in
+	0) part=rootfs; offset=0x0 ;;
+	1) part=rootfs_1; offset=$AB_SLOT1_OFFSET ;;
+	*) echo "cambium-ab: invalid slot $1" >&2; return 1 ;;
+	esac
+	printf 'nand device 0 && setenv mtdids nand0=nand0 && setenv mtdparts "mtdparts=nand0:%s@%s(fs)" && ubi part fs && ubi read 0x60000000 kernel && setenv bootargs "console=ttyMSM0,115200n8 cnss2.bdf_pci0=0xab ubi.mtd=%s root=/dev/ubiblock0_1 rootfstype=squashfs rootwait swiotlb=1" && bootm 0x60000000#%s\n' \
+		"$(ab_bank_hex)" "$offset" "$part" "$AB_FIT"
+}
+
+# One-OEM/one-OpenWrt guarded boot of OpenWrt slot $1. Slot 0 is the command
+# validated on the XV2-2T1; slot 1 uses the "(fs)" / "ubi part fs" form that
+# booted the XV2-2 from its slot 1.
+ab_jaguar_guarded_command() {
+	local mtdparts part
+	case "$1" in
+	0) mtdparts="$(ab_bank_hex)@0x0(rootfs)"; part=rootfs ;;
+	1) mtdparts="$(ab_bank_hex)@$AB_SLOT1_OFFSET(fs)"; part=fs ;;
+	*) echo "cambium-ab: invalid slot $1" >&2; return 1 ;;
+	esac
+	echo "setenv bootcmd bootipq; setenv changing_bootcmd; saveenv; nand device 0 && setenv mtdids nand0=nand0 && setenv mtdparts \"mtdparts=nand0:$mtdparts\" && ubi part $part && ubi read 0x60000000 kernel && setenv bootargs \"console=ttyMSM0,115200n8 cnss2.bdf_pci0=0xab ubi.mtd=$(ab_bank_name "$1") root=/dev/ubiblock0_1 rootfstype=squashfs rootwait swiotlb=1\" && bootm 0x60000000#$AB_FIT; reset"
+}
diff --git a/scripts/cambium-family-its.sh b/scripts/cambium-family-its.sh
new file mode 100755
index 0000000000..e9c3387fb1
--- /dev/null
+++ b/scripts/cambium-family-its.sh
@@ -0,0 +1,104 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Write a FIT image source holding one kernel and several board device trees.
+# Cambium's OEM U-Boot boots a named configuration (for example config@5 or
+# config@hk02), so each board keeps the configuration name used by the OEM
+# family image. Several configurations may share one device tree.
+#
+# Usage: cambium-family-its.sh -k KERNEL -A ARCH -C COMP -a LOAD -e ENTRY \
+#          -d DESCRIPTION [-D DEFAULT] CONFIG:FDT:DTB...
+# DEFAULT names the default configuration; it defaults to the first CONFIG.
+
+set -eu
+
+usage() {
+	echo "Usage: $0 -k kernel -A arch -C compression -a load -e entry -d description [-D default] config:fdt:dtb..." >&2
+	exit 2
+}
+
+kernel= arch= comp= load= entry= desc= default=
+while getopts "k:A:C:a:e:d:D:" opt; do
+	case "$opt" in
+	k) kernel=$OPTARG ;;
+	A) arch=$OPTARG ;;
+	C) comp=$OPTARG ;;
+	a) load=$OPTARG ;;
+	e) entry=$OPTARG ;;
+	d) desc=$OPTARG ;;
+	D) default=${OPTARG#config@} ;;
+	*) usage ;;
+	esac
+done
+shift $((OPTIND - 1))
+[ -n "$kernel" ] && [ -n "$arch" ] && [ -n "$comp" ] && [ -n "$load" ] && [ "$#" -gt 0 ] || usage
+[ -n "$entry" ] || entry=$load
+[ -n "$default" ] || default=$(echo "$1" | cut -d: -f1)
+[ -s "$kernel" ] || { echo "$0: missing kernel $kernel" >&2; exit 1; }
+
+hashes='      hash@1 { algo = "crc32"; };
+      hash@2 { algo = "sha1"; };'
+
+cat <<EOF
+/dts-v1/;
+
+/ {
+  description = "$desc";
+  #address-cells = <1>;
+
+  images {
+    kernel@1 {
+      description = "$desc kernel";
+      data = /incbin/("$kernel");
+      type = "kernel";
+      arch = "$arch";
+      os = "linux";
+      compression = "$comp";
+      load = <$load>;
+      entry = <$entry>;
+$hashes
+    };
+EOF
+
+seen=' '
+for board in "$@"; do
+	fdt=$(echo "$board" | cut -d: -f2)
+	dtb=$(echo "$board" | cut -d: -f3-)
+	case "$seen" in *" $fdt "*) continue ;; esac
+	seen="$seen$fdt "
+	[ -s "$dtb" ] || { echo "$0: missing device tree $dtb" >&2; exit 1; }
+	cat <<EOF
+    fdt@$fdt {
+      description = "${dtb##*/}";
+      data = /incbin/("$dtb");
+      type = "flat_dt";
+      arch = "$arch";
+      compression = "none";
+$hashes
+    };
+EOF
+done
+
+cat <<EOF
+  };
+
+  configurations {
+    default = "config@$default";
+EOF
+
+for board in "$@"; do
+	config=$(echo "$board" | cut -d: -f1)
+	fdt=$(echo "$board" | cut -d: -f2)
+	cat <<EOF
+    config@$config {
+      description = "$desc ($config)";
+      kernel = "kernel@1";
+      fdt = "fdt@$fdt";
+    };
+EOF
+done
+
+cat <<EOF
+  };
+};
+EOF
diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-jaguar-controls.dtsi b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-jaguar-controls.dtsi
new file mode 100644
index 0000000000..a567841d47
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-jaguar-controls.dtsi
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: (GPL-2.0+)
+
+/*
+ * All five Jaguar OEM 7.2 FIT trees use GPIO19 for the sole physical
+ * button and list status GPIOs 73, 56, 37 and 35 in the same order.
+ * OEM calls the key WPS; on the XV2-2T1 enclosure it is the reset button.
+ * Physical XV2-2T1 test established the four colours and active-high GPIO
+ * drive (the original XE3-4 active-low assumption illuminated at brightness
+ * zero). Other family models retain this best-effort mapping until checked.
+ * GPIO50 is the OEM USB indicator.
+ */
+&tlmm {
+	jaguar_reset_button_pins: jaguar-reset-button-pins {
+		pins = "gpio19";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+};
+
+&{/keys} {
+	pinctrl-0 = <&jaguar_reset_button_pins>;
+	pinctrl-names = "default";
+
+	reset {
+		debounce-interval = <60>;
+	};
+};
+
+/* Match the established E410/XV3-8 OpenWrt status sequence. */
+&{/aliases} {
+	led-boot = &jaguar_led_orange;
+	led-failsafe = &jaguar_led_red;
+	led-running = &led_status_white;
+	led-upgrade = &jaguar_led_orange;
+};
+
+&led_status_white {
+	/delete-property/ color;
+	label = "jaguar:status:green";
+	gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
+	default-state = "off";
+};
+
+&led_status_amber {
+	/delete-property/ color;
+	label = "jaguar:status:blue";
+	gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
+	default-state = "off";
+};
+
+&{/leds} {
+	jaguar_led_red: status-gpio73 {
+		label = "jaguar:status:red";
+		gpios = <&tlmm 73 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+
+	jaguar_led_orange: status-gpio37 {
+		label = "jaguar:status:orange";
+		gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+	};
+
+	usb {
+		label = "jaguar:usb";
+		gpios = <&tlmm 50 GPIO_ACTIVE_HIGH>;
+		linux,default-trigger = "usb-host";
+		default-state = "off";
+	};
+};
diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-jaguar-persistent-96m.dtsi b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-jaguar-persistent-96m.dtsi
new file mode 100644
index 0000000000..a59748f28e
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-jaguar-persistent-96m.dtsi
@@ -0,0 +1,6 @@
+// SPDX-License-Identifier: (GPL-2.0+)
+
+/* Second 96 MiB firmware bank of the 256 MiB NAND models (XV2-2T1 layout). */
+&{/soc@0/nand-controller@79b0000/nand@0/partitions/partition@6000000} {
+	/delete-property/ read-only;
+};
diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-jaguar-persistent.dtsi b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-jaguar-persistent.dtsi
new file mode 100644
index 0000000000..707167aa4f
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-jaguar-persistent.dtsi
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: (GPL-2.0+)
+
+/*
+ * A/B: U-Boot's boot command selects the bank with ubi.mtd=rootfs or
+ * ubi.mtd=rootfs_1, so no root arguments are appended here. This makes
+ * bank 0 and the U-Boot environment (for the boot guard) writable; each
+ * model's persistent tree unlocks its own second bank, whose offset depends
+ * on the NAND size. ART, NVRAM, crashLog and every other NOR partition stay
+ * read-only.
+ */
+&{/soc@0/nand-controller@79b0000/nand@0/partitions/partition@0} {
+	/delete-property/ read-only;
+};
+
+&{/soc@0/spi@78b5000/flash@0/partitions/partition@6f0000} {
+	/delete-property/ read-only;
+};
diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-jaguar-storage-recovery.dtsi b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-jaguar-storage-recovery.dtsi
new file mode 100644
index 0000000000..f54757a132
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-jaguar-storage-recovery.dtsi
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: (GPL-2.0+)
+
+/*
+ * OEM 7.2-r1 XV2-2T1 running NOR/NAND layout. Sibling running layouts are
+ * still provisional: OEM FIT DTBs omit the bootloader-added partition map.
+ * No initial recovery write targets.
+ */
+&blsp1_spi1 {
+	flash@0 {
+		partitions {
+			partition@510000 {
+				label = "oldappsblenv";
+				read-only;
+				/delete-node/ nvmem-layout;
+			};
+
+			partition@6e0000 {
+				label = "0:DEVCFG_1";
+				reg = <0x6e0000 0x10000>;
+				read-only;
+			};
+
+			partition@6f0000 {
+				label = "0:APPSBLENV";
+				reg = <0x6f0000 0x10000>;
+				read-only;
+				nvmem-layout {
+					compatible = "u-boot,env";
+					ethaddr: ethaddr { #nvmem-cell-cells = <0>; };
+					eth1addr: eth1addr { #nvmem-cell-cells = <0>; };
+					eth2addr: eth2addr { #nvmem-cell-cells = <0>; };
+					eth5addr: eth5addr { #nvmem-cell-cells = <0>; };
+				};
+			};
+
+			partition@700000 {
+				label = "config";
+				reg = <0x700000 0x10000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&qpic_nand {
+	/* RAM diagnostic: OEM 7.2 reports ECC strength 8 in MTD sysfs. */
+	compatible = "qcom,ipq6018-nand";
+	nand@0 {
+		nand-ecc-strength = <8>;
+		partitions {
+			partition@0 { read-only; };
+			partition@6000000 { read-only; };
+			partition@c000000 { read-only; };
+			partition@f000000 { read-only; };
+		};
+	};
+};
