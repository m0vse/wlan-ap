diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-xv2-2t1-persistent.dts b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6010-xv2-2t1-persistent.dts
