@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/*
+ * Thor A/B persistent tree for bank 0 (config@hk02): both 96 MiB firmware
+ * banks and the U-Boot environment are writable, and the root is appended
+ * here, as on the validated single-bank installs, so their committed boot
+ * command keeps working. ipq8074-xv3-8-persistent-bank1.dts is the same tree
+ * rooted in bank 1. It includes the QCA9887 scanning radio and the
+ * auxiliary 1 GbE port. ART, 0:ETHPHYFW and the other NOR partitions stay
+ * read-only.
+ */
+#include "ipq8074-xv3-8-installer.dts"
+#include "ipq8074-xv3-8-scan-radio.dtsi"
+/* Auxiliary port enabled in the kernel-6.12 base tree. */
+
+&rootfs_1 {
+	/delete-property/ read-only;
+};
diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8074-xv3-8-scan-radio.dtsi b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8074-xv3-8-scan-radio.dtsi
new file mode 100644
index 0000000000..acfb00812e
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8074-xv3-8-scan-radio.dtsi
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/*
+ * The XV3-8's dedicated scanning radio: a QCA9887-class ath10k device
+ * (168c:0050) on PCIe 1, as the stock firmware sets it up (PCIe domain 1,
+ * PERST# on GPIO61). It serves no clients. Its calibration and MAC are the
+ * 0x844-byte block at ART offset 0x33000, read in place.
+ */
+
+&pcie_qmp1 {
+	status = "okay";
+};
+
+&pcie1 {
+	status = "okay";
+
+	perst-gpios = <&tlmm 61 GPIO_ACTIVE_LOW>;
+
+	pcie@0 {
+		scan_radio: wifi@0,0 {
+			status = "okay";
+
+			compatible = "qcom,ath10k";
+			reg = <0x00010000 0 0 0 0>;
+
+			nvmem-cell-names = "calibration";
+			nvmem-cells = <&caldata_qca9887>;
+		};
+	};
+};
diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8074-xv3-8.dts b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8074-xv3-8.dts
new file mode 100644
index 0000000000..d568b5862d
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8074-xv3-8.dts
@@ -0,0 +1,386 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/dts-v1/;
+
+#include "ipq8074.dtsi"
+#include "ipq8074-hk-cpu.dtsi"
+#include "ipq8074-ess.dtsi"
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "Cambium Networks XV3-8";
+	compatible = "cambiumnetworks,xv3-8", "qcom,ipq8074";
+
+	aliases {
+		serial0 = &blsp1_uart5;
+		ethernet0 = &dp6_syn;
+		label-mac-device = &dp6_syn;
+		led-boot = &led_orange;
+		led-failsafe = &led_red;
+		led-running = &led_green;
+		led-upgrade = &led_orange;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	cambium-platform {
+		board-sku = <19>;
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "reset";
+			gpios = <&tlmm 57 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+			debounce-interval = <60>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_orange: led-orange {
+			color = <LED_COLOR_ID_ORANGE>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		led_green: led-green {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&tlmm 28 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		led_red: led-red {
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		led_blue: led-blue {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+};
+
+&blsp1_uart5 {
+	status = "okay";
+};
+
+&blsp1_spi1 {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "0:SBL1";
+				reg = <0x000000 0x050000>;
+				read-only;
+			};
+
+			partition@50000 {
+				label = "0:MIBIB";
+				reg = <0x050000 0x010000>;
+				read-only;
+			};
+
+			partition@60000 {
+				label = "0:BOOTCONFIG";
+				reg = <0x060000 0x020000>;
+				read-only;
+			};
+
+			partition@80000 {
+				label = "0:BOOTCONFIG1";
+				reg = <0x080000 0x020000>;
+				read-only;
+			};
+
+			partition@a0000 {
+				label = "0:QSEE";
+				reg = <0x0a0000 0x180000>;
+				read-only;
+			};
+
+			partition@220000 {
+				label = "0:QSEE_1";
+				reg = <0x220000 0x180000>;
+				read-only;
+			};
+
+			partition@3a0000 {
+				label = "0:DEVCFG";
+				reg = <0x3a0000 0x010000>;
+				read-only;
+			};
+
+			partition@3b0000 {
+				label = "0:DEVCFG_1";
+				reg = <0x3b0000 0x010000>;
+				read-only;
+			};
+
+			partition@3c0000 {
+				label = "0:APDP";
+				reg = <0x3c0000 0x010000>;
+				read-only;
+			};
+
+			partition@3d0000 {
+				label = "mfginfo";
+				reg = <0x3d0000 0x010000>;
+				read-only;
+			};
+
+			partition@3e0000 {
+				label = "0:RPM";
+				reg = <0x3e0000 0x040000>;
+				read-only;
+			};
+
+			partition@420000 {
+				label = "0:RPM_1";
+				reg = <0x420000 0x040000>;
+				read-only;
+			};
+
+			partition@460000 {
+				label = "0:CDT";
+				reg = <0x460000 0x010000>;
+				read-only;
+			};
+
+			partition@470000 {
+				label = "0:CDT_1";
+				reg = <0x470000 0x010000>;
+				read-only;
+			};
+
+			partition@480000 {
+				label = "oldappsblenv";
+				reg = <0x480000 0x010000>;
+				read-only;
+			};
+
+			partition@490000 {
+				label = "0:APPSBL";
+				reg = <0x490000 0x0a0000>;
+				read-only;
+			};
+
+			partition@530000 {
+				label = "0:APPSBL_1";
+				reg = <0x530000 0x0a0000>;
+				read-only;
+			};
+
+			art: partition@5d0000 {
+				label = "0:ART";
+				reg = <0x5d0000 0x040000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					macaddr_base: mac-address@40 {
+						compatible = "mac-base";
+						reg = <0x40 0x6>;
+						#nvmem-cell-cells = <1>;
+					};
+
+					/* The PCIe QCA9887 scanning radio's calibration and MAC. */
+					caldata_qca9887: calibration@33000 {
+						reg = <0x33000 0x844>;
+					};
+				};
+			};
+
+			ethphyfw: partition@610000 {
+				label = "0:ETHPHYFW";
+				reg = <0x610000 0x080000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					/* Skip the 40-byte Qualcomm MBN header. */
+					aqr_fw: firmware@28 {
+						reg = <0x28 0x4c002>;
+					};
+				};
+			};
+
+			partition@690000 {
+				label = "0:APDP_1";
+				reg = <0x690000 0x010000>;
+				read-only;
+			};
+
+			appsblenv: partition@6a0000 {
+				label = "0:APPSBLENV";
+				reg = <0x6a0000 0x010000>;
+				read-only;
+			};
+
+			partition@6b0000 {
+				label = "config";
+				reg = <0x6b0000 0x950000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&qpic_bam {
+	status = "okay";
+};
+
+&qpic_nand {
+	status = "okay";
+
+	nand@0 {
+		reg = <0>;
+		nand-ecc-strength = <4>;
+		nand-ecc-step-size = <512>;
+		nand-bus-width = <8>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			rootfs: partition@0 {
+				label = "rootfs";
+				reg = <0x0000000 0x6000000>;
+				read-only;
+			};
+
+			rootfs_1: partition@6000000 {
+				label = "rootfs_1";
+				reg = <0x6000000 0x6000000>;
+				read-only;
+			};
+
+			partition@c000000 {
+				label = "0:NVRAM";
+				reg = <0xc000000 0x3000000>;
+				read-only;
+			};
+
+			partition@f000000 {
+				label = "crashLog";
+				reg = <0xf000000 0x1000000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&edma {
+	status = "okay";
+};
+
+/* Kernel 6.12 uses qca-ssdk/qca-nss-dp instead of the 6.18 DSA bindings. */
+&switch {
+ status = "okay";
+ switch_lan_bmp = <(ESS_PORT4 | ESS_PORT6)>;
+ switch_mac_mode = <MAC_MODE_PSGMII>;
+ switch_mac_mode2 = <MAC_MODE_USXGMII>;
+ qcom,port_phyinfo {
+  port@4 { port_id = <4>; phy_address = <3>; };
+  port@6 {
+   port_id = <6>;
+   phy_address = <8>;
+   /* SSDK parses this node independently of the Linux MDIO PHY node. */
+   ethernet-phy-ieee802.3-c45;
+   port_mac_sel = "QGMAC_PORT";
+  };
+ };
+};
+&dp4 {
+ status = "okay";
+ phy-handle = <&qca8075_3>;
+ label = "lan";
+ nvmem-cells = <&macaddr_base 0>;
+ nvmem-cell-names = "mac-address";
+};
+&dp6_syn {
+ status = "okay";
+ phy-handle = <&aqr_phy>;
+ phy-mode = "usxgmii";
+ label = "lan-multigig";
+ nvmem-cells = <&macaddr_base 1>;
+ nvmem-cell-names = "mac-address";
+};
+
+&tlmm {
+	mdio_pins: mdio-pins {
+		mdc {
+			pins = "gpio68";
+			function = "mdc";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+
+		mdio {
+			pins = "gpio69";
+			function = "mdio";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+};
+
+&mdio {
+	status = "okay";
+	pinctrl-0 = <&mdio_pins>;
+	pinctrl-names = "default";
+
+	qca8075_package: ethernet-phy-package@0 {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		compatible = "qcom,qca8075-package";
+		reg = <0>;
+
+		qca8075_3: ethernet-phy@3 {
+			compatible = "ethernet-phy-ieee802.3-c22";
+			reg = <3>;
+		};
+	};
+
+	aqr_phy: ethernet-phy@8 {
+		compatible = "ethernet-phy-ieee802.3-c45";
+		reg = <8>;
+		nvmem-cells = <&aqr_fw>;
+		nvmem-cell-names = "firmware";
+	};
+
+};
+
+&wifi {
+	status = "okay";
+};
diff --git a/target/linux/qualcommax/image/ipq807x.mk b/target/linux/qualcommax/image/ipq807x.mk
index f356bbbca5..bbbd13438b 100644
--- a/target/linux/qualcommax/image/ipq807x.mk
+++ b/target/linux/qualcommax/image/ipq807x.mk
@@ -564,3 +564,72 @@ define Device/zyxel_nwa210ax
 	IMAGE/factory.bin := append-ubi | check-size $$$$(IMAGE_SIZE) | zyxel-nwa210ax-fit
 endef
 TARGET_DEVICES += zyxel_nwa210ax
+
+define Device/cambiumnetworks_thor-persistent
+	$(call Device/FitImage)
+	$(call Device/UbiFit)
+	# Thor U-Boot 2016.01 on this unit loads an uncompressed FIT reliably.
+	# One configuration per firmware bank: config@hk02 is rooted in rootfs
+	# (bank 0, as the single-bank installs expect) and config@hk02-bank1 in
+	# rootfs_1.
+	KERNEL = kernel-bin | cambium-family-fit none
+	CAMBIUM_FIT_BOARDS := hk02:hk02:ipq8074-xv3-8-persistent \
+		hk02-bank1:hk02-bank1:ipq8074-xv3-8-persistent-bank1
+	DEVICE_VENDOR := Cambium Networks
+	DEVICE_MODEL := Thor family
+	DEVICE_VARIANT := persistent
+	BLOCKSIZE := 128k
+	PAGESIZE := 2048
+	DEVICE_DTS := ipq8074-xv3-8-persistent ipq8074-xv3-8-persistent-bank1
+	DEVICE_DTS_CONFIG := config@hk02
+	# XV3-8 only: the XE5-8 flash layout has not been captured yet.
+	SUPPORTED_DEVICES := cambiumnetworks,xv3-8
+	# Keep the sysupgrade layout the installed XV3-8 images expect.
+	BOARD_NAME := cambiumnetworks_xv3-8
+	SOC := ipq8074
+	IMAGE_SIZE := 98304k
+	# A/B banks: kernel (0), rootfs (1), rootfs_data (2) and the per-bank
+	# device-data vault (3); the cambium-ab sysupgrade writes the inactive one.
+	IMAGES := factory.ubi sysupgrade.bin
+	IMAGE/factory.ubi := cambium-ab-ubi
+	IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
+	# The QCA9887 scanning radio (PCIe 1) needs ath10k and its firmware.
+	DEVICE_PACKAGES := uboot-envtools cambium-board-data cambium-thor-support \
+		kmod-ath10k-ct ath10k-firmware-qca9887-ct
+endef
+TARGET_DEVICES += cambiumnetworks_thor-persistent
+# RAM installer for a stock firmware without ubiformat: only rootfs and the
+# U-Boot environment are writable, so it can write the factory image into
+# rootfs and arm its guarded first boot.
+define Device/cambiumnetworks_thor-installer
+	$(call Device/FitImage)
+	KERNEL = kernel-bin | fit none $$(KDIR)/image-$$(DEVICE_DTS).dtb
+	DEVICE_VENDOR := Cambium Networks
+	DEVICE_MODEL := Thor family
+	DEVICE_VARIANT := RAM installer
+	BLOCKSIZE := 128k
+	PAGESIZE := 2048
+	DEVICE_DTS := ipq8074-xv3-8-installer
+	DEVICE_DTS_CONFIG := config@hk02
+	SUPPORTED_DEVICES := cambiumnetworks,xv3-8
+	SOC := ipq8074
+	IMAGES :=
+	DEVICE_PACKAGES := cambium-board-data ubi-utils uboot-envtools cambium-thor-support
+endef
+TARGET_DEVICES += cambiumnetworks_thor-installer
+
+# Read-only RAM recovery for the qualified XV3-8 only.
+define Device/cambiumnetworks_thor-recovery
+	$(call Device/FitImage)
+	DEVICE_VENDOR := Cambium Networks
+	DEVICE_MODEL := XV3-8 RAM recovery
+	DEVICE_DTS := ipq8074-xv3-8
+	DEVICE_DTS_CONFIG := config@hk02
+	KERNEL = kernel-bin | cambium-family-fit none
+	CAMBIUM_FIT_BOARDS := hk02:hk02:ipq8074-xv3-8
+	SUPPORTED_DEVICES := cambiumnetworks,xv3-8
+	SOC := ipq8074
+	IMAGES :=
+	DEVICE_PACKAGES := cambium-board-data cambium-thor-support
+endef
+TARGET_DEVICES += cambiumnetworks_thor-recovery
