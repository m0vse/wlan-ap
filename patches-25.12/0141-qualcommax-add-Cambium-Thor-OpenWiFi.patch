diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8074-xv3-8-persistent.dts b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8074-xv3-8-persistent.dts
