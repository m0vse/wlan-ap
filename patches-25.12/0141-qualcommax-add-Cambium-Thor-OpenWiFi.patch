@@ -0,0 +1,45 @@
+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=cambium-rrm-agent
+PKG_RELEASE:=11
+PKG_LICENSE:=GPL-2.0-only
+PKG_MAINTAINER:=Phil Taylor <phil@m0vse.uk>
+
+include $(INCLUDE_DIR)/package.mk
+
+define Package/cambium-rrm-agent
+  SECTION:=utils
+  CATEGORY:=Utilities
+  TITLE:=Cambium access point radio measurements
+  DEPENDS:=+iw
+  PKGARCH:=all
+endef
+
+define Package/cambium-rrm-agent/description
+  Measures what the radio resource planner needs on every Cambium family:
+  each radio's channel, busy time, noise and clients, and the networks heard
+  by the family's dedicated scanning radio where it has one (the XV3-8's).
+  The latest measurement is kept as JSON in /tmp/cambium-rrm/latest.json
+  and included in OpenWiFi vendor telemetry.
+  A dedicated scanning radio is kept in the Wi-Fi configuration as a
+  disabled radio named "scan", so it never serves clients.
+endef
+
+define Package/cambium-rrm-agent/conffiles
+/etc/config/cambium_rrm
+endef
+
+define Build/Compile
+endef
+
+define Package/cambium-rrm-agent/install
+	$(INSTALL_DIR) $(1)/usr/sbin $(1)/etc/init.d $(1)/etc/config $(1)/etc/hotplug.d/ieee80211 \
+		$(1)/lib/functions
+	$(INSTALL_BIN) ./files/cambium-rrm-agent $(1)/usr/sbin/
+	$(INSTALL_DATA) ./files/cambium-rrm.sh $(1)/lib/functions/cambium-rrm.sh
+	$(INSTALL_BIN) ./files/cambium-rrm-agent.init $(1)/etc/init.d/cambium-rrm-agent
+	$(INSTALL_CONF) ./files/cambium_rrm.config $(1)/etc/config/cambium_rrm
+	$(INSTALL_DATA) ./files/20-cambium-scan-radio $(1)/etc/hotplug.d/ieee80211/
+endef
+
+$(eval $(call BuildPackage,cambium-rrm-agent))
diff --git a/package/cambium/cambium-rrm-agent/files/20-cambium-scan-radio b/package/cambium/cambium-rrm-agent/files/20-cambium-scan-radio
new file mode 100644
index 0000000000..82f89a2154
--- /dev/null
+++ b/package/cambium/cambium-rrm-agent/files/20-cambium-scan-radio
@@ -0,0 +1,44 @@
+#!/bin/sh
+# Keep the family's dedicated scanning radio out of service: OpenWrt's
+# wifi-detect (10-wifi-detect) adds every radio it finds to
+# /etc/config/wireless, on every boot. Give the scanning radio one disabled
+# section named "scan" with no networks, so wifi-detect leaves it alone and
+# netifd never starts anything on it.
+
+[ "$ACTION" = add ] || exit 0
+. "${CAMBIUM_SYSTEM_FUNCTIONS:-/lib/functions/system.sh}"
+. "${CAMBIUM_RRM_LIB:-/lib/functions/cambium-rrm.sh}"
+
+driver=$(rrm_scan_driver) || exit 0
+dev=$(readlink -f "${RRM_SYSROOT:-/sys}$DEVPATH/device") || exit 0
+[ "$(basename "$(readlink "$dev/driver")")" = "$driver" ] || exit 0
+# The path as wifi-detect (/usr/share/hostap/wifi-detect.uc) writes it: it
+# drops "platform/" from PCI device paths, and matches paths exactly, so the
+# scan section must use the same form for wifi-detect to leave the radio be.
+path=${dev#${RRM_SYSROOT:-/sys}/devices/}
+case "$path" in platform/*/pci*) path=${path#platform/} ;; esac
+
+changed=
+for section in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
+	[ "$section" = scan ] && continue
+	# Either form, with or without "platform/".
+	case "$(uci -q get "wireless.$section.path")" in
+	"$path"|"platform/$path") ;;
+	*) continue ;;
+	esac
+	# Drop the default section wifi-detect made, and any networks on it.
+	for iface in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)\.device='$section'$/\1/p"); do
+		uci -q delete "wireless.$iface"
+	done
+	uci -q delete "wireless.$section"
+	changed=1
+done
+if [ "$(uci -q get wireless.scan.path)" != "$path" ] || [ "$(uci -q get wireless.scan.disabled)" != 1 ]; then
+	uci -q set wireless.scan=wifi-device
+	uci -q set wireless.scan.type=mac80211
+	uci -q set wireless.scan.path="$path"
+	uci -q set wireless.scan.disabled=1
+	changed=1
+fi
+[ -z "$changed" ] || uci -q commit wireless
+exit 0
diff --git a/package/cambium/cambium-rrm-agent/files/cambium-rrm-agent b/package/cambium/cambium-rrm-agent/files/cambium-rrm-agent
new file mode 100644
index 0000000000..b7cd8c69d4
--- /dev/null
+++ b/package/cambium/cambium-rrm-agent/files/cambium-rrm-agent
@@ -0,0 +1,75 @@
+#!/bin/sh
+# Cambium RRM measurement agent: what the radio resource planner needs from
+# each access point, on every family.
+#
+#   cambium-rrm-agent --once    measure once and write the result
+#   cambium-rrm-agent --loop    measure every cambium_rrm.agent.interval seconds
+#
+# Each measurement records every radio's driver, operating channel, width,
+# survey (channel active, busy, receive and transmit time, noise) and client
+# count, and the neighbouring networks: from a dedicated scanning radio at
+# every measurement where the family has one (its scan0 interface exists
+# only while it scans), otherwise from the serving radios' own scans at
+# cambium_rrm.agent.scan_times. The result, one file for OpenWiFi to
+# collect, is $RRM_OUT/latest.json; uCentral sends it
+# through authenticated uCentral telemetry.
+#
+# Test hooks: CAMBIUM_RRM_LIB, CAMBIUM_SYSTEM_FUNCTIONS and those of the
+# library (/lib/functions/cambium-rrm.sh).
+
+. "${CAMBIUM_SYSTEM_FUNCTIONS:-/lib/functions/system.sh}"
+. "${CAMBIUM_RRM_LIB:-/lib/functions/cambium-rrm.sh}"
+
+# One measurement at a time: a run by hand waits for the service's current
+# one (they would share the scanning interface and the output files). The
+# lock records its run's process: a lock whose process is gone is stale.
+lock=$RRM_OUT/lock
+owned= sleeper=
+trap '[ -z "$owned" ] || rm -rf "$lock"' EXIT
+trap '[ -z "$sleeper" ] || kill "$sleeper" 2>/dev/null; exit 0' INT TERM
+run() {
+	local waited=0 pid
+	mkdir -p "$RRM_OUT"
+	until mkdir "$lock" 2>/dev/null; do
+		pid=$(cat "$lock/pid" 2>/dev/null)
+		if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
+			rm -rf "$lock"
+		elif [ -z "$pid" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
+			rm -rf "$lock"  # a lock that never recorded its process
+		elif [ "$waited" -ge 60 ]; then
+			echo "cambium-rrm-agent: another measurement is still running" >&2
+			return 1
+		else
+			sleep 2
+			waited=$((waited + 2))
+		fi
+	done
+	owned=1
+	echo $$ > "$lock/pid"
+	rrm_measure
+	rm -rf "$lock"
+	owned=
+}
+
+case "${1:-}" in
+--once)
+	run
+	;;
+--loop)
+	while :; do
+		run
+		interval=$(uci -q get cambium_rrm.agent.interval)
+		case "$interval" in ''|*[!0-9]*) interval=300 ;; esac
+		[ "$interval" -ge 60 ] || interval=60
+		# In the background, so a stop signal is acted on at once.
+		sleep "$interval" &
+		sleeper=$!
+		wait "$sleeper"
+		sleeper=
+	done
+	;;
+*)
+	echo "usage: $0 --once | --loop" >&2
+	exit 2
+	;;
+esac
diff --git a/package/cambium/cambium-rrm-agent/files/cambium-rrm-agent.init b/package/cambium/cambium-rrm-agent/files/cambium-rrm-agent.init
