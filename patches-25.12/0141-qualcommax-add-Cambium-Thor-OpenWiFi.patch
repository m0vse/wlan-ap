diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8074-xv3-8-installer.dts b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8074-xv3-8-installer.dts
new file mode 100644
index 0000000000..ace7a6ee94
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8074-xv3-8-installer.dts
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/*
+ * Thor RAM installer: OpenWrt goes into rootfs, so only rootfs and the U-Boot
+ * environment (for the guarded first boot) are writable. rootfs_1 keeps the
+ * stock firmware read-only.
+ */
+#include "ipq8074-xv3-8.dts"
+
+/ {
+	model = "Cambium Networks XV3-8";
+
+	chosen {
+		bootargs-append = " ubi.mtd=rootfs root=/dev/ubiblock0_1 rootfstype=squashfs rootwait";
+	};
+};
+
+&rootfs {
+	/delete-property/ read-only;
+};
+
+&appsblenv {
+	/delete-property/ read-only;
+};
