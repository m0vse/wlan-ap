diff --git a/package/cambium/cambium-thor-support/files/thor-scan-radio b/package/cambium/cambium-thor-support/files/thor-scan-radio
new file mode 100755
index 0000000000..001f1e17e8
--- /dev/null
+++ b/package/cambium/cambium-thor-support/files/thor-scan-radio
@@ -0,0 +1,21 @@
+#!/bin/sh
+[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = cambiumnetworks,xv3-8 ] || exit 0
+for phy in /sys/class/ieee80211/*; do
+ [ "$(basename "$(readlink -f "$phy/device/driver")")" = ath10k_pci ] || continue
+ dev=$(readlink -f "$phy/device") || continue
+ path=${dev#/sys/devices/}
+ case "$path" in platform/*/pci*) path=${path#platform/} ;; esac
+ for section in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
+  case "$(uci -q get wireless.$section.path)" in "$path"|"platform/$path") ;; *) continue ;; esac
+  for iface in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)\.device='$section'$/\1/p"); do
+   uci -q delete wireless.$iface
+  done
+  uci -q delete wireless.$section
+ done
+ uci set wireless.scan=wifi-device
+ uci set wireless.scan.type=mac80211
+ uci set wireless.scan.path="$path"
+ uci set wireless.scan.disabled=1
+ uci commit wireless
+ done
+exit 0
