diff --git a/package/cambium/cambium-thor-support/files/thor-topology-main.uc b/package/cambium/cambium-thor-support/files/thor-topology-main.uc
new file mode 100644
index 0000000000..1498c1198e
--- /dev/null
+++ b/package/cambium/cambium-thor-support/files/thor-topology-main.uc
@@ -0,0 +1,87 @@
+#!/usr/bin/ucode
+REQUIRE_SEARCH_PATH = ['/usr/share/ucentral/*.uc', ...REQUIRE_SEARCH_PATH];
+import * as fs from 'fs';
+import * as uci from 'uci';
+import * as schema from 'schemareader';
+let policy = require('thor_topology_policy');
+// Offline fixtures use a private root. Firmware always uses the normal paths.
+let root = getenv('THOR_ROOT') || '';
+function path(name) { return root + name; }
+function read(name) { return fs.readfile(path(name)); }
+let pending = '/etc/ucentral/thor-topology.pending.json';
+let marker = '/etc/ucentral/thor-topology.pending';
+let modefile = '/etc/modules.d/ath11k-ahb';
+let config;
+function document(source) {
+ let raw = json(read(source) || '');
+ let logs = [];
+ let validated = schema.validate(raw, logs);
+ assert(validated && !length(filter(logs, m => substr(m, 0, 3) == '[E]')),
+        'Topology requires a valid saved controller configuration');
+ return {raw, validated};
+}
+function clear_pending() { fs.unlink(path(pending)); fs.unlink(path(marker)); }
+function stage(source) {
+ assert(match(source, /^\/etc\/ucentral\/ucentral\.cfg\.[0-9]+$/),
+        'Unexpected controller configuration path');
+ let doc = document(source);
+ let active = trim(read('/sys/module/ath11k/parameters/xv3_8_hw_mode') || '');
+ let previous = config.get('xv3_8_radio', 'main', 'mode') || 'dual-4x4';
+ let desired = policy.select_mode(doc.validated, previous);
+ assert(active in ['dual-4x4', 'single-8x8'], 'Active Thor topology is unavailable');
+ if (active == desired) { clear_pending(); return; }
+ assert(fs.writefile(path(pending + '.tmp'), sprintf('%J', doc.raw)), 'Cannot stage topology document');
+ assert(fs.rename(path(pending + '.tmp'), path(pending)), 'Cannot commit topology document');
+ assert(fs.writefile(path(marker), sprintf('%J', {source, uuid: doc.raw.uuid, active, desired, reboot_required: true})),
+        'Cannot record pending topology');
+ // Existing active configuration and live UCI are unchanged until the next boot.
+}
+function boot() {
+ fs.unlink(path("/tmp/thor-topology.failed"));
+ let source, change = json(read(marker) || '{}');
+ if (fs.stat(path(marker))) {
+  assert(fs.stat(path(pending)), 'Pending topology document is missing');
+  source = pending;
+ } else {
+  source = '/etc/ucentral/ucentral.active';
+  if (fs.stat(path(source)) || fs.readlink(path(source))) {
+   assert(length(read(source) || ''), 'Saved active configuration is missing or empty');
+   if (json(read(source))?.uuid == 1) source = '/rom/etc/ucentral/ucentral.cfg.0000000001';
+  } else if (fs.stat(path('/etc/ucentral/ucentral.cfg.0000000002')))
+   source = '/etc/ucentral/ucentral.cfg.0000000002';
+  else source = '/rom/etc/ucentral/ucentral.cfg.0000000001';
+ }
+ let doc = document(source);
+ let desired = policy.select_mode(doc.validated, config.get('xv3_8_radio', 'main', 'mode'));
+ if (fs.stat(path(marker))) {
+  assert(match(change.source, /^\/etc\/ucentral\/ucentral\.cfg\.[0-9]+$/), 'Invalid pending controller path');
+  assert(doc.raw.uuid == change.uuid && desired == change.desired, 'Pending topology identity changed');
+  assert(fs.writefile(path(change.source), sprintf('%J', doc.raw)), 'Cannot retain accepted controller document');
+  fs.unlink(path('/etc/ucentral/ucentral.active'));
+  assert(fs.symlink(path(change.source), path('/etc/ucentral/ucentral.active')), 'Cannot select accepted controller document');
+  clear_pending();
+ }
+ config.set('xv3_8_radio', 'main', 'settings');
+ config.set('xv3_8_radio', 'main', 'mode', desired);
+ assert(config.commit('xv3_8_radio'), 'Cannot persist selected topology');
+ if (fs.stat(path('/etc/config-shadow/xv3_8_radio')))
+  assert(fs.writefile(path('/etc/config-shadow/xv3_8_radio'), read('/etc/config/xv3_8_radio')), 'Cannot retain shadow topology');
+ assert(fs.writefile(path(modefile + '.tmp'), 'ath11k xv3_8_hw_mode=' + desired + '\nath11k_ahb\n'), 'Cannot stage module mode');
+ assert(fs.rename(path(modefile + '.tmp'), path(modefile)), 'Cannot select module mode');
+ assert(fs.chmod(path(modefile), 0644), 'Cannot protect module mode');
+ fs.writefile(path('/tmp/thor-topology.desired'), desired);
+}
+try {
+ if (trim(read('/tmp/sysinfo/board_name') || '') != 'cambiumnetworks,xv3-8') exit(0);
+ if (!fs.stat(path('/tmp/.uci')))
+  assert(fs.mkdir(path('/tmp/.uci'), 0700), 'Cannot prepare early UCI staging');
+ config = uci.cursor(path('/etc/config'), path('/tmp/.uci'));
+ assert(config, 'Cannot load early UCI configuration');
+ if (ARGV[0] == 'stage') stage(ARGV[1]);
+ else if (ARGV[0] == 'boot') boot();
+ else die('Expected boot or stage');
+} catch (e) {
+ fs.writefile(path('/tmp/thor-topology.failed'), 'Thor topology validation failed');
+ warn('Thor topology failed closed: ', e, '\n');
+ exit(1);
+}
