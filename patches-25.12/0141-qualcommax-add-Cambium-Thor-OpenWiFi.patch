diff --git a/package/cambium/cambium-thor-support/files/thor_topology_policy.uc b/package/cambium/cambium-thor-support/files/thor_topology_policy.uc
new file mode 100644
index 0000000000..ecf22c00e0
--- /dev/null
+++ b/package/cambium/cambium-thor-support/files/thor_topology_policy.uc
@@ -0,0 +1,55 @@
+// Thor's ath11k topology is selected at module load, not by antenna masks.
+function select_mode(config, previous) {
+ let selected = null, five = [];
+ for (let radio in config.radios || []) {
+  if (radio.enable == false) continue;
+  assert(radio.band in ['2G', '5G', '5G-lower', '5G-upper'], 'Unsupported Thor serving band');
+  let request = radio.mimo ? match(radio.mimo, /^([1-8])x([1-8])$/) : null;
+  if (radio.mimo)
+   assert(request && request[1] == request[2], 'Invalid Thor MIMO request');
+  if (radio.band == '2G') {
+   assert(!request || +request[1] <= 4, 'Thor 2GHz supports at most four chains');
+   continue;
+  }
+  push(five, radio);
+  let mode = request && +request[1] > 4 ? 'single-8x8' :
+             request || radio.band != '5G' ? 'dual-4x4' : null;
+  if (mode) {
+   assert(!selected || selected == mode, 'Conflicting Thor 5GHz topologies');
+   selected = mode;
+  }
+ }
+ selected ||= previous || 'dual-4x4';
+ assert(selected in ['dual-4x4', 'single-8x8'], 'Invalid persisted Thor topology');
+ if (selected == 'single-8x8')
+  assert(length(five) <= 1 && (!length(five) || five[0].band == '5G'),
+         'Combined 8x8 needs one full-band 5G configuration; split settings conflict');
+ return selected;
+};
+
+function chains(mask) {
+ let count = 0;
+ for (let bit = 0; bit < 16; bit++)
+  if (mask & (1 << bit)) count++;
+ return count;
+};
+
+function validate_phys(phys, mode) {
+ let two = [], five = [];
+ for (let path, phy in phys) {
+  if ('2G' in phy.band) push(two, phy);
+  if ('5G' in phy.band) push(five, phy);
+ }
+ assert(length(two) == 1 && length(five) == (mode == 'single-8x8' ? 1 : 2),
+        'Thor serving PHY layout does not match selected topology');
+ for (let phy in two)
+  assert(chains(phy.tx_ant_avail) == 4 && chains(phy.rx_ant_avail) == 4,
+         'Thor 2GHz does not advertise four chains');
+ for (let phy in five)
+  assert(chains(phy.tx_ant_avail) == (mode == 'single-8x8' ? 8 : 4) &&
+         chains(phy.rx_ant_avail) == (mode == 'single-8x8' ? 8 : 4),
+         'Thor 5GHz chain capability does not match actual topology');
+ return phys;
+};
+
+return { select_mode, chains, validate_phys };
