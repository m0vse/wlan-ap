 PKG_LICENSE:=GPL-2.0-only
 PKG_MAINTAINER:=Phil Taylor <phil@m0vse.uk>
 
--- a/package/cambium/cambium-cheetah-support/Makefile
+++ b/package/cambium/cambium-cheetah-support/Makefile
@@ -1,7 +1,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=cambium-cheetah-support
-PKG_RELEASE:=8
+PKG_RELEASE:=9
 PKG_LICENSE:=GPL-2.0-only
 PKG_MAINTAINER:=Phil Taylor <phil@m0vse.uk>
 
--- a/package/cambium/cambium-ab/files/cambium-ab.sh
+++ b/package/cambium/cambium-ab/files/cambium-ab.sh
@@ -53,7 +53,7 @@
 ab_board() {
 	local family
 	for family in ${AB_FAMILIES:-}; do
-		AB_QUALIFIED=0 AB_VAULT=0 AB_STOCK_BOOTCMD=bootipq AB_LAN=br-lan AB_RADIOS=0 AB_RADIO_DEVICE=
+		AB_QUALIFIED=0 AB_CONVERSION_SUPPORTED=0 AB_VAULT=0 AB_STOCK_BOOTCMD=bootipq AB_LAN=br-lan AB_RADIOS=0 AB_RADIO_DEVICE=
 		AB_LAYOUT=banks AB_MARKER=1 AB_ROOT_MAGIC=hsqs AB_HEALTH_TRIES=60
 		AB_ENV_PART=0:APPSBLENV
 		# OpenWiFi-specific modules opt into the certificate-volume ABI.
--- a/package/cambium/cambium-cheetah-support/files/cambium-ab-cheetah.sh
+++ b/package/cambium/cambium-cheetah-support/files/cambium-ab-cheetah.sh
@@ -35,6 +35,8 @@
 	cambiumnetworks,xv2-23t)
 		# RAM bring-up supports a persistent trial; full hardware/A-B acceptance is pending.
 		AB_MODEL=XV2-23T; AB_SKU=00000024; AB_FIT=config@mp03.3-lynx
+		# Explicitly enabled for deliberate A/B testing; qualification remains pending.
+		AB_CONVERSION_SUPPORTED=1
 		AB_LAN='br-lan.1 br-lan'
 		AB_RADIOS=2
 		;;
--- a/package/cambium/cambium-ab/files/cambium-ab-convert
+++ b/package/cambium/cambium-ab/files/cambium-ab-convert
@@ -55,8 +55,8 @@
 [ "$AB_LAYOUT" != pair ] ||
 	die "$AB_NAME needs no conversion: its first sysupgrade writes the other slot"
 ab_converted && die 'already converted; use sysupgrade'
-[ "$AB_QUALIFIED" = 1 ] || [ -n "$allow_untested" ] ||
-	die "$AB_MODEL has no validated A/B conversion yet (--allow-untested overrides)"
+[ "$AB_QUALIFIED" = 1 ] || [ "${AB_CONVERSION_SUPPORTED:-0}" = 1 ] ||
+	die "A/B conversion is not enabled for $AB_MODEL"
 ab_mtd_writable "$AB_TARGET_MTD" ||
 	die "bank $AB_TARGET_PART is read-only: install the A/B persistent image first"
 [ "$AB_VAULT" != 1 ] || ${AB_BOARD_DATA:-/usr/sbin/cambium-board-data} --check-vault ||
