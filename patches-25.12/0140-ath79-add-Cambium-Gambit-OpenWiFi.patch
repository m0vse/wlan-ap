diff --git a/target/linux/ath79/dts/qca9558_cambiumnetworks_e400.dts b/target/linux/ath79/dts/qca9558_cambiumnetworks_e400.dts
new file mode 100644
index 0000000000..5c7abdf968
--- /dev/null
+++ b/target/linux/ath79/dts/qca9558_cambiumnetworks_e400.dts
@@ -0,0 +1,220 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+#include "qca955x.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	compatible = "cambiumnetworks,e400", "qca,qca9558";
+	model = "Cambium Networks E400";
+
+	aliases {
+		label-mac-device = &eth0;
+		led-boot = &led_power_green;
+		led-failsafe = &led_power_amber;
+		led-running = &led_power_green;
+		led-upgrade = &led_power_amber;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_power_green: power-green {
+			label = "green:status";
+			gpios = <&gpio 19 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_power_amber: power-amber {
+			label = "amber:status";
+			gpios = <&gpio 22 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		network-green {
+			label = "green:lan";
+			gpios = <&gpio 20 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		network-amber {
+			label = "amber:lan";
+			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+	};
+
+	cambium-platform {
+		compatible = "cambium-platform";
+		board-sku = <6>;
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "reset";
+			gpios = <&gpio 23 GPIO_ACTIVE_HIGH>;
+			debounce-interval = <60>;
+			linux,code = <KEY_RESTART>;
+		};
+	};
+};
+
+&spi {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x000000 0x040000>;
+				read-only;
+			};
+
+			gambit_env: partition@40000 {
+				label = "u-boot-env";
+				reg = <0x040000 0x010000>;
+				read-only;
+			};
+
+			partition@50000 {
+				label = "CrashLog";
+				reg = <0x050000 0x790000>;
+				read-only;
+			};
+
+			partition@7e0000 {
+				label = "mfginfo";
+				reg = <0x7e0000 0x010000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					/* Factory TLV type 1: twelve hexadecimal MAC digits. */
+					macaddr_mfginfo_6: macaddr@6 {
+						compatible = "mac-base";
+						reg = <0x6 0xc>;
+						#nvmem-cell-cells = <1>;
+					};
+				};
+			};
+
+			partition@7f0000 {
+				label = "ART";
+				reg = <0x7f0000 0x010000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					cal_art_1000: calibration@1000 {
+						reg = <0x1000 0x440>;
+					};
+
+					cal_art_5000: calibration@5000 {
+						reg = <0x5000 0x844>;
+					};
+				};
+			};
+		};
+	};
+};
+
+&nand {
+	status = "okay";
+	/* Match OEM/U-Boot: 8 x 256-byte Hamming steps, ECC at OOB 40..63. */
+	nand-ecc-mode = "soft";
+	nand-ecc-algo = "hamming";
+	nand-ecc-step-size = <256>;
+	nand-ecc-strength = <1>;
+
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		gambit_linux0: partition@0 {
+			label = "linux0";
+			reg = <0x0000000 0x0300000>;
+			read-only;
+		};
+
+		gambit_rootfs0: partition@300000 {
+			label = "rootfs0";
+			reg = <0x0300000 0x2d00000>;
+			read-only;
+		};
+
+		gambit_linux1: partition@3000000 {
+			label = "linux1";
+			reg = <0x3000000 0x0300000>;
+			read-only;
+		};
+
+		gambit_rootfs1: partition@3300000 {
+			label = "rootfs1";
+			reg = <0x3300000 0x2d00000>;
+			read-only;
+		};
+
+		partition@6000000 {
+			label = "nvram";
+			reg = <0x6000000 0x2000000>;
+			read-only;
+		};
+	};
+};
+
+&mdio0 {
+	status = "okay";
+
+	phy5: ethernet-phy@5 {
+		reg = <5>;
+		eee-broken-100tx;
+		eee-broken-1000t;
+	};
+};
+
+&eth0 {
+	status = "okay";
+	nvmem-cells = <&macaddr_mfginfo_6 0>;
+	nvmem-cell-names = "mac-address";
+
+	phy-handle = <&phy5>;
+	phy-mode = "rgmii-id";
+
+	pll-data = <0x82000000 0x80000101 0x80001313>;
+};
+
+&wmac {
+	status = "okay";
+
+	nvmem-cells = <&cal_art_1000>;
+	nvmem-cell-names = "calibration";
+};
+
+&pcie0 {
+	status = "okay";
+
+	wifi@0,0 {
+		compatible = "qcom,ath10k";
+		reg = <0 0 0 0 0>;
+		nvmem-cells = <&cal_art_5000>;
+		nvmem-cell-names = "calibration";
+	};
+};
