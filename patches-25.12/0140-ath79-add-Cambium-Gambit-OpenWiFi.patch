diff --git a/package/cambium/cambium-gambit-support/files/12_gambit_recovery b/package/cambium/cambium-gambit-support/files/12_gambit_recovery
new file mode 100644
index 0000000000..43c7a33d83
--- /dev/null
+++ b/package/cambium/cambium-gambit-support/files/12_gambit_recovery
@@ -0,0 +1,30 @@
+#!/bin/sh
+
+R=${CAMBIUM_ROOT:-}
+. "${CAMBIUM_SYSTEM_FUNCTIONS:-/lib/functions/system.sh}"
+
+[ "$(board_name)" = "cambiumnetworks,e400" ] || exit 0
+# Persistent images already get the shared AP defaults. Never replace a
+# restored static/OpenWISP network or custom hostname during sysupgrade.
+grep -q 'ubi.mtd=rootfs[01]' "$R/proc/cmdline" && exit 0
+
+# Recovery is an upstream DHCP client and must not offer DHCP or RA on the
+# attached network.
+uci -q set network.lan.proto='dhcp'
+uci -q delete network.lan.ipaddr
+uci -q delete network.lan.netmask
+uci -q delete network.lan.gateway
+uci -q delete network.lan.dns
+uci -q delete network.lan.ip6assign
+uci -q commit network
+
+uci -q set dhcp.lan.ignore='1'
+uci -q set dhcp.lan.dhcpv4='disabled'
+uci -q set dhcp.lan.dhcpv6='disabled'
+uci -q set dhcp.lan.ra='disabled'
+uci -q commit dhcp
+
+uci -q set system.@system[0].hostname='gambit-recovery'
+uci -q commit system
+
+exit 0
diff --git a/package/cambium/cambium-gambit-support/files/17_gambit_bridge_section b/package/cambium/cambium-gambit-support/files/17_gambit_bridge_section
new file mode 100644
index 0000000000..cf95c197c1
--- /dev/null
+++ b/package/cambium/cambium-gambit-support/files/17_gambit_bridge_section
@@ -0,0 +1,60 @@
+#!/bin/sh
+
+# Accept only untagged/PVID VLAN 1 for recovery management. Tagged traffic
+# from a busy trunk must not enter the LAN bridge before OpenWISP configures it.
+[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'cambiumnetworks,e400' ] || exit 0
+
+if [ "$(uci -q get network.device_br_lan.vlan_filtering)" = '1' ] &&
+   [ "$(uci -q get network.lan.device)" = 'br-lan.1' ]; then
+	if [ "$(uci -q get network.lan6.device)" = 'br-lan' ]; then
+		uci set network.lan6.device='br-lan.1'
+		uci commit network
+	fi
+	if [ "$(uci -q get openwisp.http.management_interface)" = 'br-lan' ]; then
+		uci set openwisp.http.management_interface='br-lan.1'
+		uci commit openwisp
+	fi
+	exit 0
+fi
+
+bridge_section=device_br_lan
+if [ -z "$(uci -q get network.device_br_lan.name)" ]; then
+	bridge_section=device_lan
+fi
+if [ -z "$(uci -q get "network.$bridge_section.name")" ]; then
+	bridge_section=
+	for index in 0 1 2 3 4 5 6 7; do
+		if [ "$(uci -q get "network.@device[$index].name")" = 'br-lan' ]; then
+			bridge_section="@device[$index]"
+			break
+		fi
+	done
+fi
+
+[ -n "$bridge_section" ] || exit 1
+[ "$(uci -q get "network.$bridge_section.name")" = 'br-lan' ] || exit 1
+[ "$(uci -q get "network.$bridge_section.ports")" = 'eth0' ] || exit 1
+[ "$(uci -q get network.lan.proto)" = 'dhcp' ] || exit 1
+[ "$(uci -q get network.lan.device)" = 'br-lan' ] || exit 1
+[ -z "$(uci -q get network.vlan_br_lan_101.vlan)" ] || exit 1
+
+if [ "$bridge_section" != 'device_br_lan' ]; then
+	uci rename "network.$bridge_section=device_br_lan" || exit 1
+fi
+
+uci set network.device_br_lan.vlan_filtering='1'
+uci set network.vlan_br_lan_1=bridge-vlan
+uci set network.vlan_br_lan_1.device='br-lan'
+uci set network.vlan_br_lan_1.vlan='1'
+uci -q delete network.vlan_br_lan_1.ports
+uci add_list network.vlan_br_lan_1.ports='eth0:u*'
+uci set network.lan.device='br-lan.1'
+if [ "$(uci -q get network.lan6.device)" = 'br-lan' ]; then
+	uci set network.lan6.device='br-lan.1'
+fi
+uci commit network
+if [ "$(uci -q get openwisp.http.management_interface)" = 'br-lan' ]; then
+	uci set openwisp.http.management_interface='br-lan.1'
+	uci commit openwisp
+fi
+exit 0
