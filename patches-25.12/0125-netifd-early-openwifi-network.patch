Subject: OpenWiFi: render management before network activation

Keep stock netifd bridge VLAN/PVID behavior. Only gate activation on the
early renderer, and prevent stale DHCP-server startup after render failure.

diff --git a/package/network/config/netifd/Makefile b/package/network/config/netifd/Makefile
index fe1b234fbb..4636e11dbe 100644
--- a/package/network/config/netifd/Makefile
+++ b/package/network/config/netifd/Makefile
@@ -1,7 +1,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=netifd
-PKG_RELEASE:=1
+PKG_RELEASE:=3
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL=$(PROJECT_GIT)/project/netifd.git
diff --git a/package/network/config/netifd/files/etc/init.d/network b/package/network/config/netifd/files/etc/init.d/network
index 11bf3eabdf..811378cc0e 100755
--- a/package/network/config/netifd/files/etc/init.d/network
+++ b/package/network/config/netifd/files/etc/init.d/network
@@ -17,6 +17,10 @@ init_switch() {
 }
 
 start_service() {
+	# OpenWiFi must render its saved management VLAN before netifd or DHCP.
+	if [ -x /usr/libexec/ucentral-network ]; then
+		/usr/libexec/ucentral-network || return 1
+	fi
 	init_switch
 
 	procd_open_instance
diff --git a/package/network/services/dnsmasq/files/dnsmasq.init b/package/network/services/dnsmasq/files/dnsmasq.init
index be3d4cbabb..9bf6d3d39d 100755
--- a/package/network/services/dnsmasq/files/dnsmasq.init
+++ b/package/network/services/dnsmasq/files/dnsmasq.init
@@ -1338,6 +1338,10 @@ boot()
 }
 
 start_service() {
+	# Do not start a stale bootstrap DHCP server after a failed early render.
+	if [ -x /usr/libexec/ucentral-network ]; then
+		[ -e /tmp/ucentral-network.ready ] || return 1
+	fi
 	local instance="$1"
 	local instance_found=0
 	local first_instance=""
