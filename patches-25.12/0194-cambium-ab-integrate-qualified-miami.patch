From: Phil Taylor <phil@m0vse.uk>
Subject: [PATCH] Miami: integrate qualified A/B routing with current shared source

Keep public shared trial, OEM-return and family preflight implementations.
Add retained Miami hooks, physical-MTD lookup, certificate capacity and
resolved-target config restore after the shared patch sequence.
Release24 is above retained Miami23 and qualified shared20; source integration only.

Signed-off-by: Phil Taylor <phil@m0vse.uk>
---
--- a/package/cambium/cambium-ab/Makefile
+++ b/package/cambium/cambium-ab/Makefile
@@ -1,7 +1,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=cambium-ab
-PKG_RELEASE:=20
+PKG_RELEASE:=24
 PKG_LICENSE:=GPL-2.0-only
 PKG_MAINTAINER:=Phil Taylor <phil@m0vse.uk>
 
--- a/package/cambium/cambium-ab/files/cambium-ab.sh
+++ b/package/cambium/cambium-ab/files/cambium-ab.sh
@@ -81,12 +81,23 @@
 }
 
 ab_mtd_index() {
-	awk -v wanted="\"$1\"" '$4 == wanted { sub(/^mtd/, "", $1); sub(/:$/, "", $1); print $1 }' \
-		"${AB_PROC_MTD:-/proc/mtd}"
+	awk -v wanted="\"$1\"" -v sys="${AB_MTD_SYS:-/sys/class/mtd}" '
+	$4 == wanted {
+		idx=$1; sub(/^mtd/, "", idx); sub(/:$/, "", idx)
+		path=sys "/mtd" idx "/type"
+		kind=""; getline kind < path; close(path)
+		if (kind != "ubi") print idx
+	}' "${AB_PROC_MTD:-/proc/mtd}"
 }
 
 ab_mtd_geometry() {
-	awk -v wanted="\"$1\"" '$4 == wanted { print $2, $3 }' "${AB_PROC_MTD:-/proc/mtd}"
+	awk -v wanted="\"$1\"" -v sys="${AB_MTD_SYS:-/sys/class/mtd}" '
+	$4 == wanted {
+		idx=$1; sub(/^mtd/, "", idx); sub(/:$/, "", idx)
+		path=sys "/mtd" idx "/type"
+		kind=""; getline kind < path; close(path)
+		if (kind != "ubi") print $2, $3
+	}' "${AB_PROC_MTD:-/proc/mtd}"
 }
 
 ab_mtd_writable() {
--- a/package/cambium/cambium-ab/files/cambium-ab-upgrade.sh
+++ b/package/cambium/cambium-ab/files/cambium-ab-upgrade.sh
@@ -32,7 +32,8 @@
 ab_certificate_lebs() {
 	case "${AB_CERTIFICATE_LEBS:-0}" in
 	0|20) echo "${AB_CERTIFICATE_LEBS:-0}" ;;
-	*) ab_fail "invalid certificate-volume policy: expected 0 or 20 LEBs"; return 1 ;;
+	64) [ "$AB_FAMILY:$AB_MODEL" = miami:X7-35X ] || { ab_fail "64-LEB policy requires exact Miami model"; return 1; }; echo 64 ;;
+	*) ab_fail "invalid certificate-volume policy: expected 0/20 or exact Miami 64 LEBs"; return 1 ;;
 	esac
 }
 
@@ -97,6 +98,9 @@
 ab_upgrade_preflight() {
 	local state
 	ab_identity || return 1
+	if ab_hook upgrade_preflight; then
+		"ab_${AB_FAMILY}_upgrade_preflight" || return 1
+	fi
 	if [ "${AB_FAMILY:-}" = thor ]; then
 		ab_thor_boot_preflight || return 1
 	fi
@@ -104,6 +108,7 @@
 	# A pair-layout family (Sage) has no conversion step: writing the other
 	# slot replaces whatever it held, as its first upgrade always has.
 	[ "$AB_LAYOUT" = pair ] || ab_converted ||
+		{ ab_hook first_upgrade && "ab_${AB_FAMILY}_first_upgrade"; } ||
 		ab_fail "this AP still has one OEM slot; run cambium-ab-convert first" || return 1
 	ab_mtd_writable "$AB_TARGET_MTD" ||
 		ab_fail "target bank $AB_TARGET_PART is read-only (not an A/B image)" || return 1
@@ -226,6 +231,58 @@
 	return "$rc"
 }
 
+# Use the resolved inactive UBI device: physical banks and gluebi views
+# may share the name rootfs, so a fresh generic name lookup is ambiguous.
+ab_restore_config() {
+	[ "${AB_FAMILY:-}:${AB_MODEL:-}" = miami:X7-35X ] || return 1
+	local backup="$1" ubi data dir before after= rc=0 dev=${AB_DEV:-/dev}
+	[ -f "$backup" ] || return 1
+	case "${BACKUP_FILE:-}" in ''|.|..|*/*) return 1;; esac
+	case "${AB_TARGET_MTD:-}" in ''|*[!0-9]*) return 1;; esac
+	case "${AB_ACTIVE_MTD:-}" in ''|*[!0-9]*) return 1;; esac
+	[ "$AB_TARGET_MTD" != "$AB_ACTIVE_MTD" ] || return 1
+	case "${AB_ACTIVE_UBI:-}" in ubi*) :;; *) return 1;; esac
+	case "${AB_ACTIVE_UBI#ubi}" in ''|*[!0-9]*) return 1;; esac
+	[ "$(ab_ubi_for_mtd "$AB_ACTIVE_MTD")" = "$AB_ACTIVE_UBI" ] || return 1
+	ubi=$(ab_ubi_for_mtd "$AB_TARGET_MTD") || return 1
+	case "$ubi" in ubi*) :;; *) return 1;; esac
+	case "${ubi#ubi}" in ''|*[!0-9]*) return 1;; esac
+	[ "$ubi" = "${AB_TARGET_UBI:-}" ] && [ "$ubi" != "$AB_ACTIVE_UBI" ] || return 1
+	data=$(ab_ubi_volume "$ubi" rootfs_data) || return 1
+	[ "$data" = "${ubi}_2" ] && [ -e "$dev/$data" ] || return 1
+	before=$(sha256sum "$backup") || return 1
+	before=${before%% *}
+	[ "${#before}" = 64 ] || return 1
+	case "$before" in *[!0-9a-f]*) return 1;; esac
+	dir=$(mktemp -d /tmp/cambium-ab-config.XXXXXX) || return 1
+	case "$dir" in /tmp/cambium-ab-config.*) :;; *) return 1;; esac
+	[ -d "$dir" ] && [ ! -L "$dir" ] || return 1
+	if ! mount -t ubifs "$dev/$data" "$dir"; then
+		rmdir "$dir"
+		return 1
+	fi
+	# Keep the normal backup archive/move semantics; preinit restores it.
+	if mv "$backup" "$dir/$BACKUP_FILE"; then
+		after=$(sha256sum "$dir/$BACKUP_FILE") || rc=1
+		[ "${after%% *}" = "$before" ] || rc=1
+		sync || rc=1
+	else
+		rc=1
+	fi
+	umount "$dir" || rc=1
+	# Never remove files from a mount which failed to unmount.
+	rmdir "$dir" || rc=1
+	return "$rc"
+}
+
+# Keep other families on their existing generic restore path.
+ab_restore_upgrade_config() {
+	case "${AB_FAMILY:-}:${AB_MODEL:-}" in
+	miami:X7-35X) ab_restore_config "$1" ;;
+	*) CI_UBIPART=$AB_TARGET_PART nand_restore_config "$1" ;;
+	esac
+}
+
 # Arm the one-shot trial of the written bank. bootcmd is the last write.
 ab_arm_trial() {
 	local batch=/tmp/cambium-ab-env-arm.$$ trial rc=0
@@ -245,7 +302,7 @@
 
 	# stage2 must prove the private snapshot survived the RAM copy BEFORE
 	# recording writes or erasing any inactive-bank data.
-	if [ "$(ab_certificate_lebs)" = 20 ] && [ "$AB_LAYOUT" = banks ]; then
+	if [ "$(ab_certificate_lebs)" -gt 0 ] && [ "$AB_LAYOUT" = banks ]; then
 		type ab_certificate_validate_snapshot >/dev/null 2>&1 && ab_certificate_validate_snapshot ||
 			{ ab_fail 'RAM-stage certificate snapshot validation failed; no bank was written'; return 1; }
 	fi
@@ -259,13 +316,19 @@
 	rm -f "$batch"
 
 	echo "cambium-ab: writing slot $AB_TARGET ($AB_TARGET_PART) from slot $AB_ACTIVE"
+	if ab_hook before_target_write; then
+		"ab_${AB_FAMILY}_before_target_write" || { ab_record_failure write-failed "source context changed before target write"; return 1; }
+	fi
 	if ab_hook write_target; then
 		"ab_${AB_FAMILY}_write_target" || return 1
-		if [ "$(ab_certificate_lebs)" = 20 ]; then
+		if [ "$(ab_certificate_lebs)" -gt 0 ]; then
 			type ab_certificate_restore >/dev/null 2>&1 && ab_certificate_restore ||
 				{ ab_record_failure write-failed 'cannot restore the certificate store'; return 1; }
 		fi
 		sync
+		if ab_hook upgrade_written; then
+			"ab_${AB_FAMILY}_upgrade_written" || { ab_record_failure write-failed "cannot complete first-conversion state"; return 1; }
+		fi
 		ab_arm_trial ||
 			{ ab_record_failure write-failed "cannot arm the trial of slot $AB_TARGET"; return 1; }
 		echo "cambium-ab: slot $AB_TARGET armed for one trial boot; slot $AB_ACTIVE stays the default until it is confirmed"
@@ -281,17 +344,20 @@
 		{ AB_STEP_ERROR=; ab_record_failure write-failed "slot $AB_TARGET readback mismatch"; return 1; }
 	[ "$AB_VAULT" != 1 ] || ab_copy_vault ||
 		{ ab_record_failure write-failed "cannot copy the device-data vault"; return 1; }
-	if [ "$(ab_certificate_lebs)" = 20 ]; then
+	if [ "$(ab_certificate_lebs)" -gt 0 ]; then
 		type ab_certificate_restore >/dev/null 2>&1 && ab_certificate_restore ||
 			{ ab_record_failure write-failed 'cannot restore the certificate store'; return 1; }
 	fi
 
 	if [ -n "${UPGRADE_BACKUP:-}" ]; then
-		CI_UBIPART=$AB_TARGET_PART nand_restore_config "$UPGRADE_BACKUP" ||
+		ab_restore_upgrade_config "$UPGRADE_BACKUP" ||
 			{ ab_record_failure write-failed "cannot save the configuration"; return 1; }
 	fi
 	sync
 
+	if ab_hook upgrade_written; then
+		"ab_${AB_FAMILY}_upgrade_written" || { ab_record_failure write-failed "cannot complete first-conversion state"; return 1; }
+	fi
 	ab_arm_trial ||
 		{ ab_record_failure write-failed "cannot arm the trial of slot $AB_TARGET"; return 1; }
 	echo "cambium-ab: slot $AB_TARGET armed for one trial boot; slot $AB_ACTIVE stays the default until it is confirmed"
--- a/package/cambium/cambium-ab/files/cambium-ab-certificates.sh
+++ b/package/cambium/cambium-ab/files/cambium-ab-certificates.sh
@@ -30,7 +30,9 @@
 ab_certificate_export() {
 	local work source volume mounted=0 runtime=${AB_CERTIFICATE_RUNTIME:-/etc/ucentral}
 	local store=${AB_CERTIFICATE_STORE:-/certificates} hash binding rc=0 file magic
-	[ "$(ab_certificate_lebs)" = 20 ] || return 0
+	local certificate_lebs
+	certificate_lebs=$(ab_certificate_lebs) || return 1
+	[ "$certificate_lebs" -gt 0 ] || return 0
 	ab_identity || return 1
 	[ "$AB_LAYOUT" = banks ] || return 0 # Sage's store is shared, not bank-local.
 	[ "$(cat "${AB_UBI_SYS:-/sys/class/ubi}/$AB_ACTIVE_UBI/mtd_num")" = "$AB_ACTIVE_MTD" ] ||
@@ -84,7 +86,7 @@
 	find "$work/tree" -type f -exec chmod 0600 {} \;
 	(cd "$work/tree" && find . -type f ! -name .cambium-ab-manifest -exec sha256sum {} \; > .cambium-ab-manifest &&
 		tar cf "$work/archive" .) || return 1
-	[ "$(wc -c < "$work/archive")" -le $((20 * AB_LEB)) ] ||
+	[ "$(wc -c < "$work/archive")" -le $((certificate_lebs * AB_LEB)) ] ||
 		{ ab_fail 'certificate snapshot exceeds reserved volume capacity'; return 1; }
 	hash=$(sha256sum "$work/archive"); hash=${hash%% *}
 	binding=$(ab_certificate_binding) || return 1
@@ -100,7 +102,9 @@
 
 ab_certificate_validate_snapshot() {
 	local hash expected binding
-	[ "$(ab_certificate_lebs)" = 20 ] || return 0
+	local certificate_lebs
+	certificate_lebs=$(ab_certificate_lebs) || return 1
+	[ "$certificate_lebs" -gt 0 ] || return 0
 	[ "$AB_LAYOUT" = banks ] || return 0
 	ab_certificate_private_file "$AB_CERTIFICATE_ARCHIVE" &&
 		ab_certificate_private_file "$AB_CERTIFICATE_DESCRIPTOR" ||
@@ -112,7 +116,7 @@
 	expected=$(sed -n '2p' "$AB_CERTIFICATE_DESCRIPTOR")
 	[ "$hash" = "$expected" ] || { ab_fail 'certificate snapshot checksum failed'; return 1; }
 	# Bound the archive again after the RAM copy, and reject special entries.
-	[ "$(wc -c < "$AB_CERTIFICATE_ARCHIVE")" -le $((20 * AB_LEB)) ] || return 1
+	[ "$(wc -c < "$AB_CERTIFICATE_ARCHIVE")" -le $((certificate_lebs * AB_LEB)) ] || return 1
 	tar tf "$AB_CERTIFICATE_ARCHIVE" | LC_ALL=C awk '
 		/^\// || /(^|\/)\.\.(\/|$)/ || /[^A-Za-z0-9_.\/-]/ { bad=1 }
 		END { exit bad }' || return 1
@@ -121,7 +125,9 @@
 
 ab_certificate_restore() {
 	local work rc=0
-	[ "$(ab_certificate_lebs)" = 20 ] || return 0
+	local certificate_lebs
+	certificate_lebs=$(ab_certificate_lebs) || return 1
+	[ "$certificate_lebs" -gt 0 ] || return 0
 	[ "$AB_LAYOUT" = banks ] || return 0
 	ab_certificate_validate_snapshot || return 1
 	[ "$(cat "${AB_UBI_SYS:-/sys/class/ubi}/$AB_TARGET_UBI/mtd_num")" = "$AB_TARGET_MTD" ] &&
--- a/package/cambium/cambium-ab/files/cambium-ab-guard
+++ b/package/cambium/cambium-ab/files/cambium-ab-guard
@@ -226,6 +226,13 @@
 		fi
 		[ "$AB_MARKER" != 1 ] || ab_setenv changing_bootcmd 1 || return 1
 		ab_setenv bootcmd "$bootcmd" || return 1
+		[ "$(ab_getenv bootcmd)" = "$bootcmd" ] || return 1
+		if command -v ab_installer_legacy_complete >/dev/null 2>&1; then
+			ab_installer_legacy_complete "$slot" || {
+				log "native installer completion remains pending"
+				return 1
+			}
+		fi
 		log "healthy; guarded OpenWrt boot of slot $slot rearmed"
 		return 0
 	fi
