From: Phil Taylor <phil@m0vse.uk>
Subject: [PATCH] qualcommax: export Thor bank certificates before RAM upgrade

--- a/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh
+++ b/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh
@@ -155,6 +155,12 @@
 }
 
 platform_pre_upgrade() {
+	if command -v ab_family >/dev/null && ab_family; then
+		ab_certificate_export || {
+			echo 'A/B upgrade: certificate snapshot failed; no bank was written' >&2
+			exit 1
+		}
+	fi
 	case "$(board_name)" in
 	asus,rt-ax89x)
 		asus_initial_setup
