+$(eval $(call BuildPackage,cambium-cheetah-support))
diff --git a/package/cambium/cambium-cheetah-support/files/17_cheetah_bridge_section b/package/cambium/cambium-cheetah-support/files/17_cheetah_bridge_section
new file mode 100755
index 0000000000..b06924f458
--- /dev/null
+++ b/package/cambium/cambium-cheetah-support/files/17_cheetah_bridge_section
@@ -0,0 +1,63 @@
+#!/bin/sh
+
+# First boot accepts untagged/PVID VLAN 1 for DHCP management. OpenWISP adds
+# tagged VLANs only through the device-specific template.
+[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'cambiumnetworks,xv2-21x' ] || exit 0
+
+if [ "$(uci -q get network.device_br_lan.vlan_filtering)" = '1' ] &&
+   [ "$(uci -q get network.lan.device)" = 'br-lan.1' ]; then
+	# An OpenWISP trunk template sets up the bridge but not lan6 or the
+	# agent's management interface: move both to VLAN 1, as a fresh install
+	# does. Only the exact legacy value br-lan; wg0 or any other is kept.
+	if [ "$(uci -q get network.lan6.device)" = 'br-lan' ]; then
+		uci set network.lan6.device='br-lan.1'
+		uci commit network
+	fi
+	if [ "$(uci -q get openwisp.http.management_interface)" = 'br-lan' ]; then
+		uci set openwisp.http.management_interface='br-lan.1'
+		uci commit openwisp
+	fi
+	exit 0
+fi
+
+bridge_section=device_br_lan
+if [ -z "$(uci -q get network.device_br_lan.name)" ]; then
+	bridge_section=device_lan
+fi
+if [ -z "$(uci -q get "network.$bridge_section.name")" ]; then
+	bridge_section=
+	for index in 0 1 2 3 4 5 6 7; do
+		if [ "$(uci -q get "network.@device[$index].name")" = 'br-lan' ]; then
+			bridge_section="@device[$index]"
+			break
+		fi
+	done
+fi
+
+[ -n "$bridge_section" ] || exit 1
+[ "$(uci -q get "network.$bridge_section.name")" = 'br-lan' ] || exit 1
+[ "$(uci -q get "network.$bridge_section.ports")" = 'lan' ] || exit 1
+[ "$(uci -q get network.lan.proto)" = 'dhcp' ] || exit 1
+[ "$(uci -q get network.lan.device)" = 'br-lan' ] || exit 1
+[ -z "$(uci -q get network.vlan_br_lan_101.vlan)" ] || exit 1
+
+if [ "$bridge_section" != 'device_br_lan' ]; then
+	uci rename "network.$bridge_section=device_br_lan" || exit 1
+fi
+
+uci set network.device_br_lan.vlan_filtering='1'
+uci set network.vlan_br_lan_1=bridge-vlan
+uci set network.vlan_br_lan_1.device='br-lan'
+uci set network.vlan_br_lan_1.vlan='1'
+uci -q delete network.vlan_br_lan_1.ports
+uci add_list network.vlan_br_lan_1.ports='lan:u*'
+uci set network.lan.device='br-lan.1'
+if [ "$(uci -q get network.lan6.device)" = 'br-lan' ]; then
+	uci set network.lan6.device='br-lan.1'
+fi
+uci commit network
+if [ "$(uci -q get openwisp.http.management_interface)" = 'br-lan' ]; then
+	uci set openwisp.http.management_interface='br-lan.1'
+	uci commit openwisp
+fi
+exit 0
diff --git a/package/cambium/cambium-cheetah-support/files/19_cambium_openwifi_identity b/package/cambium/cambium-cheetah-support/files/19_cambium_openwifi_identity
new file mode 100755
index 0000000000..11c1ecb10c
--- /dev/null
+++ b/package/cambium/cambium-cheetah-support/files/19_cambium_openwifi_identity
@@ -0,0 +1,11 @@
+#!/bin/sh
+[ -d "${UCENTRAL_DIR:=/etc/ucentral}" ] || exit 0
+board=${CAMBIUM_BOARD_NAME:-}
+[ -n "$board" ] || { . /lib/functions/system.sh; board=$(board_name); }
+case "$board" in
+ cambiumnetworks,xv2-21x) compatible=cambium_xv2-21x ;;
+ cambiumnetworks,xv2-22h) compatible=cambium_xv2-22h ;;
+ cambiumnetworks,xv2-23t) compatible=cambium_xv2-23t ;;
+ *) exit 0 ;;
+esac
+printf '%s\n' "$compatible" > "$UCENTRAL_DIR/compatible"
diff --git a/package/cambium/cambium-cheetah-support/files/cambium-ab-cheetah.sh b/package/cambium/cambium-cheetah-support/files/cambium-ab-cheetah.sh
new file mode 100644
index 0000000000..7fc967caf8
--- /dev/null
+++ b/package/cambium/cambium-cheetah-support/files/cambium-ab-cheetah.sh
@@ -0,0 +1,56 @@
+#!/bin/sh
+# Cambium A/B module for the Cheetah family (IPQ5018). See cambium-ab.sh.
+#
+# Cheetah has a 256 MiB NAND with two 96 MiB firmware banks: rootfs (slot 0)
+# at 0x80000, after the 0:TRAINING partition, and rootfs_1 (slot 1) at
+# 0x6080000. The boot commands keep the form validated on the XV2-21X and set
+# bootargs with the bank, since the stock U-Boot builds its own ubi.mtd.
+
+case " ${AB_FAMILIES:-} " in
+*" cheetah "*) ;;
+*) AB_FAMILIES="${AB_FAMILIES:+$AB_FAMILIES }cheetah" ;;
+esac
+
+ab_cheetah_board() {
+	AB_NAME=Cheetah
+	AB_ENV=cheetah
+	AB_IMAGE_DIR=sysupgrade-cambiumnetworks_cheetah
+	AB_VAULT=1
+	AB_BANK_SIZE=06000000
+	AB_SLOT0_OFFSET=0x80000
+	AB_SLOT1_OFFSET=0x6080000
+	AB_BANK_LEBS=724
+	AB_PROTECTED='0:TRAINING 0:NVRAM crashLog 0:ART'
+	case "$1" in
+	cambiumnetworks,xv2-21x)
+		# Installed, converted and bank-switched by sysupgrade on hardware.
+		AB_MODEL=XV2-21X; AB_SKU=00000023; AB_FIT=config@mp03.3-ocelot; AB_QUALIFIED=1
+		# Managed on the VLAN-1 bridge; both radios are validated.
+		AB_LAN='br-lan.1 br-lan'
+		AB_RADIOS=2
+		;;
+	cambiumnetworks,xv2-22h) AB_MODEL=XV2-22H; AB_SKU=00000022; AB_FIT=config@mp03.3-cheetah ;;
+	cambiumnetworks,xv2-23t) AB_MODEL=XV2-23T; AB_SKU=00000024; AB_FIT=config@mp03.3-lynx ;;
+	*) return 1 ;;
+	esac
+}
+
+# The validated XV2-21X boot of a bank, with bootargs selecting slot $1.
+ab_cheetah_boot_command() {
+	local part offset
+	case "$1" in
+	0) part=rootfs; offset=$AB_SLOT0_OFFSET ;;
+	1) part=rootfs_1; offset=$AB_SLOT1_OFFSET ;;
+	*) echo "cambium-ab: invalid slot $1" >&2; return 1 ;;
+	esac
+	printf 'nand device 0; setenv mtdids nand0=nand0; setenv mtdparts "mtdparts=nand0:%s@%s(fs)"; ubi part fs && ubi read 0x60000000 kernel && setenv bootargs "console=ttyMSM0,115200n8 ubi.mtd=%s root=/dev/ubiblock0_1 rootfstype=squashfs rootwait" && bootm 0x60000000#%s\n' \
+		"$(ab_bank_hex)" "$offset" "$part" "$AB_FIT"
+}
+
+# One-OEM/one-OpenWrt guarded boot of OpenWrt slot $1: restore the stock
+# default first, as the validated XV2-21X guard did, and fall back to it.
+ab_cheetah_guarded_command() {
+	local boot
+	boot=$(ab_cheetah_boot_command "$1") || return 1
+	echo "setenv bootcmd bootipq; setenv changing_bootcmd; saveenv; $boot; bootipq"
+}
diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-cheetah-persistent.dtsi b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-cheetah-persistent.dtsi
new file mode 100644
index 0000000000..40aa2e3144
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-cheetah-persistent.dtsi
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/*
+ * Cheetah A/B persistent trees: both 96 MiB firmware banks and the U-Boot
+ * environment are writable, and U-Boot's boot command selects the bank with
+ * ubi.mtd=rootfs or ubi.mtd=rootfs_1, so no root is appended here. 0:TRAINING,
+ * 0:NVRAM, crashLog, ART and the other NOR partitions stay read-only.
+ */
+/ {
+	chosen {
+		bootargs-append = " swiotlb=1 coherent_pool=2M";
+	};
+};
+
+&rootfs {
+	/delete-property/ read-only;
+};
+
+&rootfs_1 {
+	/delete-property/ read-only;
+};
+
+&appsblenv {
+	/delete-property/ read-only;
+};
diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-xv2-21x-persistent.dts b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-xv2-21x-persistent.dts
new file mode 100644
index 0000000000..d0af3947f5
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-xv2-21x-persistent.dts
@@ -0,0 +1,4 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+#include "ipq5018-xv2-21x.dts"
+#include "ipq5018-cheetah-persistent.dtsi"
diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-xv2-21x.dts b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-xv2-21x.dts
new file mode 100644
index 0000000000..e9f128d10b
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-xv2-21x.dts
@@ -0,0 +1,376 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/dts-v1/;
+
+#include "ipq5018.dtsi"
+#include "ipq5018-ess.dtsi"
+#include "ipq5018-qcn6122.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/reset/qcom,gcc-ipq5018.h>
+
+/ {
+	model = "Cambium Networks XV2-21X";
+	compatible = "cambiumnetworks,xv2-21x", "qcom,ipq5018";
+
+	cambium-platform {
+		compatible = "cambium-platform";
+		board-sku = <35>;
+	};
+
+	aliases {
+		label-mac-device = &dp1;
+		serial0 = &blsp1_uart1;
+		led-boot = &led_orange;
+		led-failsafe = &led_orange;
+		led-running = &led_green;
+		led-upgrade = &led_orange;
+	};
+
+	chosen {
+		bootargs-append = " swiotlb=1 coherent_pool=2M";
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x0 0x40000000>;
+	};
+
+	keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&button_pins>;
+		pinctrl-names = "default";
+
+		reset {
+			label = "reset";
+			gpios = <&tlmm 28 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+			debounce-interval = <60>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		/* Verified on v8 hardware: green GPIO30, amber GPIO23, blue GPIO24. */
+		led_green: led-green {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		led_orange: led-orange {
+			color = <LED_COLOR_ID_ORANGE>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		led_blue: led-blue {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+};
+
+&sleep_clk {
+	clock-frequency = <32000>;
+};
+
+&xo_board_clk {
+	clock-div = <4>;
+	clock-mult = <1>;
+};
+
+&blsp1_uart1 {
+	status = "okay";
+	pinctrl-0 = <&serial_0_pins>;
+	pinctrl-names = "default";
+};
+
+&prng {
+	status = "okay";
+};
+
+&qfprom {
+	status = "okay";
+};
+
+/* OEM reserves through 0x4e500000 for the second radio and calibration DB. */
+&q6_region {
+	reg = <0x0 0x4b000000 0x0 0x3500000>;
+};
+
+/* OEM enables the integrated 2.4 GHz radio and the first QCN6122 5 GHz PD. */
+&wifi {
+	status = "okay";
+	qcom,rproc = <&q6_wcss_pd1>;
+	qcom,ath11k-calibration-variant = "Cambium-XV2-21X";
+	qcom,ath11k-fw-memory-mode = <1>;
+	qcom,bdf-addr = <0x4c400000>;
+};
+
+&wifi1 {
+	status = "okay";
+	qcom,rproc = <&q6_wcss_pd2>;
+	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
+	qcom,ath11k-calibration-variant = "Cambium-XV2-21X-5G";
+	qcom,ath11k-fw-memory-mode = <1>;
+	qcom,bdf-addr = <0x4d100000>;
+	qcom,m3-dump-addr = <0x4df00000>;
+};
+
+/* OEM dp1 is 39c00000.dp1 and uses the IPQ5018 internal PHY at MDIO 7. */
+&dp1 {
+	status = "okay";
+	label = "lan";
+	nvmem-cells = <&macaddr_appsblenv_ethaddr 0>;
+	nvmem-cell-names = "mac-address";
+};
+
+&mdio0 {
+	status = "okay";
+	/* Test whether this sibling AHB gate is needed by MDIO0. */
+	clocks = <&gcc GCC_MDIO0_AHB_CLK>, <&gcc GCC_MDIO1_AHB_CLK>;
+	clock-names = "gcc_mdio_ahb_clk", "xv2-mdio1-ahb";
+	resets = <&gcc GCC_GEPHY_MDC_SW_ARES>;
+	reset-names = "mdio";
+};
+
+&ge_phy {
+	resets = <&gcc GCC_GEPHY_BCR>, <&gcc GCC_GEPHY_MISC_ARES>;
+};
+
+&qpic_bam {
+	status = "okay";
+};
+
+&qpic_nand {
+	pinctrl-0 = <&qpic_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		nand-ecc-engine = <&qpic_nand>;
+		nand-ecc-step-size = <512>;
+		nand-ecc-strength = <4>;
+		nand-bus-width = <8>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "0:TRAINING";
+				reg = <0x0 0x80000>;
+				read-only;
+			};
+
+			rootfs: partition@80000 {
+				label = "rootfs";
+				reg = <0x80000 0x6000000>;
+				read-only;
+			};
+
+			rootfs_1: partition@6080000 {
+				label = "rootfs_1";
+				reg = <0x6080000 0x6000000>;
+				read-only;
+			};
+
+			partition@c080000 {
+				label = "0:NVRAM";
+				reg = <0xc080000 0x2f80000>;
+				read-only;
+			};
+
+			partition@f000000 {
+				label = "crashLog";
+				reg = <0xf000000 0x1000000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&blsp1_spi1 {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "0:SBL1";
+				reg = <0x0 0x30000>;
+				read-only;
+			};
+
+			partition@30000 {
+				label = "0:MIBIB";
+				reg = <0x30000 0x10000>;
+				read-only;
+			};
+
+			partition@40000 {
+				label = "0:BOOTCONFIG";
+				reg = <0x40000 0x10000>;
+				read-only;
+			};
+
+			partition@50000 {
+				label = "0:BOOTCONFIG1";
+				reg = <0x50000 0x10000>;
+				read-only;
+			};
+
+			partition@60000 {
+				label = "0:QSEE";
+				reg = <0x60000 0xa0000>;
+				read-only;
+			};
+
+			partition@100000 {
+				label = "0:QSEE_1";
+				reg = <0x100000 0xa0000>;
+				read-only;
+			};
+
+			partition@1a0000 {
+				label = "0:DEVCFG";
+				reg = <0x1a0000 0x10000>;
+				read-only;
+			};
+
+			partition@1b0000 {
+				label = "mfginfo";
+				reg = <0x1b0000 0x10000>;
+				read-only;
+			};
+
+			partition@1c0000 {
+				label = "0:CDT";
+				reg = <0x1c0000 0x10000>;
+				read-only;
+			};
+
+			partition@1d0000 {
+				label = "0:CDT_1";
+				reg = <0x1d0000 0x10000>;
+				read-only;
+			};
+
+			partition@1e0000 {
+				label = "oldappsblenv";
+				reg = <0x1e0000 0x10000>;
+				read-only;
+			};
+
+			partition@1f0000 {
+				label = "0:APPSBL";
+				reg = <0x1f0000 0xa0000>;
+				read-only;
+			};
+
+			partition@290000 {
+				label = "0:APPSBL_1";
+				reg = <0x290000 0xa0000>;
+				read-only;
+			};
+
+			partition@330000 {
+				label = "0:ART";
+				reg = <0x330000 0x70000>;
+				read-only;
+			};
+
+			partition@3a0000 {
+				label = "0:DEVCFG_1";
+				reg = <0x3a0000 0x10000>;
+				read-only;
+			};
+
+			appsblenv: partition@3b0000 {
+				label = "0:APPSBLENV";
+				reg = <0x3b0000 0x10000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "u-boot,env";
+					env-size = <0x10000>;
+
+					macaddr_appsblenv_ethaddr: ethaddr {
+						#nvmem-cell-cells = <1>;
+					};
+				};
+			};
+
+			partition@3c0000 {
+				label = "config";
+				reg = <0x3c0000 0x10000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&tlmm {
+	button_pins: button-state {
+		pins = "gpio28";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	qpic_pins: qpic-state {
+		clock-pins {
+			pins = "gpio9";
+			function = "qspi_clk";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		cs-pins {
+			pins = "gpio8";
+			function = "qspi_cs";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data-pins {
+			pins = "gpio4", "gpio5", "gpio6", "gpio7";
+			function = "qspi_data";
+			drive-strength = <8>;
+			bias-disable;
+		};
+	};
+
+	serial_0_pins: uart0-state {
+		pins = "gpio20", "gpio21";
+		function = "blsp0_uart0";
+		bias-disable;
+	};
+};
+
+&switch {
+	status = "okay";
+	switch_mac_mode = <MAC_MODE_SGMII_CHANNEL0>;
+	qcom,port_phyinfo {
+		port@0 { port_id = <1>; mdiobus = <&mdio0>; phy_address = <7>; };
+	};
+};
