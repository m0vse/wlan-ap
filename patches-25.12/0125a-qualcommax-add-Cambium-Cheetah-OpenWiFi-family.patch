+--- a/drivers/net/mdio/mdio-ipq4019.c
++++ b/drivers/net/mdio/mdio-ipq4019.c
+@@ -12,6 +12,8 @@
+ #include <linux/phy.h>
+ #include <linux/platform_device.h>
+ #include <linux/clk.h>
++#include <linux/reset.h>
++#include <linux/of.h>
+ 
+ #define MDIO_MODE_REG				0x40
+ #define   MDIO_MODE_MDC_MODE			BIT(12)
+@@ -328,6 +330,7 @@
+ 	struct ipq4019_mdio_data *priv;
+ 	struct mii_bus *bus;
+ 	struct resource *res;
++	struct reset_control *mdio_reset;
+ 	int ret;
+ 
+ 	bus = devm_mdiobus_alloc_size(&pdev->dev, sizeof(*priv));
+@@ -340,9 +343,29 @@
+ 	if (IS_ERR(priv->membase))
+ 		return PTR_ERR(priv->membase);
+ 
++	if (of_machine_is_compatible("cambiumnetworks,xv2-21x")) {
++		struct clk *mdio1_ahb_clk;
++
++		mdio1_ahb_clk = devm_clk_get_enabled(&pdev->dev, "xv2-mdio1-ahb");
++		if (IS_ERR(mdio1_ahb_clk))
++			return dev_err_probe(&pdev->dev, PTR_ERR(mdio1_ahb_clk),
++					     "failed to enable XV2 MDIO1 AHB clock\n");
++	}
++
+ 	priv->mdio_clk = devm_clk_get_optional(&pdev->dev, "gcc_mdio_ahb_clk");
+ 	if (IS_ERR(priv->mdio_clk))
+ 		return PTR_ERR(priv->mdio_clk);
++
++	mdio_reset = devm_reset_control_get_optional_exclusive(&pdev->dev, "mdio");
++	if (IS_ERR(mdio_reset))
++		return dev_err_probe(&pdev->dev, PTR_ERR(mdio_reset),
++				     "failed to get MDIO reset\n");
++	if (mdio_reset) {
++		ret = reset_control_reset(mdio_reset);
++		if (ret)
++			return dev_err_probe(&pdev->dev, ret,
++					     "failed to reset MDIO\n");
++	}
+ 
+ 	ipq4019_mdio_select_mdc_rate(pdev, priv);
+ 	ret = ipq4019_mdio_set_div(priv);

