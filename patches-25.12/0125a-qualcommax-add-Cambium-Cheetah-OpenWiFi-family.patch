--- /dev/null
+++ b/package/cambium/cambium-cheetah-support/Makefile
@@ -0,0 +1,32 @@
+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=cambium-cheetah-support
+PKG_RELEASE:=6
+PKG_LICENSE:=GPL-2.0-only
+PKG_MAINTAINER:=Phil Taylor <phil@m0vse.uk>
+
+include $(INCLUDE_DIR)/package.mk
+
+define Package/cambium-cheetah-support
+  SECTION:=utils
+  CATEGORY:=Utilities
+  TITLE:=Cambium Cheetah family access point support
+  DEPENDS:=@TARGET_qualcommax_ipq50xx +uboot-envtools +cambium-ab +cambium-board-data
