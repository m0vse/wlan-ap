From ddc6fee8816edefeccc4261e297748a80a085d96 Mon Sep 17 00:00:00 2001
From: Phil Taylor <phil@m0vse.uk>
Date: Fri, 2 Oct 2026 12:00:00 +0100
Subject: [PATCH] qualcommax: preserve qualified Cheetah OpenWiFi family support

Preserve the tested .13 hardware implementation without renumbering the
shared certificate safety series. XV2-21X only is qualified.

diff --git a/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq50xx b/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq50xx
index 6366859fc3..31047434c9 100644
--- a/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq50xx
+++ b/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq50xx
@@ -8,6 +8,11 @@ touch /etc/config/ubootenv
 board=$(board_name)
 
 case "$board" in
+cambiumnetworks,xv2-21x|\
+cambiumnetworks,xv2-22h|\
+cambiumnetworks,xv2-23t)
+	ubootenv_add_mtd "0:APPSBLENV" "0x0" "0x10000" "0x10000"
+	;;
 cmcc,pz-l8|\
 elecom,wrc-x3000gs2|\
 iodata,wn-dax3000gr|\
diff --git a/package/cambium/cambium-cheetah-support/Makefile b/package/cambium/cambium-cheetah-support/Makefile
