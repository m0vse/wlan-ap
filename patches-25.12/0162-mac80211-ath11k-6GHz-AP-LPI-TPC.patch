From: Phil Taylor <phil@m0vse.uk>
Subject: [PATCH] mac80211: ath11k: retain 6 GHz LPI AP TPC after scans

Promote the previously hardware-tested Jaguar diagnostic into the regular
ath11k package. Keep the existing firmware/service/subtype/6 GHz guards,
station power mode and firmware/regulatory-derived power limits. AP TPC
uses the driver's existing LPI AP regulatory path; this does not implement
VLP/SP, override regulatory limits or replace OEM board/calibration data.

This is an adaptation of an unmerged upstream proposal, not an upstream
released fix. Cold-boot, scan/config reapply, HE160/client traffic and
2/5 GHz regression acceptance remain mandatory for the new image.

Signed-off-by: Phil Taylor <phil@m0vse.uk>
---
--- a/package/kernel/mac80211/Makefile
+++ b/package/kernel/mac80211/Makefile
@@ -12,6 +12,6 @@
 
 PKG_VERSION:=6.18.26
-PKG_RELEASE:=2
+PKG_RELEASE:=3
 PKG_LICENSE:=GPL-2.0-only
 PKG_LICENSE_FILES:=COPYING
 
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath11k/960-wifi-ath11k-fix-6GHz-AP-LPI-TPC.patch
@@ -0,0 +1,75 @@
+From: Sebastian Gottschall <s.gottschall@dd-wrt.com>
+Subject: [PATCH] wifi: ath11k: fix txpower in AP mode for 6 GHz
+
+Diagnostic adaptation of the unmerged upstream v3 proposal. QCN9074 can
+report zero power after scanning in 6 GHz AP mode. Include APs in the
+existing EXT_TPC_REG_SUPPORT path and use the actual starting channel
+context, preserving firmware/regulatory-derived power limits.
+
+AP TPC uses LPI, consistent with the existing AP regulatory-rule path.
+This is not VLP or standard-power AP support. Hardware acceptance requires
+an explicitly configured LPI AP; do not silently convert other policies.
+
+Adapted to backports 6.18.7 and incorporates July review feedback on
+continuation alignment and the existing bss_conf pointer.
+
+Fixes: 74ef2d05ede6 ("wifi: ath11k: use WMI_VDEV_SET_TPC_POWER_CMDID when EXT_TPC_REG_SUPPORT for 6 GHz")
+Link: https://lore.kernel.org/ath11k/20260514202750.3040404-1-s.gottschall@dd-wrt.com/
+Signed-off-by: Sebastian Gottschall <s.gottschall@dd-wrt.com>
+Signed-off-by: Phil Taylor <phil@m0vse.uk>
+---
+--- a/drivers/net/wireless/ath/ath11k/mac.c
++++ b/drivers/net/wireless/ath/ath11k/mac.c
+@@ -3506,13 +3506,13 @@
+ 	return 0;
+ }
+ 
+-static bool ath11k_mac_supports_station_tpc(struct ath11k *ar,
+-					    struct ath11k_vif *arvif,
+-					    const struct cfg80211_chan_def *chandef)
++static bool ath11k_mac_supports_tpc(struct ath11k *ar, struct ath11k_vif *arvif,
++				    const struct cfg80211_chan_def *chandef)
+ {
+ 	return ath11k_wmi_supports_6ghz_cc_ext(ar) &&
+ 		test_bit(WMI_TLV_SERVICE_EXT_TPC_REG_SUPPORT, ar->ab->wmi_ab.svc_map) &&
+-		arvif->vdev_type == WMI_VDEV_TYPE_STA &&
++		(arvif->vdev_type == WMI_VDEV_TYPE_STA ||
++		 arvif->vdev_type == WMI_VDEV_TYPE_AP) &&
+ 		arvif->vdev_subtype == WMI_VDEV_SUBTYPE_NONE &&
+ 		chandef->chan &&
+ 		chandef->chan->band == NL80211_BAND_6GHZ;
+@@ -7333,8 +7333,8 @@
+ 	/* TODO: For now we only set TPC power here. However when
+ 	 * channel changes, say CSA, it should be updated again.
+ 	 */
+-	if (ath11k_mac_supports_station_tpc(ar, arvif, chandef)) {
+-		ath11k_mac_fill_reg_tpc_info(ar, arvif->vif, &arvif->chanctx);
++	if (ath11k_mac_supports_tpc(ar, arvif, chandef)) {
++		ath11k_mac_fill_reg_tpc_info(ar, arvif->vif, ctx);
+ 		ath11k_wmi_send_vdev_set_tpc_power(ar, arvif->vdev_id,
+ 						   &arvif->reg_tpc_info);
+ 	}
+@@ -7841,6 +7841,7 @@
+ 		psd_power, tx_power;
+ 	s8 eirp_power = 0;
+ 	u16 start_freq, center_freq;
++	u8 reg_6ghz_power_mode;
+ 
+ 	chan = ctx->def.chan;
+ 	start_freq = ath11k_mac_get_6ghz_start_frequency(&ctx->def);
+@@ -7997,8 +7998,14 @@
+ 	reg_tpc_info->num_pwr_levels = num_pwr_levels;
+ 	reg_tpc_info->is_psd_power = is_psd_power;
+ 	reg_tpc_info->eirp_power = eirp_power;
++	if (arvif->vdev_type == WMI_VDEV_TYPE_STA)
++		reg_6ghz_power_mode = bss_conf->power_type;
++	else
++		/* For now, LPI is the only supported AP power mode */
++		reg_6ghz_power_mode = IEEE80211_REG_LPI_AP;
++
+ 	reg_tpc_info->ap_power_type =
+-		ath11k_reg_ap_pwr_convert(vif->bss_conf.power_type);
++		ath11k_reg_ap_pwr_convert(reg_6ghz_power_mode);
+ }
+ 
+ static void ath11k_mac_parse_tx_pwr_env(struct ath11k *ar,
