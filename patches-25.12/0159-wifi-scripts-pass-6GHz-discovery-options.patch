From: Phil Taylor <phil@m0vse.uk>
Subject: [PATCH] wifi-scripts: pass explicit 6GHz discovery options to hostapd

Declare and forward existing hostapd FILS/unsolicited probe options on 6GHz
BSSes, and the explicit ACS PSC restriction on automatic 6GHz radios.
Do not add defaults or change channel/security/regulatory policy. Other bands
and the independent QCA vendor scripts are unchanged.

diff --git a/package/network/config/wifi-scripts/Makefile b/package/network/config/wifi-scripts/Makefile
index b4b1a72b17..7499d0eb46 100644
--- a/package/network/config/wifi-scripts/Makefile
+++ b/package/network/config/wifi-scripts/Makefile
@@ -9,7 +9,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=wifi-scripts
 PKG_VERSION:=1.0
-PKG_RELEASE:=2
+PKG_RELEASE:=3
 PKG_LICENSE:=GPL-2.0
 
 PKG_MAINTAINER:=Felix Fietkau <nbd@nbd.name>
diff --git a/package/network/config/wifi-scripts/files/lib/netifd/hostapd.sh b/package/network/config/wifi-scripts/files/lib/netifd/hostapd.sh
index 2536a31539..101f5b50f9 100644
--- a/package/network/config/wifi-scripts/files/lib/netifd/hostapd.sh
+++ b/package/network/config/wifi-scripts/files/lib/netifd/hostapd.sh
@@ -284,6 +284,7 @@ hostapd_common_add_bss_config() {
 	config_add_boolean wds uapsd hidden utf8_ssid ppsk
 
 	config_add_int maxassoc max_inactivity
+	config_add_int fils_discovery_min_interval fils_discovery_max_interval unsol_bcast_probe_resp_interval
 	config_add_boolean disassoc_low_ack isolate short_preamble skip_inactivity_poll
 
 	config_add_int \
@@ -548,6 +549,16 @@ append_acct_server() {
 	[ -n "$acct_secret" ] && append bss_conf "acct_server_shared_secret=$acct_secret" "$N"
 }
 
+hostapd_set_6ghz_discovery() {
+	local option value
+	[ "$band" = "6g" ] || return 0
+	for option in fils_discovery_min_interval fils_discovery_max_interval unsol_bcast_probe_resp_interval; do
+		json_get_var value "$option"
+		[ -n "$value" ] && append bss_conf "$option=$value" "$N"
+	done
+	return 0
+}
+
 hostapd_set_bss_options() {
 	local var="$1"
 	local phy="$2"
@@ -557,6 +568,7 @@ hostapd_set_bss_options() {
 
 	local bss_conf bss_md5sum ft_key rxkhs
 	local wep_rekey wpa_group_rekey wpa_pair_rekey wpa_master_rekey wpa_key_mgmt
+	hostapd_set_6ghz_discovery
 
 	json_get_vars \
 		wep_rekey wpa_group_rekey wpa_pair_rekey wpa_master_rekey wpa_strict_rekey \
diff --git a/package/network/config/wifi-scripts/files/lib/netifd/wireless/mac80211.sh b/package/network/config/wifi-scripts/files/lib/netifd/wireless/mac80211.sh
index 2628fe52ab..4d9cda1cdb 100755
--- a/package/network/config/wifi-scripts/files/lib/netifd/wireless/mac80211.sh
+++ b/package/network/config/wifi-scripts/files/lib/netifd/wireless/mac80211.sh
@@ -35,6 +35,7 @@ drv_mac80211_init_device_config() {
 	config_add_int rxantenna txantenna txpower min_tx_power
 	config_add_int num_global_macaddr multiple_bssid
 	config_add_boolean noscan ht_coex acs_exclude_dfs background_radar
+	config_add_boolean acs_exclude_6ghz_non_psc
 	config_add_array ht_capab
 	config_add_array channels
 	config_add_array scan_list
@@ -143,6 +144,11 @@ mac80211_hostapd_setup_base() {
 	[ "$auto_channel" -gt 0 ] && json_get_vars acs_exclude_dfs
 	[ -n "$acs_exclude_dfs" ] && [ "$acs_exclude_dfs" -gt 0 ] &&
 		append base_cfg "acs_exclude_dfs=1" "$N"
+	if [ "$auto_channel" -gt 0 ] && [ "$band" = "6g" ]; then
+		json_get_vars acs_exclude_6ghz_non_psc
+		[ -n "$acs_exclude_6ghz_non_psc" ] &&
+			append base_cfg "acs_exclude_6ghz_non_psc=$acs_exclude_6ghz_non_psc" "$N"
+	fi
 
 	json_get_vars noscan ht_coex min_tx_power:0 tx_burst
 	json_get_values ht_capab_list ht_capab

