-				 conf->channel,
-				 conf->enable_edmg,
-				 conf->edmg_channel,
-				 conf->ieee80211n,
-				 conf->ieee80211ac,
-				 conf->ieee80211ax,
-				 conf->ieee80211be,
-				 conf->secondary_channel,
-				 hostapd_get_oper_chwidth(conf),
-				 hostapd_get_oper_centr_freq_seg0_idx(conf),
-				 hostapd_get_oper_centr_freq_seg1_idx(conf));
-
-		ieee802_11_set_beacon(hapd);
-	}
+
+		ret = hostapd_set_freq(hapd, conf->hw_mode, iface->freq,
+				       conf->channel,
+				       conf->enable_edmg,
+				       conf->edmg_channel,
+				       conf->ieee80211n,
+				       conf->ieee80211ac,
+				       conf->ieee80211ax,
+				       conf->ieee80211be,
+				       conf->secondary_channel,
+				       hostapd_get_oper_chwidth(conf),
+				       hostapd_get_oper_centr_freq_seg0_idx(conf),
+				       hostapd_get_oper_centr_freq_seg1_idx(conf));
+
+		wpa_printf(MSG_INFO, "set_freq called for bssid " MACSTR " ret %d ifname %s\n",
+			   MAC2STR(hapd->own_addr), ret, hapd->conf->iface);
+		if (ret)
+			goto failed;
+	}
+
+	/* All frequency requests must succeed before advertising the candidate. */
+	for (i = 0; i < iface->num_bss; i++) {
+		struct hostapd_data *hapd = iface->bss[i];
+
+		hapd->conf->start_disabled = 0;
+		ret = ieee802_11_set_beacon(hapd);
+		wpa_printf(MSG_DEBUG, "set beacon called for bssid " MACSTR " ret %d \n",
+			   MAC2STR(hapd->own_addr), ret);
+		if (ret)
+			goto failed;
+	}
+
 	hostapd_owe_update_trans(iface);
 
 	return ucv_boolean_new(true);
+
+failed:
+	/* A partially accepted request is not a known operating state. */
+	wpa_printf(MSG_ERROR, "ucode: channel setup failed; disabling affected interface");
+	uc_hostapd_restore_channel(iface, &previous, previous_freq);
+	hostapd_disable_iface(iface);
+	hostapd_set_state(iface, HAPD_IFACE_DISABLED);
+	return ucv_boolean_new(false);
+
+invalid:
+	wpa_printf(MSG_ERROR, "ucode: inconsistent frequency/channel tuple");
+	uc_hostapd_restore_channel(iface, &previous, previous_freq);
+	return ucv_boolean_new(false);
 }
 
